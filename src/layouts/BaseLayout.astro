---
import "@fontsource-variable/inter";
import "@fontsource-variable/atkinson-hyperlegible-next";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Product designer",
  noindex = false,
} = Astro.props;
const siteName = "Aaron Luellen";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;

// Link preview card (LinkedIn, texts, Slack). Previews need absolute URLs, which need the
// final domain: set `site` in astro.config.mjs. Until then the tags use site relative paths.
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const shareImage = absolute("/og-image.png");
const pageUrl = absolute(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply the saved theme before first paint, so the wrong theme never flashes.
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AL logo with the words Aaron Luellen, Product designer." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
  </head>
  <body id="top">
    <slot />
  </body>
</html>
