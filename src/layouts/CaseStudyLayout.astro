---
import PageLayout from "./PageLayout.astro";
import Photo from "../components/site/Photo.astro";
import ActionLink from "../components/mdx/ActionLink.astro";
import AthenaAlerts from "../components/site/AthenaAlerts.astro";
import type { PhotoKey } from "../data/photos";
import type { CaseStudy } from "../lib/case-studies";

interface Props {
  study: CaseStudy;
  prev?: CaseStudy;
  next?: CaseStudy;
  /** The study's ## headings, for the section index. */
  sections?: { slug: string; text: string }[];
  /** Every ## and ### heading, in order, for the compact variant's indented links. */
  headings?: { depth: number; slug: string; text: string }[];
}

const { study, prev, next, sections = [], headings = [] } = Astro.props;
const { title, summary, headline, role, team, timeline, client, program, tools, cover, status, heroMedia, heroTile, heroSummary, tags, prototype, card, order, indexChildren } =
  study.data;
// The same number the study has on the home page cards.
const number = String(order).padStart(2, "0");

// Section index (Tee Hodgson's strip and Angelina Cao's numbered index): Overview, then one line
// per ## section, named by the study's `index` list or, failing that, by the heading itself.
// The compact variant (AthenaScribe): its own masthead, intro, and a quiet side rail.
const compact = Boolean(heroTile);

// One optional indented link per section: the first ### heading after each ## heading.
const childOf: Record<string, { id: string; label: string }> = {};
{
  let at = -1;
  for (const h of headings) {
    if (h.depth === 2) at++;
    else if (h.depth === 3 && at >= 0 && sections[at] && indexChildren?.[at] && !childOf[sections[at].slug]) {
      childOf[sections[at].slug] = { id: h.slug, label: indexChildren[at] };
    }
  }
}

const indexItems = [
  { id: "overview", label: "Overview", child: undefined as { id: string; label: string } | undefined },
  ...sections.map((s, i) => ({ id: s.slug, label: study.data.index?.[i] ?? s.text, child: childOf[s.slug] })),
].map((item, i) => ({ ...item, number: String(i + 1).padStart(2, "0") }));
---

<PageLayout title={title} description={summary} crumb={compact ? title : undefined}>
  <article class:list={{ "cs-article": compact }}>
    {
      compact && (
        <aside class="cs-rail">
          <div class="cs-rail__sticky">
            <nav aria-label="On this page">
              <ul class="cs-nav">
                {indexItems.map((item) => (
                  <li>
                    <a href={`#${item.id}`} data-case-link={item.id}>{item.label}</a>
                    {item.child && (
                      <ul>
                        <li><a href={`#${item.child.id}`} data-case-link={item.child.id}>{item.child.label}</a></li>
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </aside>
      )
    }
    {
      compact && (
        <header class="cs-hero" id="overview">
          <div class="cs-hero__visual">
            <div class="hero__tile">
              <AthenaAlerts />
            </div>
          </div>
          <div class="cs-intro">
            <h1>{headline ?? title}</h1>
            <dl class="cs-meta">
              <div>
                <dt>Role</dt>
                <dd>{role}</dd>
              </div>
              <div>
                <dt>Timeline</dt>
                <dd>{timeline}</dd>
              </div>
              {
                program && (
                  <div>
                    <dt>Program</dt>
                    <dd>{program}</dd>
                  </div>
                )
              }
            </dl>
          </div>
        </header>
      )
    }
    {!compact && (
    <header class="container hero" id="overview">
      {/* The coded cover (the home tile's document alerts without the phone), at case study width, before the title. */}
      {
        heroTile === "athenascribe" && (
          <div class="hero__tile">
            <AthenaAlerts />
          </div>
        )
      }
      <div class:list={["hero__top", { "hero__top--media": heroMedia }]}>
        <div class="hero__intro">
          <!-- Index row, like the home page cards: number and name in mono over a thin rule. -->
          <p class="hero__index">
            <span class="hero__number">{number} /</span>
            <span translate="no">{title}</span>
            {status === "draft" && <span class="hero__draft">Draft</span>}
          </p>
          <h1>{headline ?? title}</h1>
          {heroSummary && <p class="hero__summary">{summary}</p>}
          {
            tags.length > 0 && (
              <ul class="hero__tags" aria-label="Tags">
                {tags.map((tag) => <li>{tag}</li>)}
              </ul>
            )
          }
          {
            prototype && (
              <ActionLink
                label="View live prototype"
                href={prototype === "TODO" ? undefined : prototype}
                variant="primary"
              />
            )
          }
        </div>
        {
          heroMedia && (
            <figure class="hero__media">
              <a class="hero__video" href={heroMedia.href} target="_blank" rel="noopener">
                <Photo
                  name={heroMedia.photo as PhotoKey}
                  widths={[480, 720, 1080]}
                  sizes="(min-width: 56rem) 34rem, 92vw"
                  ratio="16 / 9"
                  cover={16 / 9}
                />
                <span class="hero__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                </span>
                <span class="visually-hidden">{heroMedia.label} (opens in a new tab)</span>
              </a>
              <figcaption class="hero__caption">
                {heroMedia.caption}{" "}
                <a href={heroMedia.href} target="_blank" rel="noopener">
                  {heroMedia.linkText}<span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </figcaption>
            </figure>
          )
        }
      </div>

      <dl class="hero__facts">
        {
          card?.detail && (
            <div class="hero__glance">
              <dt class="label">At a glance</dt>
              <dd>{card.detail}</dd>
            </div>
          )
        }
        <div>
          <dt class="label">Role</dt>
          <dd>{role}</dd>
        </div>
        <div>
          <dt class="label">Timeline</dt>
          <dd>{timeline}</dd>
        </div>
        {
          team.length > 0 && (
            <div>
              <dt class="label">Team</dt>
              <dd>
                <ul class="hero__list">
                  {team.map((person) => (
                    <li>
                      {person.name}, <span class="hero__muted">{person.role}</span>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
        {
          client && (
            <div>
              <dt class="label">Client</dt>
              <dd>{client}</dd>
            </div>
          )
        }
        {
          program && (
            <div>
              <dt class="label">Program</dt>
              <dd>{program}</dd>
            </div>
          )
        }
        {
          tools.length > 0 && (
            <div>
              <dt class="label">Tools</dt>
              <dd>{tools.join(", ")}</dd>
            </div>
          )
        }
      </dl>

      {cover && <img class="hero__cover" src={cover.src} alt={cover.alt} />}
    </header>
    )}

    <!-- Phones and tablets: a thin bar under the header names the current section and opens the list. -->
    {
      indexItems.length > 2 && !compact && (
        <details class="case-bar" data-case-bar>
          <summary>
            <span class="case-bar__current" data-case-current>{indexItems[0].number} / {indexItems[0].label}</span>
            <span class="case-bar__hint">Sections</span>
          </summary>
          <ol class="case-bar__list">
            {indexItems.map((item) => (
              <li><a href={`#${item.id}`} data-case-link={item.id}><span>{item.number}</span><span>{item.label}</span></a></li>
            ))}
          </ol>
        </details>
      )
    }

    <div class:list={[compact ? "cs-shell" : "container", { "case-grid": indexItems.length > 2 && !compact, "container--wide": heroTile && !compact }]}>
      {
        compact ? null : (
        indexItems.length > 2 && (
          <nav class="case-index" aria-label="Sections">
            <ol>
              {indexItems.map((item) => (
                <li><a href={`#${item.id}`} data-case-link={item.id}><span>{item.number}</span><span>{item.label}</span></a></li>
              ))}
            </ol>
          </nav>
        )
        )
      }

      <div class:list={["flow", "body", { "cs-body": compact }]}>
        {
          compact && (
            <details class="cs-toc" data-cs-toc>
              <summary>On this page</summary>
              <ul class="cs-nav">
                {indexItems.map((item) => (
                  <li>
                    <a href={`#${item.id}`} data-case-link={item.id}>{item.label}</a>
                    {item.child && (
                      <ul>
                        <li><a href={`#${item.child.id}`} data-case-link={item.child.id}>{item.child.label}</a></li>
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </details>
          )
        }
        <slot />
      </div>
      <!-- End of the case study: inside the grid, so the side index stays in view down to here. -->
      <div class="case-end">
    {
      (prev || next) && (
        <nav class="pager" aria-label="End of case study">
          {prev && (
            <a class="pager__link" href={`/work/${prev.id}/`} rel="prev">
              <span class="label">Previous</span>
              <span class="pager__title">{prev.data.title}</span>
            </a>
          )}
          {next ? (
            <a class="pager__link pager__link--next" href={`/work/${next.id}/`} rel="next">
              <span class="label">Next</span>
              <span class="pager__title">{next.data.title}</span>
            </a>
          ) : (
            /* The last case study: Back to top takes the empty Next spot. */
            <a class="pager__link pager__link--next pager__top" href="#top">
              <span class="label">Back to top <span aria-hidden="true">↑</span></span>
            </a>
          )}
        </nav>
      )
    }
    {
      /* Back to top (Micah Hoang's "Scroll to top"): always on the right, so it is in the same place
         on every case study. Under Next when there is one. */
      next && (
        <div class="pager__toprow">
          <a class="pager__toplink" href="#top">Back to top <span aria-hidden="true">↑</span></a>
        </div>
      )
    }
      </div>
    </div>
  </article>

</PageLayout>

<style>
  /* Case study pages keep the earlier centered width while the rest of the site runs near full
     width. Their own redesign (Micah Hoang's project page frame) comes next. */
  .container {
    max-width: var(--measure-case);
  }

  .container--wide {
    max-width: var(--measure-case-wide);
  }

  .hero {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-9) var(--space-7);
  }

  /* The tile fills its box (it is absolute inside), so the box sets the 16:9 shape. */
  .hero__tile {
    position: relative;
    aspect-ratio: var(--ratio-tile-wide);
    border-radius: var(--radius-media);
    overflow: hidden;
  }

  .hero__top {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .hero__top--media {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .hero__intro {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .hero__media {
    display: grid;
    gap: var(--space-3);
  }

  .hero__video {
    position: relative;
    display: block;
    overflow: hidden;
    border: var(--rule-thin) solid var(--color-rule);
    border-radius: var(--radius-media);
  }

  .hero__video :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero__play {
    position: absolute;
    inset: 50% auto auto 50%;
    display: grid;
    place-items: center;
    inline-size: var(--size-play);
    block-size: var(--size-play);
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--color-overlay);
    color: var(--color-always-dark-ink);
    transition: background var(--duration-hover) var(--ease-standard);
  }

  .hero__video:hover .hero__play {
    background: var(--color-brand);
  }

  .hero__caption {
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }

  .hero__index {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    padding-block-start: var(--space-3);
    border-block-start: var(--rule-thin) solid var(--color-rule-strong);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-heading);
  }

  .hero__number {
    color: var(--color-ink-muted);
  }

  .hero__draft {
    margin-inline-start: auto;
    color: var(--color-ink-muted);
  }

  /* The headline is the page's h1; the study's name sits in the index row above it. */
  .hero__intro h1 {
    max-width: 22ch;
    font-size: var(--step-5);
  }

  /* Small rounded outline tags, like the ones under the home tiles. */
  .hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__tags li {
    padding: var(--space-1) var(--space-3);
    border: var(--rule-thin) solid var(--color-rule-strong);
    border-radius: var(--radius-tag);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: var(--leading-snug);
    color: var(--color-ink-muted);
  }

  .hero__summary {
    max-width: var(--measure-reading);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--color-ink-muted);
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-5) var(--space-6);
    margin-block-start: var(--space-5);
    padding-block-start: var(--space-5);
    border-top: var(--rule-thin) solid var(--color-rule);
  }

  /* At a glance: the study's key numbers, full width, first. */
  .hero__glance {
    grid-column: 1 / -1;
  }

  .hero__glance dd {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--color-heading);
  }

  .hero__facts > div {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    min-width: 0;
  }

  .hero__facts dd {
    margin: 0;
  }

  .hero__list {
    padding: 0;
    list-style: none;
  }

  .hero__muted {
    color: var(--color-ink-muted);
  }

  .hero__cover {
    width: 100%;
    margin-block-start: var(--space-5);
    border: var(--rule-thin) solid var(--color-rule);
    border-radius: var(--radius-media);
  }

  .body {
    padding-block-start: var(--space-4);
  }

  /* Text keeps a reading measure. Blocks marked .is-wide (card grids, comparisons, panels)
     use the full container width. */
  .body > :global(*),
  .body :global(.section__inner > *) {
    max-width: var(--measure-reading);
  }

  .body > :global(.is-wide),
  .body :global(.section__inner > .is-wide) {
    max-width: none;
  }

  /* Tables written in Markdown: comparisons and targets. Scroll sideways inside their own box
     on narrow screens instead of widening the page. */
  .body :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    /* Scroll shadows: a soft edge appears on the side that has more table to scroll to. */
    background:
      linear-gradient(to right, var(--color-paper) 30%, transparent) left / 2rem 100% no-repeat local,
      linear-gradient(to left, var(--color-paper) 30%, transparent) right / 2rem 100% no-repeat local,
      radial-gradient(farthest-side at 0 50%, var(--color-rule-strong), transparent) left / 0.75rem 100% no-repeat scroll,
      radial-gradient(farthest-side at 100% 50%, var(--color-rule-strong), transparent) right / 0.75rem 100% no-repeat scroll;
    border-collapse: collapse;
    font-size: var(--step--1);
    line-height: var(--leading-snug);
  }

  .body :global(th),
  .body :global(td) {
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
    border-bottom: var(--rule-thin) solid var(--color-rule);
    text-align: start;
    vertical-align: top;
  }

  .body :global(thead th) {
    font-weight: var(--weight-semibold);
    border-bottom-color: var(--color-rule-strong);
  }

  /* Headings in the running text only. Headings inside cards and comparisons set their own space. */
  .body > :global(h3),
  .body :global(.section__inner > h3) {
    margin-block-start: var(--space-7);
  }

  /* A small label written just above a heading belongs to it: the space goes above the label. */
  .body > :global(p.label:has(+ h2)) {
    margin-block-start: var(--space-8);
  }

  .body > :global(p.label + h2),
  .body :global(.section__inner > p.label + h2) {
    margin-block-start: var(--space-2);
  }

  /* Each part of the story starts well clear of the one before. */
  .body > :global(.section) {
    margin-block-start: var(--space-8);
  }

  /* The wide case study lets each part use the whole body column; its text still keeps the reading
     measure (the rule above), and .is-full blocks use the full width. */
  .container--wide .body :global(.section__inner) {
    max-width: none;
  }

  /* The wide case study breathes more between parts: 56px on phones up to 96px on desktop. */
  .container--wide .body > :global(.section) {
    margin-block-start: var(--section-gap);
  }

  /* A small note under a block: method details, baselines. */
  .body :global(.note) {
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: var(--color-ink-muted);
  }

  .pager {
    display: grid;
    gap: var(--space-5);
    margin-block-start: var(--space-9);
  }

  .case-end {
    padding-block-end: var(--space-8);
  }

  @media (min-width: 48rem) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }

    .pager__link--next {
      grid-column: 2;
      text-align: end;
    }
  }

  .pager__link {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-top: var(--rule-thin) solid var(--color-rule-strong);
    color: inherit;
    text-decoration: none;
  }

  /* Back to top in the Next spot: the same rule and spacing as the other pager links. */
  .pager__top {
    justify-items: end;
    text-align: end;
  }

  .pager__top .label {
    display: inline-flex;
    gap: 0.6ch;
    color: var(--color-heading);
  }

  .pager__top:hover .label {
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .pager__toprow {
    display: flex;
    justify-content: flex-end;
  }

  .pager__toplink {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-height);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    gap: 0.6ch;
    color: var(--color-heading);
    text-decoration: none;
  }

  .pager__toplink:hover {
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .pager__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
  }

  .pager__link:hover .pager__title {
    color: var(--color-accent-hover);
  }

  /* Section index. Wide screens: a numbered list beside the body that stays in view and marks the
     section on screen. Narrower: a thin bar under the header (details) with the current section. */
  .case-grid {
    display: grid;
    gap: var(--space-7);
  }

  .case-grid > * {
    min-width: 0;
  }

  .case-index {
    display: none;
  }

  .case-index ol,
  .case-bar__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .case-index a,
  .case-bar__list a {
    display: grid;
    grid-template-columns: 2.5ch 1fr;
    gap: var(--space-3);
    align-items: center;
    min-block-size: var(--control-height);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    text-decoration: none;
    border-block-end: var(--rule-thin) solid var(--color-rule);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .case-index a:hover,
  .case-bar__list a:hover {
    color: var(--color-ink);
  }

  /* Current section: ink color and a short bar on the left. */
  .case-index a[aria-current],
  .case-bar__list a[aria-current] {
    color: var(--color-heading);
    box-shadow: inset var(--rule-thick) 0 0 var(--color-heading);
    padding-inline-start: var(--space-3);
  }

  .case-index li:first-child a,
  .case-bar__list li:first-child a {
    border-block-start: var(--rule-thin) solid var(--color-rule-strong);
  }

  @media (min-width: 72rem) {
    .case-grid {
      grid-template-columns: var(--size-case-index) minmax(0, 1fr);
      column-gap: var(--space-8);
      align-items: start;
    }

    /* The end block (Previous, Next, Back to top) sits in the body column. */
    .case-end {
      grid-column: 2;
    }

    .case-index {
      display: block;
      position: sticky;
      top: calc(var(--header-height) + var(--space-6));
      max-block-size: calc(100dvh - var(--header-height) - var(--space-6) * 2);
      overflow-y: auto;
    }

    /* Everything in the body ends on the same edge: wide blocks stop at the reading measure too,
       which is about the width of this column. */
    .case-grid .body > :global(.is-wide),
    .case-grid .body :global(.section__inner > .is-wide) {
      max-width: var(--measure-reading);
    }

    /* Diagrams, comparisons, and interface details use the whole body column. */
    .case-grid .body > :global(.is-full),
    .case-grid .body :global(.section__inner > .is-full) {
      max-width: none;
    }

    .case-bar {
      display: none;
    }
  }

  .case-bar {
    position: sticky;
    top: var(--header-height);
    z-index: 15;
    background: var(--color-paper);
    border-block-end: var(--rule-thin) solid var(--color-rule);
    padding-inline: var(--gutter);
    margin-block-end: var(--space-6);
  }

  .case-bar summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    min-block-size: var(--control-height);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-heading);
    cursor: pointer;
    list-style: none;
  }

  .case-bar summary::-webkit-details-marker {
    display: none;
  }

  .case-bar__hint {
    color: var(--color-ink-muted);
  }

  .case-bar__hint::after {
    content: " +";
  }

  .case-bar[open] .case-bar__hint::after {
    content: " ×";
  }

  /* The open list lays over the page instead of pushing it down. */
  .case-bar__list {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    max-block-size: 70dvh;
    overflow-y: auto;
    padding: 0 var(--gutter) var(--space-3);
    background: var(--color-paper);
    border-block-end: var(--rule-thin) solid var(--color-rule-strong);
  }

  /* Where the header stops sticking (very narrow or very large text), the bar sits at the top. */
  @media (max-width: 24rem) {
    .case-bar {
      top: 0;
    }
  }

  /* Jump links land below the header and the bar. */
  @media (max-width: 71.99rem) {
    :global(html:has(.case-bar)) {
      scroll-padding-top: calc(var(--header-height) + var(--control-height) + var(--space-4));
    }
  }

  /* ---- The compact case study (AthenaScribe) ------------------------------------------------ */
  .cs-hero,
  .cs-shell {
    /* The widest content: 1040px, but never closer than 48px to the side rail beside it. */
    --cs-wide: min(var(--measure-case-hero), 100%);
    padding-inline: var(--gutter);
  }

  @media (min-width: 80rem) {
    .cs-hero,
    .cs-shell {
      --cs-wide: min(var(--measure-case-hero), 100% - 24rem);
    }
  }

  .cs-hero {
    padding-block-start: var(--space-5);
  }

  .cs-hero__visual {
    max-inline-size: var(--cs-wide);
    margin-inline: auto;
  }

  .cs-intro {
    max-inline-size: var(--measure-case-reading);
    margin: var(--space-7) auto 0;
  }

  .cs-intro h1 {
    font-family: var(--font-display);
    font-size: var(--size-case-title);
    font-weight: var(--weight-medium);
    line-height: var(--leading-case-title);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
    color: var(--color-heading);
  }

  .cs-meta {
    display: grid;
    gap: var(--space-5) var(--space-6);
    margin: var(--space-6) 0 0;
    padding-block-end: var(--space-8);
    border-block-end: var(--rule-thin) solid var(--color-rule);
  }

  @media (min-width: 40rem) {
    .cs-meta {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .cs-meta dt {
    font-family: var(--font-text);
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }

  .cs-meta dd {
    margin: var(--space-2) 0 0;
    font-size: var(--step-0);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    color: var(--color-ink);
  }

  .cs-article {
    position: relative;
  }

  .cs-body {
    max-inline-size: var(--cs-wide);
    margin-inline: auto;
    padding-block-start: 0;
  }

  /* Ordinary text sits in the centered reading column; wide evidence uses the full width. */
  .cs-body :global(.section__inner) {
    max-width: none;
  }

  .cs-body :global(.section__inner > *) {
    max-width: var(--measure-case-reading);
    margin-inline: auto;
  }

  /* Evidence sits on the same two edges as the text. Only the hero above the title is wider. */
  .cs-body :global(.section__inner > :is(.is-wide, .is-full)) {
    max-width: var(--measure-case-reading);
    margin-inline: auto;
  }

  /* Video labels read like the other quiet labels: sentence case, so they stay on one line. */
  .cs-body :global(.demo__label) {
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    letter-spacing: normal;
    text-transform: none;
    color: var(--color-ink);
  }

  /* One rhythm for the whole page, no rules between sections: 24 between lines of text, 32 around a
     block of evidence, 64 before a subheading, 96 between sections. */
  .cs-body > :global(.section) {
    margin-block-start: var(--space-9);
    padding-block-start: 0;
    border-block-start: 0;
  }

  /* The first section is the overview: 48px under the hairline that closes the details. */
  .cs-body > :global(.section:first-of-type) {
    margin-block-start: var(--space-7);
  }

  .cs-body :global(.section__inner > * + *) {
    margin-block-start: var(--space-5);
  }

  .cs-body :global(.section__inner > :is(.is-wide, .is-full)),
  .cs-body :global(.section__inner > :is(.is-wide, .is-full) + *) {
    margin-block-start: var(--space-6);
  }

  .cs-body :global(.section__inner > :is(h2, h3)) {
    margin-block-start: var(--space-8);
  }

  .cs-body :global(.section__inner > :is(h2, h3):first-child) {
    margin-block-start: 0;
  }

  .cs-body :global(.section__inner > :is(h2, h3) + *) {
    margin-block-start: var(--space-4);
  }

  /* The label above a section reads like the side links: sentence case, quiet. */
  .cs-body :global(.section__inner > p.label) {
    font-family: var(--font-text);
    font-size: var(--step-0);
    font-weight: var(--weight-regular);
    letter-spacing: normal;
    text-transform: none;
  }

  .cs-body :global(.section__inner > p:not([class])) {
    color: var(--color-ink-muted);
  }

  .cs-body :global(.collab) {
    margin-block-start: var(--space-7);
  }

  .cs-shell .case-end {
    max-inline-size: var(--cs-wide);
    margin-inline: auto;
  }

  /* Side navigation: quiet text, no numbers, rules, or boxes. A 4px square marks the section being
     read; its space is always reserved, so the labels never move. */
  .cs-rail {
    display: none;
  }

  .cs-nav,
  .cs-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cs-nav {
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-weight: var(--weight-regular);
    line-height: 1.25rem;
  }

  .cs-nav > li + li {
    margin-block-start: var(--space-3);
  }

  .cs-nav ul {
    margin-inline-start: var(--space-4);
  }

  .cs-nav a {
    position: relative;
    display: block;
    padding: var(--space-1) 0 var(--space-1) var(--space-3);
    color: var(--color-ink-muted);
    text-decoration: none;
  }

  .cs-nav a::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: calc(var(--space-1) + 0.5rem - 2px);
    inline-size: 4px;
    block-size: 4px;
    background: var(--color-accent);
    opacity: 0;
  }

  .cs-nav a:hover {
    color: var(--color-ink);
  }

  .cs-nav a[aria-current] {
    color: var(--color-accent);
  }

  .cs-nav a[aria-current]::before {
    opacity: 1;
  }

  /* Below the rail's breakpoint: a collapsed "On this page" list above the overview. */
  .cs-toc {
    max-inline-size: var(--measure-case-reading);
    margin: var(--space-6) auto 0;
  }

  .cs-toc summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-2);
    font-family: var(--font-text);
    font-size: var(--step--1);
    color: var(--color-ink-muted);
    cursor: pointer;
    list-style: none;
  }

  .cs-toc summary::-webkit-details-marker {
    display: none;
  }

  .cs-toc summary::after {
    content: "";
    inline-size: 6px;
    block-size: 6px;
    border: solid currentColor;
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg) translateY(-2px);
  }

  .cs-toc[open] summary::after {
    transform: rotate(-135deg) translateY(-2px);
  }

  .cs-toc .cs-nav {
    padding-block: var(--space-2) var(--space-3);
  }

  @media (min-width: 80rem) {
    .cs-toc {
      display: none;
    }

    .cs-rail {
      display: block;
      position: absolute;
      inset-block: 0;
      z-index: 5;
      inset-inline-start: var(--space-5);
      inline-size: var(--size-case-rail);
      pointer-events: none;
    }

    /* Fills the viewport under the masthead, so the links sit in its vertical middle. */
    .cs-rail__sticky {
      position: sticky;
      inset-block-start: var(--header-height);
      display: flex;
      align-items: center;
      block-size: calc(100dvh - var(--header-height));
    }

    .cs-rail nav {
      pointer-events: auto;
    }
  }
</style>

<script>
  // Marks the section being read in every link list (the side rail, the "On this page" list, and the
  // older bar). The position comes from where each heading sits in the viewport, so it works in any
  // scrolling container, including inside a preview frame. Scroll events are caught in the capture
  // phase so a scrolling parent is heard too.
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-case-link]")];
  const current = document.querySelector<HTMLElement>("[data-case-current]");
  const bar = document.querySelector<HTMLDetailsElement>("[data-case-bar]");
  const toc = document.querySelector<HTMLDetailsElement>("[data-cs-toc]");
  const ids = [...new Set(links.map((a) => a.dataset.caseLink!))];
  const targets = ids
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null)
    .sort((a, b) => (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1));

  const mark = (id: string) => {
    links.forEach((a) => {
      if (a.dataset.caseLink === id) a.setAttribute("aria-current", "location");
      else a.removeAttribute("aria-current");
    });
    const link = links.find((a) => a.dataset.caseLink === id);
    if (current && link) current.textContent = [...link.querySelectorAll("span")].map((s) => s.textContent).join(" / ");
  };

  if (targets.length > 0) {
    // The last heading whose top has passed a line a little below the masthead is current.
    let queued = false;
    const update = () => {
      queued = false;
      const header = document.querySelector<HTMLElement>(".cs-top, .site-header");
      const line = (header?.getBoundingClientRect().bottom ?? 0) + window.innerHeight * 0.25;
      let active = targets[0].id;
      for (const t of targets) if (t.getBoundingClientRect().top <= line) active = t.id;
      // At the very bottom of the page the last section is current, even when it is too short to reach the line.
      if (document.documentElement.getBoundingClientRect().bottom <= window.innerHeight + 2) active = targets[targets.length - 1].id;
      mark(active);
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    document.addEventListener("scroll", queue, { passive: true, capture: true });
    addEventListener("resize", queue);
    update();
  }

  links.forEach((a) =>
    a.addEventListener("click", () => {
      if (bar) bar.open = false;
      if (toc) toc.open = false;
    }),
  );
</script>
