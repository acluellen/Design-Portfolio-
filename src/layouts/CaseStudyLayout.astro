---
import PageLayout from "./PageLayout.astro";
import Photo from "../components/site/Photo.astro";
import ActionLink from "../components/mdx/ActionLink.astro";
import type { PhotoKey } from "../data/photos";
import type { CaseStudy } from "../lib/case-studies";

interface Props {
  study: CaseStudy;
  prev?: CaseStudy;
  next?: CaseStudy;
  /** The study's ## headings, for the section index. */
  sections?: { slug: string; text: string }[];
}

const { study, prev, next, sections = [] } = Astro.props;
const { title, summary, headline, role, team, timeline, client, program, tools, cover, status, heroMedia, prototype } =
  study.data;

// Section index (Tee Hodgson's strip and Angelina Cao's numbered index): Overview, then one line
// per ## section, named by the study's `index` list or, failing that, by the heading itself.
const indexItems = [
  { id: "overview", label: "Overview" },
  ...sections.map((s, i) => ({ id: s.slug, label: study.data.index?.[i] ?? s.text })),
].map((item, i) => ({ ...item, number: String(i + 1).padStart(2, "0") }));
---

<PageLayout title={title} description={summary}>
  <article>
    <header class="container hero" id="overview">
      <div class:list={["hero__top", { "hero__top--media": heroMedia }]}>
        <div class="hero__intro">
          <p class="label hero__eyebrow">
            Case study
            {status === "draft" && <span class="hero__draft">Draft</span>}
          </p>
          <h1 translate="no">{title}</h1>
          {headline && <p class="hero__headline">{headline}</p>}
          <p class="hero__summary">{summary}</p>
          {
            prototype && (
              <ActionLink
                label="View live prototype"
                href={prototype === "TODO" ? undefined : prototype}
                variant="primary"
              />
            )
          }
        </div>
        {
          heroMedia && (
            <figure class="hero__media">
              <a class="hero__video" href={heroMedia.href} target="_blank" rel="noopener">
                <Photo
                  name={heroMedia.photo as PhotoKey}
                  widths={[480, 720, 1080]}
                  sizes="(min-width: 56rem) 34rem, 92vw"
                  ratio="16 / 9"
                  cover={16 / 9}
                />
                <span class="hero__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                </span>
                <span class="visually-hidden">{heroMedia.label} (opens in a new tab)</span>
              </a>
              <figcaption class="hero__caption">
                {heroMedia.caption}{" "}
                <a href={heroMedia.href} target="_blank" rel="noopener">
                  {heroMedia.linkText}<span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </figcaption>
            </figure>
          )
        }
      </div>

      <dl class="hero__facts">
        <div>
          <dt class="label">Role</dt>
          <dd>{role}</dd>
        </div>
        <div>
          <dt class="label">Timeline</dt>
          <dd>{timeline}</dd>
        </div>
        {
          team.length > 0 && (
            <div>
              <dt class="label">Team</dt>
              <dd>
                <ul class="hero__list">
                  {team.map((person) => (
                    <li>
                      {person.name}, <span class="hero__muted">{person.role}</span>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
        {
          client && (
            <div>
              <dt class="label">Client</dt>
              <dd>{client}</dd>
            </div>
          )
        }
        {
          program && (
            <div>
              <dt class="label">Program</dt>
              <dd>{program}</dd>
            </div>
          )
        }
        {
          tools.length > 0 && (
            <div>
              <dt class="label">Tools</dt>
              <dd>{tools.join(", ")}</dd>
            </div>
          )
        }
      </dl>

      {cover && <img class="hero__cover" src={cover.src} alt={cover.alt} />}
    </header>

    <!-- Phones and tablets: a thin bar under the header names the current section and opens the list. -->
    {
      indexItems.length > 2 && (
        <details class="case-bar" data-case-bar>
          <summary>
            <span class="case-bar__current" data-case-current>{indexItems[0].number} / {indexItems[0].label}</span>
            <span class="case-bar__hint">Sections</span>
          </summary>
          <ol class="case-bar__list">
            {indexItems.map((item) => (
              <li><a href={`#${item.id}`} data-case-link={item.id}><span>{item.number}</span><span>{item.label}</span></a></li>
            ))}
          </ol>
        </details>
      )
    }

    <div class:list={["container", { "case-grid": indexItems.length > 2 }]}>
      {
        indexItems.length > 2 && (
          <nav class="case-index" aria-label="Sections">
            <ol>
              {indexItems.map((item) => (
                <li><a href={`#${item.id}`} data-case-link={item.id}><span>{item.number}</span><span>{item.label}</span></a></li>
              ))}
            </ol>
          </nav>
        )
      }
      <div class="flow body">
        <slot />
      </div>
    </div>
  </article>

  {
    (prev || next) && (
      <nav class="container pager" aria-label="More case studies">
        {prev && (
          <a class="pager__link" href={`/work/${prev.id}/`} rel="prev">
            <span class="label">Previous</span>
            <span class="pager__title">{prev.data.title}</span>
          </a>
        )}
        {next && (
          <a class="pager__link pager__link--next" href={`/work/${next.id}/`} rel="next">
            <span class="label">Next</span>
            <span class="pager__title">{next.data.title}</span>
          </a>
        )}
      </nav>
    )
  }
</PageLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-9) var(--space-7);
  }

  .hero__top {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .hero__top--media {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .hero__intro {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .hero__media {
    display: grid;
    gap: var(--space-3);
  }

  .hero__video {
    position: relative;
    display: block;
    overflow: hidden;
    border: var(--rule-thin) solid var(--color-rule);
    border-radius: var(--radius-media);
  }

  .hero__video :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero__play {
    position: absolute;
    inset: 50% auto auto 50%;
    display: grid;
    place-items: center;
    inline-size: var(--size-play);
    block-size: var(--size-play);
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--color-overlay);
    color: var(--color-always-dark-ink);
    transition: background var(--duration-hover) var(--ease-standard);
  }

  .hero__video:hover .hero__play {
    background: var(--color-brand);
  }

  .hero__caption {
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }

  .hero__eyebrow {
    display: flex;
    gap: var(--space-4);
  }

  .hero__draft {
    color: var(--color-accent);
  }

  .hero__headline {
    max-width: 24ch;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: var(--weight-heading);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .hero__summary {
    max-width: var(--measure-reading);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--color-ink-muted);
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-5) var(--space-6);
    margin-block-start: var(--space-5);
    padding-block-start: var(--space-5);
    border-top: var(--rule-thin) solid var(--color-rule);
  }

  .hero__facts > div {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    min-width: 0;
  }

  .hero__facts dd {
    margin: 0;
  }

  .hero__list {
    padding: 0;
    list-style: none;
  }

  .hero__muted {
    color: var(--color-ink-muted);
  }

  .hero__cover {
    width: 100%;
    margin-block-start: var(--space-5);
    border: var(--rule-thin) solid var(--color-rule);
    border-radius: var(--radius-media);
  }

  .body {
    padding-block-start: var(--space-4);
  }

  /* Text keeps a reading measure. Blocks marked .is-wide (card grids, comparisons, panels)
     use the full container width. */
  .body > :global(*),
  .body :global(.section__inner > *) {
    max-width: var(--measure-reading);
  }

  .body > :global(.is-wide),
  .body :global(.section__inner > .is-wide) {
    max-width: none;
  }

  /* Tables written in Markdown: comparisons and targets. Scroll sideways inside their own box
     on narrow screens instead of widening the page. */
  .body :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--step--1);
    line-height: var(--leading-snug);
  }

  .body :global(th),
  .body :global(td) {
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
    border-bottom: var(--rule-thin) solid var(--color-rule);
    text-align: start;
    vertical-align: top;
  }

  .body :global(thead th) {
    font-weight: var(--weight-semibold);
    border-bottom-color: var(--color-rule-strong);
  }

  /* Headings in the running text only. Headings inside cards and comparisons set their own space. */
  .body > :global(h3),
  .body :global(.section__inner > h3) {
    margin-block-start: var(--space-7);
  }

  /* A small label written just above a heading belongs to it: the space goes above the label. */
  .body > :global(p.label:has(+ h2)) {
    margin-block-start: var(--space-8);
  }

  .body > :global(p.label + h2),
  .body :global(.section__inner > p.label + h2) {
    margin-block-start: var(--space-2);
  }

  /* Each part of the story starts well clear of the one before. */
  .body > :global(.section) {
    margin-block-start: var(--space-8);
  }

  /* A small note under a block: method details, baselines. */
  .body :global(.note) {
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: var(--color-ink-muted);
  }

  .pager {
    display: grid;
    gap: var(--space-5);
    margin-block-start: var(--space-9);
  }

  @media (min-width: 48rem) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }

    .pager__link--next {
      grid-column: 2;
      text-align: end;
    }
  }

  .pager__link {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-top: var(--rule-thin) solid var(--color-rule-strong);
    color: inherit;
    text-decoration: none;
  }

  .pager__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
  }

  .pager__link:hover .pager__title {
    color: var(--color-accent-hover);
  }

  /* Section index. Wide screens: a numbered list beside the body that stays in view and marks the
     section on screen. Narrower: a thin bar under the header (details) with the current section. */
  .case-grid {
    display: grid;
    gap: var(--space-7);
  }

  .case-grid > * {
    min-width: 0;
  }

  .case-index {
    display: none;
  }

  .case-index ol,
  .case-bar__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .case-index a,
  .case-bar__list a {
    display: grid;
    grid-template-columns: 2.5ch 1fr;
    gap: var(--space-3);
    align-items: center;
    min-block-size: var(--control-height);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    text-decoration: none;
    border-block-end: var(--rule-thin) solid var(--color-rule);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .case-index a:hover,
  .case-bar__list a:hover {
    color: var(--color-ink);
  }

  /* Current section: ink color and a short bar on the left. */
  .case-index a[aria-current],
  .case-bar__list a[aria-current] {
    color: var(--color-heading);
    box-shadow: inset var(--rule-thick) 0 0 var(--color-heading);
    padding-inline-start: var(--space-3);
  }

  .case-index li:first-child a,
  .case-bar__list li:first-child a {
    border-block-start: var(--rule-thin) solid var(--color-rule-strong);
  }

  @media (min-width: 72rem) {
    .case-grid {
      grid-template-columns: var(--size-case-index) minmax(0, 1fr);
      column-gap: var(--space-8);
      align-items: start;
    }

    .case-index {
      display: block;
      position: sticky;
      top: calc(var(--header-height) + var(--space-6));
    }

    .case-bar {
      display: none;
    }
  }

  .case-bar {
    position: sticky;
    top: var(--header-height);
    z-index: 15;
    background: var(--color-paper);
    border-block-end: var(--rule-thin) solid var(--color-rule);
    padding-inline: var(--gutter);
    margin-block-end: var(--space-6);
  }

  .case-bar summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    min-block-size: var(--control-height);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-heading);
    cursor: pointer;
    list-style: none;
  }

  .case-bar summary::-webkit-details-marker {
    display: none;
  }

  .case-bar__hint {
    color: var(--color-ink-muted);
  }

  .case-bar__hint::after {
    content: " +";
  }

  .case-bar[open] .case-bar__hint::after {
    content: " ×";
  }

  .case-bar__list {
    padding-block-end: var(--space-3);
  }

  /* Where the header stops sticking (very narrow or very large text), the bar sits at the top. */
  @media (max-width: 24rem) {
    .case-bar {
      top: 0;
    }
  }

  /* Jump links land below the header and the bar. */
  @media (max-width: 71.99rem) {
    :global(html:has(.case-bar)) {
      scroll-padding-top: calc(var(--header-height) + var(--control-height) + var(--space-4));
    }
  }
</style>

<script>
  // Marks the section on screen in both the side index and the bar, and closes the bar after a jump.
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-case-link]")];
  const current = document.querySelector<HTMLElement>("[data-case-current]");
  const bar = document.querySelector<HTMLDetailsElement>("[data-case-bar]");
  const ids = [...new Set(links.map((a) => a.dataset.caseLink!))];
  const targets = ids.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => el !== null);

  const mark = (id: string) => {
    links.forEach((a) => {
      if (a.dataset.caseLink === id) a.setAttribute("aria-current", "location");
      else a.removeAttribute("aria-current");
    });
    const link = links.find((a) => a.dataset.caseLink === id);
    if (current && link) current.textContent = [...link.querySelectorAll("span")].map((s) => s.textContent).join(" / ");
  };

  if (targets.length > 0) {
    // The last section whose top has passed the upper third of the screen is current.
    let queued = false;
    const update = () => {
      queued = false;
      const line = window.innerHeight * 0.33;
      let active = targets[0].id;
      for (const t of targets) if (t.getBoundingClientRect().top <= line) active = t.id;
      mark(active);
    };
    addEventListener("scroll", () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();
  }

  links.forEach((a) => a.addEventListener("click", () => bar && (bar.open = false)));
</script>
