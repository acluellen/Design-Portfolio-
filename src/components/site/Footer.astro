---
import fs from "node:fs";
import path from "node:path";
import ContactEmail from "./ContactEmail.astro";
import { site } from "../../site.config";

interface Props {
  /** The home page shows the email in its closing section, so its footer leaves it out. */
  showEmail?: boolean;
}

const { showEmail = true } = Astro.props;

// The Resume link appears only once a PDF exists at public/resume.pdf.
const hasResume = fs.existsSync(path.join(process.cwd(), "public", site.resumePath));
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    {showEmail && <ContactEmail />}
    <ul class="site-footer__links">
      <li>
        {
          site.linkedin ? (
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
              LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          ) : (
            <span class="site-footer__pending">LinkedIn, coming soon</span>
          )
        }
      </li>
      {/* Hidden until public/resume.pdf exists. */}
      {hasResume && <li><a href={site.resumePath}>Resume</a></li>}
    </ul>
    <p class="site-footer__fine">© {year} {site.name} · Built with Claude Code</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--rule-thin) solid var(--color-rule);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-7);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }

  .site-footer__links a,
  .site-footer__pending {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-height);
    color: var(--color-ink);
  }

  .site-footer__links a:hover {
    color: var(--color-accent);
  }

  .site-footer__pending {
    color: var(--color-ink-muted);
  }

  .site-footer__fine {
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
</style>
