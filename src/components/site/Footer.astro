---
import fs from "node:fs";
import path from "node:path";
import { mailto, site } from "../../site.config";

// The Resume link appears only once a PDF exists at public/resume.pdf.
const hasResume = fs.existsSync(path.join(process.cwd(), "public", site.resumePath));
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <a class="site-footer__email" href={mailto}>{site.email}</a>
    <ul class="site-footer__links">
      <li>
        {
          site.linkedin ? (
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
              LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          ) : (
            <span class="site-footer__pending" title="LinkedIn link coming soon">LinkedIn</span>
          )
        }
      </li>
      {/* Hidden until public/resume.pdf exists. */}
      {hasResume && <li><a href={site.resumePath}>Resume</a></li>}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--rule-thin) solid var(--color-rule);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    padding-block: var(--space-8);
  }

  .site-footer__email {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }

  .site-footer__email:hover {
    color: var(--color-accent);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: 0;
    list-style: none;
  }

  .site-footer__links a,
  .site-footer__pending {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-height);
    color: var(--color-ink);
  }

  .site-footer__links a:hover {
    color: var(--color-accent);
  }

  .site-footer__pending {
    color: var(--color-ink-muted);
  }

  .site-footer__email {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-height);
  }
</style>
