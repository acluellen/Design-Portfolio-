---
// Renders a photo slot from src/data/photos.ts. Optimized by Astro when the file exists,
// a neutral placeholder when it does not.
//
// Crop rule: srcset widths assume the whole file fills the display box. When the box crops
// the file with object-fit: cover (`cover` = box width / height) and the file is wider than
// the box, the visible part is zoomed in. The zoom factor scales both the widths and the
// sizes hint, so the browser picks a file sharp enough for the zoomed area. Pre-cropping
// the source to the box shape keeps the zoom at 1, which is the better fix.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { photos, type PhotoKey } from "../../data/photos";

interface Props {
  name: PhotoKey;
  widths: number[];
  sizes: string;
  class?: string;
  loading?: "lazy" | "eager";
  /** Placeholder shape when the file is missing, e.g. "4 / 3". */
  ratio?: string;
  /** Quiet placeholder: no outline, shows this label instead of the slot name. */
  placeholderLabel?: string;
  /** Box shape (width / height) when the photo is cropped with object-fit: cover. */
  cover?: number;
  /** Encoder quality for AVIF, WebP, and the JPEG fallback. */
  quality?: number;
}

const {
  name,
  widths,
  sizes,
  class: className,
  loading = "lazy",
  ratio = "4 / 3",
  placeholderLabel,
  cover,
  quality = 80,
} = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/photos/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);
const match = Object.entries(files).find(([path]) =>
  new RegExp(`/${name}\\.(jpe?g|png|webp|avif)$`, "i").test(path),
);
const image = match?.[1].default;
const { alt } = photos[name];

// How far object-fit: cover zooms into the file horizontally. 1 means no zoom.
const zoom = image && cover ? Math.max(1, image.width / image.height / cover) : 1;
if (image && zoom > 1.05) {
  console.warn(`Photo "${name}": the crop zooms ${zoom.toFixed(2)}x. Pre-crop the source to ${cover?.toFixed(2)}:1.`);
}

// Scale each width by the zoom, cap at the file width, and keep the file width as the top step.
const scaled = image ? widths.map((w) => Math.round(w * zoom)) : widths;
const srcWidths = image
  ? [...new Set([...scaled.filter((w) => w < image.width), ...(scaled.some((w) => w >= image.width) ? [image.width] : [])])]
  : widths;

// Scale the length in each sizes entry by the same zoom.
const srcSizes =
  zoom === 1
    ? sizes
    : sizes
        .split(/,(?![^(]*\))/)
        .map((entry) => {
          const part = entry.trim();
          const match = part.match(/^(\(.*\))\s+(.+)$/);
          const [cond, length] = match ? [match[1], match[2]] : ["", part];
          return `${cond ? cond + " " : ""}calc(${length} * ${zoom.toFixed(3)})`;
        })
        .join(", ");
---

{
  image ? (
    <Picture
      src={image}
      alt={alt}
      widths={srcWidths}
      sizes={srcSizes}
      quality={quality}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      loading={loading}
      decoding="async"
      class={className}
    />
  ) : (
    <div
      class:list={["photo-placeholder", { "photo-placeholder--quiet": placeholderLabel }, className]}
      style={`aspect-ratio: ${cover ?? ratio}`}
      role="img"
      aria-label={alt || "Image coming soon"}
    >
      <span>{placeholderLabel ?? `Photo: ${name}`}</span>
    </div>
  )
}

<style>
  .photo-placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    background: var(--color-panel);
    border: var(--rule-thin) dashed var(--color-rule-strong);
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  .photo-placeholder--quiet {
    border: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    text-align: center;
    padding: var(--space-5);
  }
</style>
