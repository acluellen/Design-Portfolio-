---
// Renders a photo slot from src/data/photos.ts. Optimized by Astro when the file exists,
// a neutral placeholder when it does not.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { photos, type PhotoKey } from "../../data/photos";

interface Props {
  name: PhotoKey;
  widths: number[];
  sizes: string;
  class?: string;
  loading?: "lazy" | "eager";
  /** Placeholder shape when the file is missing, e.g. "4 / 3". */
  ratio?: string;
  /** Quiet placeholder: no outline, shows this label instead of the slot name. */
  placeholderLabel?: string;
}

const {
  name,
  widths,
  sizes,
  class: className,
  loading = "lazy",
  ratio = "4 / 3",
  placeholderLabel,
} = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/photos/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);
const match = Object.entries(files).find(([path]) =>
  new RegExp(`/${name}\\.(jpe?g|png|webp|avif)$`, "i").test(path),
);
const image = match?.[1].default;
const { alt } = photos[name];
---

{
  image ? (
    <Picture
      src={image}
      alt={alt}
      widths={widths.filter((w) => w <= image.width)}
      sizes={sizes}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      loading={loading}
      decoding="async"
      class={className}
    />
  ) : (
    <div
      class:list={["photo-placeholder", { "photo-placeholder--quiet": placeholderLabel }, className]}
      style={`aspect-ratio: ${ratio}`}
      role="img"
      aria-label={alt || "Image coming soon"}
    >
      <span>{placeholderLabel ?? `Photo: ${name}`}</span>
    </div>
  )
}

<style>
  .photo-placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    background: var(--color-panel);
    border: var(--rule-thin) dashed var(--color-rule-strong);
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  .photo-placeholder--quiet {
    border: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    text-align: center;
    padding: var(--space-5);
  }
</style>
