---
// The AL mark from src/assets/brand/logo.svg (Aaron's file), inlined so its colors follow the theme:
// navy with paper lines on the light page, light with navy lines on the dark page.
// Falls back to a text mark if the file is missing.
const files = import.meta.glob<string>("/src/assets/brand/logo.svg", { eager: true, query: "?raw", import: "default" });
const raw = Object.values(files)[0];
// October 14: the header shows the AL lines alone, without the filled square, so the top of the
// page reads lighter. The square is dropped, the view is cropped to the two letters, and the
// triangle line is thickened so it still reads at this small size. Colors follow the theme.
const svg = raw
  ?.replace(/<svg /, '<svg class="logo" aria-hidden="true" focusable="false" ')
  .replace(/viewBox="[^"]*"/, 'viewBox="24 47 88 50"')
  .replace(/\s(role|aria-label)="[^"]*"/g, "")
  .replace(/<rect[^>]*\/>/i, "")
  .replace(/stroke="#F6F3ED"/i, 'style="stroke: var(--color-logo)"')
  .replace(/stroke-width="[^"]*"/i, 'stroke-width="3.4"')
  .replace(/fill="#F6F3ED"/i, 'style="fill: var(--color-logo)"');
---

{svg ? <Fragment set:html={svg} /> : <span class="logo logo--text" aria-hidden="true">AL</span>}

<style>
  :global(.logo) {
    display: block;
    inline-size: auto;
    block-size: var(--size-logo-mark);
  }

  .logo--text {
    border-radius: var(--radius-media);
    display: grid;
    place-items: center;
    background: var(--color-logo);
    color: var(--color-logo-ink);
    font-family: var(--font-mono);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
  }
</style>
