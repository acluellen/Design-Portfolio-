---
// Uses src/assets/brand/logo.(svg|png) when present. Until then, a text mark in the accent blue.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

const files = import.meta.glob<{ default: ImageMetadata }>("/src/assets/brand/logo.{svg,png}", {
  eager: true,
});
const logo = Object.values(files)[0]?.default;
---

{
  logo ? (
    <Image src={logo} alt="" class="logo" width={96} height={96} />
  ) : (
    <span class="logo logo--text" aria-hidden="true">AL</span>
  )
}

<style>
  .logo {
    display: block;
    inline-size: var(--size-logo);
    block-size: var(--size-logo);
    border-radius: var(--radius-media);
  }

  .logo--text {
    display: grid;
    place-items: center;
    background: var(--color-brand);
    color: var(--color-brand-ink);
    font-family: var(--font-text);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
  }
</style>
