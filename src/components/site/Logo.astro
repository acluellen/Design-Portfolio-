---
// The AL mark from src/assets/brand/logo.svg (Aaron's file). Falls back to a text mark if it is missing.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

const files = import.meta.glob<{ default: ImageMetadata }>("/src/assets/brand/logo.svg", {
  eager: true,
});
const logo = Object.values(files)[0]?.default;
---

{
  logo ? (
    <Image src={logo} alt="" class="logo" width={96} height={96} loading="eager" />
  ) : (
    <span class="logo logo--text" aria-hidden="true">AL</span>
  )
}

<style>
  /* The SVG draws its own rounded corners. */
  .logo {
    display: block;
    inline-size: var(--size-logo);
    block-size: var(--size-logo);
  }

  .logo--text {
    border-radius: var(--radius-media);
    display: grid;
    place-items: center;
    background: var(--color-brand);
    color: var(--color-brand-ink);
    font-family: var(--font-text);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
  }
</style>
