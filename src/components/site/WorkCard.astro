---
// A Selected work card: image, small label, title, one description, one detail line.
// `featured` makes the large card: image and text side by side from 56rem up.
import Photo from "./Photo.astro";
import { photos, type PhotoKey } from "../../data/photos";
import type { CaseStudy } from "../../lib/case-studies";

interface Props {
  study: CaseStudy;
  /** Case study URL. Without it the card does not link. */
  href?: string;
  featured?: boolean;
}

const { study, href, featured = false } = Astro.props;
const { title, card, inProgress } = study.data;
const photoKey = `work-${study.id}`;
const photo = (photoKey in photos ? photoKey : undefined) as PhotoKey | undefined;

// The image area is 4:3. Featured images take about 7/12 of the wide column, small ones half.
const sizes = featured
  ? "(min-width: 76rem) 38rem, (min-width: 56rem) 52vw, 92vw"
  : "(min-width: 76rem) 31rem, (min-width: 48rem) 44vw, 92vw";
---

<article
  class:list={["work-card", { "work-card--featured": featured, "work-card--linked": href }]}
>
  <div class="work-card__media">
    {
      photo ? (
        <Photo
          name={photo}
          widths={featured ? [600, 900, 1200, 1448] : [400, 600, 800, 1000, 1200]}
          sizes={sizes}
          ratio="4 / 3"
          cover={4 / 3}
          placeholderLabel={title}
          class="work-card__image"
          loading={featured ? "eager" : "lazy"}
        />
      ) : (
        <div class="work-card__fallback" aria-hidden="true">{title}</div>
      )
    }
  </div>

  <div class="work-card__text">
    <div class="work-card__top">
      {card?.label && <p class="work-card__label">{card.label}</p>}
      {inProgress && <p class="work-card__status">In progress</p>}
    </div>
    <h3 class="work-card__title">
      {href ? <a href={href}>{title}</a> : title}
    </h3>
    {card?.description && <p class="work-card__description">{card.description}</p>}
    {card?.detail && <p class="work-card__detail">{card.detail}</p>}
    {
      href && (
        <span class="work-card__cta" aria-hidden="true">
          View case study
        </span>
      )
    }
  </div>
</article>

<style>
  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--gap-card-media);
    height: 100%;
    padding: var(--space-5);
    background: var(--color-paper-raised);
    border: var(--rule-thin) solid var(--color-rule);
    border-radius: var(--radius-media);
  }

  .work-card--linked {
    transition:
      transform var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .work-card--linked:hover {
    transform: translateY(calc(-1 * var(--card-lift)));
    border-color: var(--color-ink);
  }

  /* Image area: 4:3 on a soft panel. */
  .work-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-panel);
    border-radius: var(--radius-media);
  }

  .work-card__media :global(picture),
  .work-card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .work-card__media :global(img) {
    object-fit: cover;
  }

  .work-card__media :global(.photo-placeholder),
  .work-card__fallback {
    width: 100%;
    height: 100%;
  }

  .work-card__fallback {
    display: grid;
    place-items: center;
    padding: var(--space-5);
    font-size: var(--step-2);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink-muted);
    text-align: center;
  }

  .work-card__text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  .work-card__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  /* Small labels: blue text on light blue (dark blue panel on dark), as pills. */
  .work-card__label,
  .work-card__status {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-accent-subtle);
    color: var(--color-label-ink);
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
  }

  .work-card__title {
    font-size: var(--step-2);
  }

  .work-card__title a {
    color: inherit;
    text-decoration: none;
  }

  /* The title link covers the whole card. */
  .work-card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-media);
  }

  .work-card__title a:focus-visible {
    outline: none;
  }

  .work-card__title a:focus-visible::after {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  .work-card__description {
    line-height: var(--leading-snug);
  }

  /* Detail line sits at the bottom so cards in a row line up. */
  .work-card__detail {
    margin-block-start: auto;
    padding-block-start: var(--space-4);
    border-top: var(--rule-thin) solid var(--color-rule);
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }

  /* Looks like a small secondary button. The whole card is the actual link. */
  .work-card__cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-height-small);
    padding-inline: var(--space-4);
    border: var(--rule-thin) solid var(--color-ink);
    border-radius: var(--radius-control);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-button);
    color: var(--color-ink);
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }

  .work-card--linked:hover .work-card__cta {
    background: var(--color-ink);
    color: var(--color-paper-raised);
  }

  /* Featured: larger type, image and text side by side on wide screens. */
  .work-card--featured .work-card__title {
    font-size: var(--step-4);
  }

  .work-card--featured .work-card__description {
    font-size: var(--step-1);
  }

  @media (min-width: 56rem) {
    .work-card--featured {
      display: grid;
      grid-template-columns: 7fr 5fr;
      align-items: stretch;
      gap: var(--space-7);
      padding: var(--space-6);
    }

    .work-card--featured .work-card__text {
      justify-content: center;
      padding-block: var(--space-5);
    }

    .work-card--featured .work-card__detail {
      margin-block-start: var(--space-5);
    }
  }
</style>
