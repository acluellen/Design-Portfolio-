---
// A Selected work tile (October 10 direction): a large image, then a row with the number, the
// project name, and two or three tags, then the one line description. The image is a gray
// placeholder until the project media is ready. `wide` is the full width tile on top.
// The whole tile is one link; on hover or focus the name rolls up to "View case study".
import type { CaseStudy } from "../../lib/case-studies";

interface Props {
  study: CaseStudy;
  /** Case study URL. Without it the tile does not link. */
  href?: string;
  wide?: boolean;
  /** Position in Selected work, shown as 01, 02, 03. */
  index: number;
}

const { study, href, wide = false, index } = Astro.props;
const { title, card, inProgress } = study.data;
const number = String(index).padStart(2, "0");
---

<article class:list={["tile", { "tile--wide": wide, "tile--linked": href }]}>
  <div class="tile__media" aria-hidden="true">
    <span class="tile__slot">Project media</span>
  </div>

  <div class="tile__row">
    <span class="tile__number" aria-hidden="true">{number}</span>
    <h3 class="tile__title" translate="no">
      {
        href ? (
          <a href={href}>
            <span class="tile__roll">
              <span>{title}</span>
              <span aria-hidden="true">View case study</span>
            </span>
          </a>
        ) : (
          title
        )
      }
    </h3>
    {
      card?.tags && (
        <ul class="tile__tags" aria-label="Tags">
          {card.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )
    }
  </div>

  {card?.description && <p class="tile__description">{card.description}</p>}
  {inProgress && <p class="tile__status">In progress</p>}
  {!href && !inProgress && <p class="tile__status">Case study coming soon</p>}
</article>

<style>
  .tile {
    position: relative;
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  /* Gray placeholder until the project media arrives. */
  .tile__media {
    display: grid;
    place-items: center;
    aspect-ratio: var(--ratio-tile);
    background: var(--color-placeholder);
    border-radius: var(--radius-media);
    overflow: hidden;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .tile--wide .tile__media {
    aspect-ratio: var(--ratio-tile-wide);
  }

  .tile--linked:hover .tile__media {
    opacity: 0.85;
  }

  .tile__slot {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  /* Number, name, tags on one line. Tags wrap under on narrow tiles. */
  .tile__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    padding-block-start: var(--space-2);
  }

  .tile__number {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    color: var(--color-ink-muted);
  }

  .tile__title {
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    color: var(--color-heading);
    min-width: 0;
  }

  .tile__title a {
    color: inherit;
    text-decoration: none;
  }

  /* The name link covers the whole tile. */
  .tile__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .tile__title a:focus-visible {
    outline: none;
  }

  .tile__title a:focus-visible::after {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  /* The roll: two lines stacked in a one line window. */
  .tile__roll {
    display: block;
    block-size: calc(1em * var(--leading-snug));
    overflow: hidden;
  }

  .tile__roll > span {
    display: block;
    transition: transform var(--duration-roll) var(--ease-roll);
  }

  .tile--linked:hover .tile__roll > span,
  .tile__title a:focus-visible .tile__roll > span {
    transform: translateY(-100%);
  }

  .tile__roll > span + span {
    color: var(--color-accent);
  }

  /* Small square mono tags, pushed to the end of the row. */
  .tile__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
  }

  .tile__tags li {
    padding: var(--space-1) var(--space-2);
    border: var(--rule-thin) solid var(--color-rule-strong);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: var(--leading-snug);
    color: var(--color-ink-muted);
  }

  .tile__description {
    max-width: var(--measure-reading);
    color: var(--color-ink-muted);
  }

  .tile__status {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
</style>
