---
// Craft Education home tile (Oct 13 2026), after Micah Hoang's Gaia card: one real photo, one slow
// motion. An iPhone lies on a sunlit wooden table (Pexels photo 36538952, free license, supplied by
// Aaron; the four corner guide marks on its screen were painted out and the sides widened slightly).
// On the screen the Craft Education logo fades in, holds, and fades out. Craft's brand appears only
// on the screen, since its design system is not final. The quiet tile next to the busy AthenaScribe
// and Klima tiles. The fade repeats past five seconds, so it has the same pause button as the other
// tiles (WCAG 2.2.2). Reduced motion: the logo simply shows.
// The logo is cropped from the redesigned Learning Center page (public/media/craft-logo.png, 180 by
// 80); `multiply` lets the photo's screen light show through its white background.
const label = "An iPhone lying on a sunlit wooden table, the Craft Education logo on its screen.";
---

<div class="cft" data-cft>
  <div class="cft__scene" role="img" aria-label={label}>
    <img class="cft__photo" src="/media/craft-tile.jpg" alt="" width="1600" height="900" loading="lazy" decoding="async" />
    <img class="cft__logo" src="/media/craft-logo.png" alt="" width="180" height="80" />
  </div>
  <button type="button" class="cft__pz" aria-label="Pause animation" data-cft-pz>
    <svg class="cft__pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="7" y="5" width="3.5" height="14" rx="1"></rect><rect x="13.5" y="5" width="3.5" height="14" rx="1"></rect></svg>
    <svg class="cft__play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>
  </button>
</div>

<style>
  .cft {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--craft-tile-bg);
  }

  .cft__scene {
    position: absolute;
    inset: 0;
  }

  .cft__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  /* Placed on the photo's screen: its center, its tilt (the phone lies turned 38.7 degrees), and
     60% of the screen's width. Measured from the photo, so these numbers belong to this photo only. */
  .cft__logo {
    position: absolute;
    left: 51.1%;
    top: 49.7%;
    width: 13.4%;
    height: auto;
    max-width: none;
    transform: translate(-50%, -50%) rotate(-38.7deg);
    mix-blend-mode: multiply;
    animation: cft-breath var(--duration-craft-breath) ease-in-out infinite;
  }

  .cft.is-paused .cft__logo,
  .cft.is-off .cft__logo {
    animation-play-state: paused;
  }

  @keyframes cft-breath {
    0%, 100% { opacity: 0; }
    35%, 70% { opacity: 1; }
  }

  .cft__pz {
    pointer-events: auto;
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--craft-pz-edge);
    background: var(--craft-pz-bg);
    color: var(--craft-pz-ink);
    cursor: pointer;
    opacity: 0.7;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .cft__pz:hover,
  .cft__pz:focus-visible {
    opacity: 1;
  }

  .cft__pz:focus-visible {
    outline: var(--focus-width) solid var(--craft-pz-ink);
    outline-offset: 2px;
  }

  .cft__pz svg {
    width: 14px;
    height: 14px;
  }

  .cft__play,
  .cft.is-paused .cft__pause {
    display: none;
  }

  .cft.is-paused .cft__play {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .cft__logo {
      animation: none;
    }

    .cft__pz {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-cft]").forEach((root) => {
    const pz = root.querySelector<HTMLButtonElement>("[data-cft-pz]")!;
    pz.addEventListener("click", (ev) => {
      ev.preventDefault();
      ev.stopPropagation();
      const paused = root.classList.toggle("is-paused");
      pz.setAttribute("aria-label", paused ? "Play animation" : "Pause animation");
    });
    // Rests while off screen.
    new IntersectionObserver(([e]) => root.classList.toggle("is-off", !e.isIntersecting)).observe(root);
  });
</script>
