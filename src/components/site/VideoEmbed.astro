---
// YouTube video that loads the player only when clicked. Until then, just a thumbnail.
import { youtubeId, youtubeStart } from "../../site.config";

interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const id = youtubeId(url);
const start = youtubeStart(url);
---

<div class="video">
  {
    id ? (
      <button type="button" class="video__button" data-video-id={id} data-video-start={start} data-video-title={title}>
        <img
          class="video__thumb"
          src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
          alt=""
          loading="lazy"
          decoding="async"
        />
        <span class="video__play" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
        </span>
        <span class="visually-hidden">Play video: {title}</span>
      </button>
    ) : (
      <div class="video__pending">
        <span>Video link coming soon</span>
      </div>
    )
  }
</div>

<script>
  // If the thumbnail cannot load, hide it so the dark panel and play button still read cleanly.
  document.querySelectorAll<HTMLImageElement>(".video__thumb").forEach((thumb) => {
    const hide = () => (thumb.hidden = true);
    if (thumb.complete && thumb.naturalWidth === 0) hide();
    else thumb.addEventListener("error", hide);
  });

  document.querySelectorAll<HTMLButtonElement>("[data-video-id]").forEach((button) => {
    button.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      const start = Number(button.dataset.videoStart) || 0;
      iframe.src = `https://www.youtube-nocookie.com/embed/${button.dataset.videoId}?autoplay=1${start ? `&start=${start}` : ""}`;
      iframe.title = button.dataset.videoTitle ?? "Video";
      iframe.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture";
      iframe.allowFullscreen = true;
      iframe.className = "video__frame";
      button.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    max-width: 100%;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--color-always-dark);
  }

  .video__button {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .video__thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video__play {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: var(--space-9);
    block-size: var(--space-9);
    border-radius: var(--radius-pill);
    background: var(--color-always-dark);
    color: var(--color-always-dark-ink);
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .video__play svg {
    inline-size: 40%;
    block-size: 40%;
  }

  .video__button:hover .video__play {
    transform: scale(1.06);
  }

  .video__pending {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--color-panel);
    border: var(--rule-thin) dashed var(--color-rule-strong);
    border-radius: var(--radius-media);
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  .video :global(.video__frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
