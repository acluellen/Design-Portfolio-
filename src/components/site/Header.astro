---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../../site.config";

// Work and About are sections on the home page. On a case study page, Work is current.
// On the home page, a small script marks the section in view (see below).
const path = Astro.url.pathname;
const onCaseStudy = path.startsWith("/work/");
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__home" href="/" aria-label={`${site.name}, home`}>
      <Logo />
    </a>
    <nav aria-label="Main">
      <ul class="site-header__nav">
        <li>
          <a href="/#work" data-nav-section="work" aria-current={onCaseStudy ? "page" : undefined}>Work</a>
        </li>
        <li><a href="/#about" data-nav-section="about">About</a></li>
        {/* Hidden until site.linkedin has Aaron's link. */}
        {
          site.linkedin && (
            <li>
              <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
                LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </li>
          )
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<script>
  // At very large text sizes the header can grow tall. Past a fifth of the screen it stops
  // sticking and scrolls away with the page, so it never covers the content.
  const header = document.querySelector<HTMLElement>(".site-header");
  if (header && "ResizeObserver" in window) {
    const MAX_SHARE = 0.2;
    const check = () => header.classList.toggle("site-header--tall", header.offsetHeight > window.innerHeight * MAX_SHARE);
    new ResizeObserver(check).observe(header);
    window.addEventListener("resize", check);
  }

  // On the home page, mark Work or About as current while that section is on screen.
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-nav-section]")];
  const sections = links
    .map((link) => document.getElementById(link.dataset.navSection ?? ""))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length > 0 && "IntersectionObserver" in window) {
    const visible = new Set<string>();
    const mark = () => {
      // The topmost visible section wins.
      const current = sections.find((s) => visible.has(s.id))?.id;
      links.forEach((link) => {
        if (link.dataset.navSection === current) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    };
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
        mark();
      },
      { rootMargin: "-40% 0px -55% 0px" },
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>

<style>
  /* Sticky: stays at the top while scrolling, with its solid background and thin bottom line. */
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: var(--color-paper);
    border-bottom: var(--rule-thin) solid var(--color-rule);
  }

  /* Wraps instead of stacking: at very large text the links move to a second row, side by side. */
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    min-block-size: var(--header-height);
    padding-block: var(--space-3);
  }

  .site-header__home {
    margin-inline-end: auto;
    text-decoration: none;
    border-radius: var(--radius-media);
  }

  .site-header__nav {
    display: flex;
    gap: var(--space-2) var(--space-5);
    padding: 0;
    list-style: none;
    font-family: var(--font-text);
    font-size: var(--step--1);
  }

  /* 44px tall tap targets. */
  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-height);
    color: var(--color-ink);
    text-decoration: none;
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current] {
    text-decoration: underline;
    text-decoration-thickness: var(--underline-thickness);
    text-underline-offset: var(--underline-offset);
  }

  .site-header__nav a:hover {
    text-decoration-color: var(--color-accent);
  }

  /* Very narrow screens, which is also a phone at its largest text or zoom setting: tighter
     spacing, and the header scrolls away instead of covering a third of the screen. */
  .site-header--tall {
    position: static;
  }

  @media (max-width: 24rem) {
    .site-header {
      position: static;
    }

    .site-header__inner {
      gap: var(--space-2) var(--space-4);
    }

    .site-header__nav {
      gap: var(--space-4);
    }
  }
</style>
