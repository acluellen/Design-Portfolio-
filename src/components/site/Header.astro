---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../../site.config";

const path = Astro.url.pathname;
const isAbout = path.startsWith("/about");
const isWork = !isAbout && (path === "/" || path.startsWith("/work/"));
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__home" href="/" aria-label={`${site.name}, home`}>
      <Logo />
    </a>
    <nav aria-label="Main">
      <ul class="site-header__nav">
        <li><a href="/#work" aria-current={isWork ? "page" : undefined}>Work</a></li>
        <li><a href="/about/" aria-current={isAbout ? "page" : undefined}>About</a></li>
        <li>
          {
            site.linkedin ? (
              <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            ) : (
              <span class="site-header__pending" title="LinkedIn link coming soon">LinkedIn</span>
            )
          }
        </li>
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    background: var(--color-paper);
    border-bottom: var(--rule-thin) solid var(--color-rule);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-block-size: var(--header-height);
    padding-block: var(--space-3);
  }

  .site-header__home {
    margin-inline-end: auto;
    text-decoration: none;
    border-radius: var(--radius-media);
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }

  .site-header__nav a,
  .site-header__pending {
    color: var(--color-ink);
    text-decoration: none;
    padding-block: var(--space-1);
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: var(--underline-thickness);
    text-underline-offset: var(--underline-offset);
  }

  .site-header__nav a:hover {
    text-decoration-color: var(--color-accent);
  }

  .site-header__pending {
    color: var(--color-ink-muted);
    cursor: not-allowed;
  }
</style>
