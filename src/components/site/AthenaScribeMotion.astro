---
// AthenaScribe's Selected work media (Oct 12 2026): one hero object, the permission slip, in the
// center of a quiet indigo tint (Micah Hoang: one object per card, no text under it but tags).
// An 8 second loop: the slip is scanned, flagged as a vital document, and an assistant principal
// approves it (no cursor: it is a phone screen), then it turns into Spanish. Plays on its own while on screen; with reduced motion it
// holds the approved frame. The scene is drawn on a fixed 960 x 540 stage scaled to the tile, so
// the px values below are stage units, not page sizes. Colors are the --as-* tokens in tokens.css.
import "@fontsource/lora/600.css";
import "@fontsource/nunito/700.css";
import "@fontsource/nunito/800.css";
---

<div class="asm" data-asm role="img" aria-label="A school permission slip is scanned, flagged as a vital document, approved by an assistant principal, and sent to the family in Spanish.">
  <div class="asm__stage" data-asm-stage>
    <div class="asm__bg"></div>
    <div class="asm__blob asm__blob--a" data-asm="b1"></div>
    <div class="asm__blob asm__blob--b" data-asm="b2"></div>
    <div class="asm__grain"></div>

    <div class="asm__el asm__doc" data-asm="doc">
      <div class="asm__face" data-asm="en">
        <div class="asm__school">WESTVIEW ELEMENTARY</div>
        <p class="asm__title">Field Trip Permission Slip</p>
        <div class="asm__field">Student name:</div>
        <div class="asm__field asm__hl"><b>Date:</b> Friday, Sept 20</div>
        <div class="asm__field"><b>Destination:</b> Science Museum</div>
        <div class="asm__box asm__hl"><i></i>I give permission for my child to attend</div>
        <div class="asm__bars"><u style="width:92%"></u><u style="width:78%"></u><u style="width:85%"></u></div>
      </div>
      <div class="asm__face" data-asm="es" lang="es">
        <div class="asm__school">ESCUELA PRIMARIA WESTVIEW</div>
        <p class="asm__title">Permiso para la excursión</p>
        <div class="asm__field">Nombre del estudiante:</div>
        <div class="asm__field"><b>Fecha:</b> viernes, 20 de sept.</div>
        <div class="asm__field"><b>Destino:</b> Museo de Ciencias</div>
        <div class="asm__box"><i></i>Doy permiso para que mi hijo asista</div>
        <div class="asm__bars"><u style="width:88%"></u><u style="width:80%"></u><u style="width:70%"></u></div>
      </div>
      <div class="asm__wash" data-asm="wash"></div>
      <div class="asm__scan" data-asm="scan"></div>
    </div>

    <div class="asm__el asm__pill" data-asm="pill"></div>

    <div class="asm__el asm__bar" data-asm="bar">
      <span class="asm__av">AP</span>
      <span class="asm__who"><b>Assistant Principal</b><span data-asm="sub">Review English → Spanish</span></span>
      <span class="asm__go" data-asm="go">Approve</span>
    </div>

  </div>
</div>

<style>
  .asm { position: absolute; inset: 0; overflow: hidden; background: var(--as-base); }
  .asm__stage { position: absolute; left: 0; top: 0; width: 960px; height: 540px; transform-origin: 0 0; }
  .asm__bg { position: absolute; inset: 0; background: radial-gradient(90% 120% at 50% 40%, var(--as-base), var(--as-deep)); }
  .asm__blob { position: absolute; border-radius: 50%; filter: blur(64px); will-change: transform; }
  .asm__blob--a { width: 480px; height: 360px; left: 230px; top: 30px; background: var(--as-glow); opacity: .42; }
  .asm__blob--b { width: 360px; height: 260px; left: 500px; top: 270px; background: var(--as-teal); opacity: .035; }
  .asm__grain { position: absolute; inset: 0; opacity: .16; mix-blend-mode: overlay; background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"); }
  .asm__el { position: absolute; will-change: transform, opacity; }

  .asm__doc { left: 320px; top: 50px; width: 320px; height: 400px; background: var(--as-paper); border-radius: 12px; box-shadow: var(--as-shadow-doc); overflow: hidden; font-family: var(--font-athenascribe-ui); color: var(--as-ink); }
  .asm__face { position: absolute; inset: 0; padding: 28px 28px 0; }
  .asm__school { font-size: 13px; font-weight: 800; letter-spacing: .14em; color: var(--as-muted); }
  .asm__title { font-family: var(--font-athenascribe-head); font-weight: 600; font-size: 24px; line-height: 1.15; margin: 8px 0 16px; text-wrap: balance; }
  .asm__field { font-size: 16px; font-weight: 700; padding: 9px 6px; margin-inline: -6px; border-bottom: 1.5px solid var(--as-rule); border-radius: 4px 4px 0 0; }
  .asm__field b, .asm__box b { font-weight: 800; }
  .asm__hl { background: color-mix(in srgb, var(--as-amber) calc(var(--hl, 0) * 32%), transparent); box-shadow: inset 3px 0 0 color-mix(in srgb, var(--as-amber) calc(var(--hl, 0) * 100%), transparent); }
  .asm__box { display: flex; gap: 10px; align-items: center; font-size: 16px; font-weight: 700; margin-top: 16px; padding: 8px 6px; margin-inline: -6px; border-radius: 4px; }
  .asm__box i { width: 18px; height: 18px; border: 2px solid var(--as-indigo); border-radius: 4px; flex: none; }
  .asm__bars { display: grid; gap: 9px; margin-top: 16px; }
  .asm__bars u { display: block; height: 8px; border-radius: 4px; background: var(--as-rule); }
  .asm__scan { position: absolute; left: 0; right: 0; height: 3px; background: var(--as-indigo); box-shadow: 0 0 18px 6px color-mix(in srgb, var(--as-indigo) 32%, transparent); opacity: 0; }
  .asm__wash { position: absolute; left: 0; right: 0; top: 0; height: 0; background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--as-indigo) 8%, transparent)); }

  .asm__pill { right: 300px; top: 28px; display: inline-flex; align-items: center; gap: 9px; height: 44px; padding: 0 18px 0 6px; border-radius: 999px; font-family: var(--font-athenascribe-ui); font-weight: 800; font-size: 16px; white-space: nowrap; box-shadow: var(--as-shadow-pill); transform-origin: 100% 50%; }
  .asm__pill[data-state="scanning"] { background: var(--as-paper); color: var(--as-indigo); }
  .asm__pill[data-state="vital"] { background: var(--as-amber); color: var(--as-amber-ink); padding-left: 14px; }
  .asm__pill[data-state="sent"] { background: var(--as-green); color: var(--as-paper); padding-left: 14px; }
  .asm__pill :global(img) { width: 34px; height: 34px; border-radius: 50%; flex: none; }
  .asm__pill :global(svg) { width: 20px; height: 20px; flex: none; }
  .asm__pill :global(.asm__pct) { font-variant-numeric: tabular-nums; opacity: .7; }

  .asm__bar { left: 270px; top: 416px; width: 420px; height: 80px; background: var(--as-paper); border-radius: 16px; box-shadow: var(--as-shadow-doc); display: flex; align-items: center; gap: 14px; padding: 0 16px; font-family: var(--font-athenascribe-ui); color: var(--as-ink); opacity: 0; }
  .asm__av { width: 44px; height: 44px; border-radius: 50%; background: var(--as-soft); color: var(--as-indigo); font-weight: 800; font-size: 16px; display: grid; place-items: center; flex: none; }
  .asm__who { flex: 1; min-width: 0; display: grid; gap: 2px; }
  .asm__who b { font-size: 17px; font-weight: 800; }
  .asm__who span { font-size: 14px; font-weight: 700; color: var(--as-muted); }
  .asm__go { height: 48px; min-width: 140px; border-radius: 12px; background: var(--as-indigo); color: var(--as-paper); font-size: 17px; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; gap: 8px; }
  .asm__go[data-ok] { background: var(--as-green); }
  .asm__go :global(svg) { width: 20px; height: 20px; }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-asm]");
  if (root) {
    const DUR = 8, STILL = 6.0;
    const stage = root.querySelector<HTMLElement>("[data-asm-stage]")!;
    const q = (k: string) => root.querySelector<HTMLElement>(`[data-asm="${k}"]`)!;
    const el = { b1: q("b1"), b2: q("b2"), doc: q("doc"), en: q("en"), es: q("es"), wash: q("wash"), scan: q("scan"), pill: q("pill"), bar: q("bar"), sub: q("sub"), go: q("go") };
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

    // Closed form spring: settles with a small overshoot, like a real object.
    const spring = (s: number, w = 11, z = 0.62) => {
      if (s <= 0) return 0;
      if (z >= 1) return 1 - (1 + w * s) * Math.exp(-w * s);
      const wd = w * Math.sqrt(1 - z * z);
      return 1 - Math.exp(-z * w * s) * (Math.cos(wd * s) + ((z * w) / wd) * Math.sin(wd * s));
    };
    const cl = (v: number) => Math.max(0, Math.min(1, v));
    const sm = (v: number) => { v = cl(v); return v * v * (3 - 2 * v); };
    const fin = (t: number, a: number, d = 0.3) => sm((t - a) / d);
    const fout = (t: number, a: number, d = 0.35) => 1 - sm((t - a) / d);
    const set = (n: Element, { x = 0, y = 0, s = 1, o = 1 }) => {
      const h = n as HTMLElement;
      h.style.opacity = o.toFixed(3);
      h.style.transform = `translate(${x.toFixed(2)}px,${y.toFixed(2)}px) scale(${s.toFixed(4)})`;
    };

    const warn = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5l9 15.5H3z"/><path d="M12 10v4M12 16.8v.1"/></svg>';
    const check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
    const owl = '<img src="/media/athenascribe-owl.webp" alt="" width="34" height="34">';

    let pillState = "", okState: boolean | null = null;

    const render = (t: number) => {
      const loop = (2 * Math.PI * t) / DUR;
      set(el.b1, { x: Math.sin(loop) * 26, y: Math.cos(loop) * 14 });
      set(el.b2, { x: Math.cos(loop) * -22, y: Math.sin(loop) * 16 });
      set(el.doc, { y: Math.sin(loop) * 3 });

      // 1 Scan
      const sp = sm((t - 0.4) / 2.2), sv = fin(t, 0.35, 0.15) * fout(t, 2.55, 0.25);
      el.scan.style.top = `${8 + sp * 386}px`; el.scan.style.opacity = String(sv);
      el.wash.style.height = `${sp * 394}px`; el.wash.style.opacity = String(sv);

      const st = t < 2.7 ? "scanning" : t < 5.45 ? "vital" : "sent";
      const st0 = st === "scanning" ? 0.3 : st === "vital" ? 2.7 : 5.45;
      if (st !== pillState) {
        pillState = st; el.pill.dataset.state = st;
        el.pill.innerHTML = st === "scanning" ? `${owl}<span>Scanning</span><span class="asm__pct">0%</span>`
          : st === "vital" ? `${warn}<span>Vital document · needs review</span>`
          : `${check}<span>Approved · sent in Spanish</span>`;
      }
      if (st === "scanning") el.pill.querySelector(".asm__pct")!.textContent = `${Math.round(sp * 100)}%`;
      set(el.pill, { s: 0.86 + 0.14 * spring(t - st0, 15, 0.5), o: fin(t, 0.3, 0.2) * fout(t, 6.9, 0.35) });

      // 2 Vital lines light up
      el.en.style.setProperty("--hl", (fin(t, 2.75, 0.35) * fout(t, 5.2, 0.4)).toFixed(3));

      // 3 A person approves
      const be = spring(t - 3.3, 10, 0.75), bo = fout(t, 6.8, 0.35);
      set(el.bar, { y: (1 - be) * 44 + (1 - bo) * 18, o: fin(t, 3.3, 0.25) * bo });
      const ok = t >= 5.15;
      if (ok !== okState) {
        okState = ok;
        el.go.toggleAttribute("data-ok", ok);
        el.go.innerHTML = ok ? `${check}Approved` : "Approve";
        el.sub.textContent = ok ? "Approved just now" : "Review English → Spanish";
      }
      const press = t > 5.0 && t < 5.15 ? 0.95 : 1, pop = ok ? 0.96 + 0.04 * spring(t - 5.15, 18, 0.4) : 1;
      el.go.style.transform = `scale(${press * pop})`;
      const ring = ok ? fout(t, 5.15, 0.6) : 0;
      el.go.style.boxShadow = ring > 0 ? `0 0 0 ${(1 - ring) * 14}px color-mix(in srgb, var(--as-green) ${Math.round(ring * 45)}%, transparent)` : "none";

      // The slip turns into Spanish, then back for the next loop
      el.en.style.opacity = Math.max(fout(t, 5.45, 0.2), fin(t, 7.25, 0.2)).toFixed(3);
      el.es.style.opacity = (fin(t, 5.62, 0.22) * fout(t, 7.0, 0.2)).toFixed(3);
    };

    const fit = () => { stage.style.transform = `scale(${root.clientWidth / 960})`; };
    new ResizeObserver(fit).observe(root);
    fit();

    let t = 0, playing = false, last = 0, raf = 0;
    const tick = (now: number) => {
      t = (t + Math.min(0.05, (now - last) / 1000)) % DUR; last = now;
      render(t);
      if (playing) raf = requestAnimationFrame(tick);
    };
    const play = () => { if (playing || reduce.matches) return; playing = true; last = performance.now(); raf = requestAnimationFrame(tick); };
    const pause = () => { playing = false; cancelAnimationFrame(raf); };

    // Plays only while the tile is on screen.
    new IntersectionObserver((entries) => entries.forEach((e) => (e.isIntersecting ? play() : pause()))).observe(root);
    reduce.addEventListener("change", () => { if (reduce.matches) { pause(); render(STILL); } });

    render(reduce.matches ? STILL : 0);
    document.fonts?.ready.then(() => { render(reduce.matches ? STILL : t); });
  }
</script>
