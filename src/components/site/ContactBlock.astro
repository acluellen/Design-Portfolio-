---
// The closing contact block on the home and About pages (October 14, after Micah Hoang): a solid
// navy band that ends the page. "Get in touch", then email, LinkedIn, and Resume as big stacked
// capitals with small labels, then a bar with the open to work line and the copyright. LinkedIn waits for site.linkedin and Resume for public/resume.pdf; until then
// they show as plain text.
import fs from "node:fs";
import path from "node:path";
import { mailto, site } from "../../site.config";

const hasResume = fs.existsSync(path.join(process.cwd(), "public", site.resumePath));
const year = new Date().getFullYear();
const [emailName, emailDomain] = site.email.split("@");
---

<!-- Scroll to top, on the paper above the navy block, on the left like the rest of the page. -->
<div class="container to-top">
  <a class="to-top__link" href="#top">Scroll to top <span aria-hidden="true">↑</span></a>
</div>

<!-- Big stacked capitals, each with a small label at its top right (after Micah Hoang). The email is
     split so the name reads big and the domain small. Unlinked items stay muted until they go live. -->
<footer id="contact" class="contact surface-always-dark" aria-labelledby="contact-heading">
  <div class="container contact__inner">
    <h2 id="contact-heading" class="contact__title">Get in touch</h2>
    <ul class="contact__links">
      <li>
        <a href={mailto} aria-label={`Email ${site.email}`}>
          <span class="contact__word">{emailName}</span><span class="contact__tag" aria-hidden="true">@{emailDomain}</span>
        </a>
      </li>
      <li>
        {
          site.linkedin ? (
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
              <span class="contact__word">LinkedIn</span><span class="contact__tag" aria-hidden="true">Profile</span>
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          ) : (
            <span class="contact__off"><span class="contact__word">LinkedIn</span><span class="contact__tag">Profile</span></span>
          )
        }
      </li>
      <li>
        {
          hasResume ? (
            <a href={site.resumePath}>
              <span class="contact__word">Resume</span><span class="contact__tag" aria-hidden="true">PDF</span>
            </a>
          ) : (
            <span class="contact__off"><span class="contact__word">Resume</span><span class="contact__tag">PDF</span></span>
          )
        }
      </li>
    </ul>
    <div class="contact__bar">
      <p>Open to associate product design roles</p>
      <p>© {year} <span translate="no">{site.name}</span></p>
    </div>
  </div>
</footer>

<style>
  .to-top {
    display: flex;
    justify-content: flex-start;
    padding-block-end: var(--space-5);
  }

  .to-top__link {
    display: inline-flex;
    align-items: center;
    gap: 0.6ch;
    min-block-size: var(--control-height);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
  }

  .to-top__link:hover {
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .contact {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .contact__inner {
    display: grid;
    padding-block: var(--space-6) var(--space-5);
  }

  .contact__title {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  /* Big capitals, regular weight, stacked tight. */
  .contact__links {
    display: grid;
    justify-items: start;
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-display);
    font-weight: var(--weight-regular);
    font-size: var(--size-contact-link);
    line-height: var(--leading-contact-link);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
  }

  .contact__links a,
  .contact__off {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0 var(--space-2);
    color: var(--color-ink);
    text-decoration: none;
  }

  .contact__links a:hover .contact__word {
    text-decoration: underline;
    text-decoration-thickness: var(--rule-thin);
    text-underline-offset: 0.1em;
  }

  /* Not live yet (no LinkedIn address or resume file): muted so it doesn't read as a broken link. */
  .contact__off {
    color: var(--color-ink-muted);
  }

  /* The small label at the top right of each big word. */
  .contact__tag {
    padding-block-start: 0.35em;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-label);
    line-height: 1;
    color: var(--color-ink-muted);
  }

  /* Bottom bar: open to work on the left, copyright on the right, under a thin line. */
  .contact__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    margin-block-start: var(--space-10);
    padding-block-start: var(--space-4);
    border-block-start: var(--rule-thin) solid var(--color-rule);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
</style>
