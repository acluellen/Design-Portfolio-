---
// The KRON4 loop, in color: muted, looping, and playing on its own while on screen.
// Reduced motion (or no JavaScript): the still image only, and the clip never downloads.
// `opens`: the frame starts as a small crop and opens to full size as it scrolls into view
// (modeled on Zeel Shah's portfolio). Pure CSS, only where scroll timelines exist, never with reduced motion.
import Photo from "./Photo.astro";

interface Props {
  opens?: boolean;
}

const { opens = false } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class:list={["clip", { "clip--opens": opens }]} data-clip>
  <div class="clip__frame">
    <Photo
      name="kron4-still-color"
      widths={[540, 800, 1080, 1440]}
      sizes="(min-width: 76rem) 72rem, 92vw"
      ratio="360 / 179"
      class="clip__still"
    />
    <video
      class="clip__video"
      data-clip-video
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"
      data-sources={JSON.stringify([
        { src: `${base}/video/aaron-kron4-loop-color.mp4`, type: "video/mp4" },
        { src: `${base}/video/aaron-kron4-loop-color.webm`, type: "video/webm" },
      ])}
    ></video>
  </div>
  <!-- The loop runs past five seconds, so it needs a way to stop it (WCAG 2.2.2). -->
  <!-- Optional caption from the page, with the Pause control at the end of the same row. -->
  <div class="clip__bar">
    <slot />
    <button class="clip__toggle" type="button" data-clip-toggle hidden>Pause clip</button>
  </div>
</div>

<script>
  const motion = window.matchMedia("(prefers-reduced-motion: no-preference)");

  document.querySelectorAll<HTMLElement>("[data-clip]").forEach((clip) => {
    const video = clip.querySelector<HTMLVideoElement>("[data-clip-video]")!;
    const toggle = clip.querySelector<HTMLButtonElement>("[data-clip-toggle]")!;
    let inView = false;
    let pausedByVisitor = false;
    let loaded = false;

    // Sources are added only when motion is allowed and the clip is near the screen.
    const load = () => {
      if (loaded) return;
      loaded = true;
      const sources: { src: string; type: string }[] = JSON.parse(video.dataset.sources ?? "[]");
      sources.forEach(({ src, type }) => {
        const source = document.createElement("source");
        source.src = src;
        source.type = type;
        video.append(source);
      });
      video.load();
    };

    const play = () => {
      if (!motion.matches || pausedByVisitor || !inView) return;
      load();
      video.play().catch(() => {});
    };

    video.addEventListener("playing", () => clip.classList.add("is-playing"));

    toggle.addEventListener("click", () => {
      pausedByVisitor = !video.paused;
      if (pausedByVisitor) video.pause();
      else play();
      toggle.textContent = pausedByVisitor ? "Play clip" : "Pause clip";
    });

    const setUp = () => {
      toggle.hidden = !motion.matches;
      if (motion.matches) play();
      else {
        video.pause();
        clip.classList.remove("is-playing");
      }
    };

    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      if (inView) play();
      else video.pause();
    }, { rootMargin: "200px 0px" }).observe(clip);

    motion.addEventListener("change", setUp);
    setUp();
  });
</script>

<style>
  .clip {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
  }

  .clip__frame {
    position: relative;
    inline-size: 100%;
    aspect-ratio: 360 / 179; /* the clip file: 1440 by 716 */
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--color-panel);
  }

  .clip__frame :global(picture),
  .clip__frame :global(img),
  .clip__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .clip__video {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .clip.is-playing .clip__video {
    opacity: 1;
  }

  /* Opens on scroll: the crop widens while the footage settles from a slight zoom, so it feels
     like stepping back from a close up. Browsers without scroll timelines show it fully open. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .clip--opens .clip__frame {
        animation: clip-open linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 45%;
      }

      .clip--opens .clip__frame > :global(*) {
        animation: clip-settle linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 45%;
      }
    }
  }

  @keyframes clip-open {
    from {
      clip-path: inset(var(--clip-closed));
    }
    to {
      clip-path: inset(0);
    }
  }

  @keyframes clip-settle {
    from {
      transform: scale(1.18);
    }
    to {
      transform: none;
    }
  }

  /* One mono row under the clip: the page's caption, then Pause. */
  .clip__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-5);
    inline-size: 100%;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .clip__toggle {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-height);
    margin-inline-start: auto;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--color-ink-muted);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
    cursor: pointer;
  }

  .clip__toggle:hover {
    color: var(--color-accent);
  }

  .clip__toggle[hidden] {
    display: none;
  }
</style>
