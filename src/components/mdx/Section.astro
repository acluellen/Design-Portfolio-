---
// A part of the story: a chapter that opens with a thin rule (October 9 direction, no white panels).
// `panel` is kept for older content and now only adds a stronger rule. Text keeps the reading measure.
interface Props {
  tone?: "plain" | "panel";
}

const { tone = "plain" } = Astro.props;
---

<section class:list={["section", "is-wide", `section--${tone}`]}>
  <div class="section__inner flow">
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block-start: var(--space-6);
    border-block-start: var(--rule-thin) solid var(--color-rule);
  }

  .section--panel {
    border-block-start-color: var(--color-rule-strong);
  }

  .section__inner > :global(:first-child) {
    margin-block-start: 0;
  }
</style>
