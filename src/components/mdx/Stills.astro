---
// Annotated stills of one flow. Each still sits in a tinted stage with a numbered title in the top
// left corner and one line under it, taken from the prototype's own words. The stage color says
// what kind of picture it is: solution (cool tint), problem (warm tint), or exploration (gray).
// Everything on screen that is not the feature is shown as gray bars, cut into the still itself.
import type { ImageMetadata } from "astro";
import Shot from "./Shot.astro";

type Tone = "solution" | "problem" | "exploration";

interface Item {
  /** The number in the stage title, such as "01". */
  n: string;
  /** The short title in the stage, such as "Attachment notice". */
  title: string;
  src: ImageMetadata;
  alt: string;
  /** One line under the stage. */
  caption: string;
  /** Wider stage that spans both columns on wide screens. */
  wide?: boolean;
}

interface Props {
  items: Item[];
  tone?: Tone;
}

const { items, tone = "solution" } = Astro.props;
---

<div class="stills is-wide is-full">
  {
    items.map((item) => (
      <figure class:list={["stills__item", { "stills__item--wide": item.wide }]}>
        <div class={`stills__stage stills__stage--${tone}`} style={`--ar: ${item.src.width} / ${item.src.height}`}>
          <p class="stills__title">
            <span>{item.n}</span> / {item.title}
          </p>
          <div class="stills__body">
            <Shot src={item.src} alt={item.alt} fit="contain" sizes="(min-width: 72rem) 36rem, 92vw" />
          </div>
        </div>
        <figcaption class="stills__caption">{item.caption}</figcaption>
      </figure>
    ))
  }
</div>

<style>
  .stills {
    display: grid;
    gap: var(--space-6) var(--space-5);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 48rem) {
    .stills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stills__item--wide {
      grid-column: 1 / -1;
    }
  }

  .stills__item {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--space-3);
    margin: 0;
  }

  .stills__stage {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5) var(--space-5);
    border: var(--rule-thin) solid var(--color-rule);
    border-radius: var(--radius-media);
  }

  .stills__stage--solution {
    background: var(--color-stage-solution);
  }

  .stills__stage--problem {
    background: var(--color-stage-problem);
  }

  .stills__stage--exploration {
    background: var(--color-placeholder);
  }

  .stills__title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-label-ink);
  }

  /* The body takes the still's own shape, so the picture fills the stage's width and stays sharp. */
  .stills__body {
    position: relative;
    aspect-ratio: var(--ar);
  }

  .stills__body :global(.shot) {
    position: absolute;
    inset: 0;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    background: transparent;
    border: 0;
    overflow: visible;
  }

  .stills__body :global(picture) {
    min-block-size: 0;
  }

  /* The Enlarge pill rides in the title row, at the stage's top right, so it never covers the still. */
  .stills__body :global(.shot__btn) {
    inset: auto 0 calc(100% + var(--space-2)) auto;
  }

  .stills__caption {
    max-inline-size: var(--measure-reading);
    font-size: var(--step-0);
    color: var(--color-ink);
  }
</style>
