---
// A short silent screen recording of school software, shown as a compact tile in a row of three
// (see DemoRow). A demonstration (not research
// evidence): the poster first, then muted inline playback. All the clips loop together, without
// stopping, while on screen; leaving the screen pauses a clip. Tap a clip (or press Enter or Space on it) to pause or play it.
// With reduced motion nothing plays by itself: the poster shows and the button starts it.
// The files in public/video/demos are sanitized copies: names, schools, emails, photos, and IDs are
// painted out in the video itself (not by CSS). The originals are kept outside the public folder.
interface Props {
  /** Path in /public to the H.264 MP4, such as "/video/demos/aeries.mp4". */
  src: string;
  /** Path in /public to the poster image: the first thing a visitor sees. */
  poster: string;
  /** The recording's own size in pixels: the clip keeps this shape inside its tile. */
  width: number;
  height: number;
  /** What the example is for, in small mono capitals over the video. Optional. */
  label?: string;
  /** "laptop" sets the clip in a drawn laptop, at the screen's own 16:10 shape. */
  device?: "laptop" | "wide";
  /** The visible action, directly under the video. */
  caption: string;
  /** An optional small link at the end of the caption, such as the full segment on YouTube. */
  link?: { href: string; text: string };
  /** What a screen reader hears for the video. */
  description: string;
}

const { src, poster, width, height, label, device, caption, link, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<figure class:list={["demo", { "demo--laptop": device === "laptop", "demo--wide": device === "wide" }]} style={device === "wide" ? `--demo-ratio: ${width} / ${height}` : undefined} data-demo>
  {label && <p class="demo__label">{label}</p>}
  <div class="demo__device">
  <div class="demo__frame">
    <video
      class="demo__video"
      src={`${base}${src}`}
      width={width}
      height={height}
      muted
      loop
      playsinline
      preload="metadata"
      aria-label={description}
      disablepictureinpicture
    >
    </video>
    <img class="demo__poster" src={`${base}${poster}`} alt="" width={width} height={height} loading="lazy" decoding="async" />
    <button type="button" class="demo__tap" data-demo-btn aria-label="Play video">
      <svg class="demo__i" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
    </button>
  </div>
  </div>
  <figcaption class="demo__caption">
    {caption}
    {link && (
      <>
        {" "}
        <a href={link.href} target="_blank" rel="noopener">
          {link.text}<span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      </>
    )}
  </figcaption>
</figure>

<style>
  /* A compact tile in a row of three: every tile is the same width and shape, and the recording sits
     inside it at its own proportions (never stretched or cropped), centered on the tile's background. */
  .demo {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-inline-size: 0;
    margin: 0;
  }

  .demo__label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-label-ink);
  }

  .demo__frame {
    position: relative;
    aspect-ratio: var(--ratio-demo);
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--color-placeholder);
    border: var(--rule-thin) solid var(--color-rule-strong);
    border-radius: var(--radius-media);
  }

  .demo__video,
  .demo__poster {
    grid-area: 1 / 1;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  /* The poster covers the video until the clip first plays, and is a plain image so every browser
     scales it the same way. */
  .demo__poster {
    pointer-events: none;
  }

  .demo:is([data-state="playing"], [data-state="paused"], [data-state="ended"]) .demo__poster {
    visibility: hidden;
  }

  /* The whole clip is one button: tap or press Enter or Space to pause or play. A play mark shows
     only while it is paused, so a playing clip stays clean. */
  .demo__tap {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-always-dark-ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .demo__tap:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: calc(var(--focus-offset) * -1);
  }

  .demo__i {
    display: none;
    box-sizing: content-box;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    padding: var(--space-3);
    border-radius: 50%;
    background: var(--color-overlay);
  }

  .demo[data-state="paused"] .demo__i,
  .demo[data-state="idle"] .demo__i {
    display: block;
  }

  .demo__caption {
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: var(--color-ink-muted);
  }

  /* One wide clip at the full column width, in its own shape: such as a television segment. */
  .demo--wide .demo__frame {
    aspect-ratio: var(--demo-ratio);
    border: 0;
    background: var(--color-always-dark);
  }

  .demo--wide :is(.demo__video, .demo__poster) {
    object-fit: cover;
  }

  /* A drawn laptop for one large recording: a dark lid around a 16:10 screen, and a base that is a
     little wider than the lid. Colors are the always dark navy tokens, so it reads in both themes. */
  .demo__device {
    display: grid;
  }

  .demo--laptop .demo__device {
    position: relative;
    padding: clamp(0.375rem, 1.6%, 0.875rem);
    margin-block-end: var(--space-4);
    background: var(--color-always-dark);
    border-radius: var(--radius-media) var(--radius-media) 0 0;
  }

  .demo--laptop .demo__device::after {
    content: "";
    position: absolute;
    inset-block-start: 100%;
    inset-inline: -4%;
    block-size: var(--space-3);
    background: var(--color-always-dark-rule-strong);
    border-radius: 0 0 var(--radius-media) var(--radius-media);
  }

  .demo--laptop .demo__device::before {
    content: "";
    position: absolute;
    z-index: 1;
    inset-block-start: 100%;
    inset-inline-start: 50%;
    inline-size: 16%;
    block-size: var(--space-1);
    translate: -50% 0;
    background: var(--color-always-dark-raised);
    border-radius: 0 0 var(--radius-media) var(--radius-media);
  }

  .demo--laptop .demo__frame {
    aspect-ratio: var(--ratio-dashboard);
    border: 0;
    border-radius: calc(var(--radius-media) / 2);
    background: var(--color-always-dark);
  }

  .demo--laptop :is(.demo__video, .demo__poster) {
    object-fit: cover;
  }
</style>


<script>
  // One controller for every demo on the page. All of them loop, together and without stopping,
  // while they are on screen; a clip pauses when it leaves the screen and picks up again when it
  // returns. A tap on a clip pauses or plays that clip. With reduced motion nothing starts by itself.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  type Demo = { root: HTMLElement; v: HTMLVideoElement; btn: HTMLButtonElement; ratio: number; userPaused: boolean };
  const demos: Demo[] = [...document.querySelectorAll<HTMLElement>("[data-demo]")].map((root) => ({
    root,
    v: root.querySelector("video")!,
    btn: root.querySelector<HTMLButtonElement>("[data-demo-btn]")!,
    ratio: 0,
    userPaused: false,
  }));

  const playing = (d: Demo) => !d.v.paused;
  const label: Record<string, string> = { playing: "Pause video", paused: "Play video", idle: "Play video" };

  function paint(d: Demo) {
    const s = playing(d) ? "playing" : d.v.currentTime > 0 ? "paused" : "idle";
    d.root.dataset.state = s;
    d.btn.setAttribute("aria-label", label[s]);
  }

  function start(d: Demo) {
    d.v.play().then(() => paint(d)).catch(() => paint(d));
    paint(d);
  }

  // Start every clip that is on screen and was not paused by the visitor.
  function resume() {
    if (reduce.matches) return;
    demos.forEach((d) => { if (d.ratio >= 0.5 && !d.userPaused && !playing(d)) start(d); });
  }

  demos.forEach((d) => {
    paint(d);
    d.v.loop = true;
    d.v.addEventListener("play", () => paint(d));
    d.v.addEventListener("pause", () => paint(d));
    d.btn.addEventListener("click", () => {
      if (playing(d)) { d.userPaused = true; d.v.pause(); paint(d); return; }
      d.userPaused = false; start(d);
    });
    new IntersectionObserver(([e]) => {
      d.ratio = e.intersectionRatio;
      if (d.ratio < 0.25 && playing(d)) { d.v.pause(); paint(d); }
      else resume();
    }, { threshold: [0, 0.25, 0.5, 0.75, 1] }).observe(d.root);
  });

  reduce.addEventListener("change", () => { if (reduce.matches) demos.forEach((d) => { if (playing(d)) { d.v.pause(); paint(d); } }); else resume(); });
</script>
