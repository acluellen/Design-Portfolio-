---
// Two blocks side by side from 48rem, narrower one first: for a quote next to what it led to.
// Stacks on narrow screens.
---

<div class="split is-wide">
  <slot />
</div>

<style>
  .split {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  @media (min-width: 48rem) {
    .split {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-8);
    }
  }

  .split > :global(*) {
    min-width: 0;
    margin: 0;
  }
</style>
