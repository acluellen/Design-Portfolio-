---
// A row of phone screens in order, each with a small label: a flow, read left to right.
// Four across on wide screens, two across on phones.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Screen {
  src: ImageMetadata;
  alt: string;
  label: string;
}

interface Props {
  screens: Screen[];
  caption?: string;
}

const { screens, caption } = Astro.props;

const widths = (img: ImageMetadata) =>
  [...new Set([240, 360, 480, img.width])].filter((w) => w <= img.width).sort((a, b) => a - b);
const sizes = "(min-width: 48rem) 10rem, 45vw";
---

<figure class="screens">
  <ol class="screens__row">
    {screens.map((screen) => (
      <li class="screens__item">
        <p class="label">{screen.label}</p>
        <Picture src={screen.src} alt={screen.alt} widths={widths(screen.src)} sizes={sizes} formats={["avif", "webp"]} fallbackFormat="jpg" quality={75} loading="lazy" decoding="async" />
      </li>
    ))}
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .screens {
    display: grid;
    gap: var(--space-3);
  }

  .screens__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    align-items: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .screens__row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .screens__item {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
    margin: 0;
  }

  .screens__item :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: var(--rule-thin) solid var(--color-rule);
    border-radius: var(--radius-media);
  }

  .screens figcaption {
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }
</style>
