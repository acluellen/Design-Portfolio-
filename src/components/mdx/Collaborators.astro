---
// A compact block for the named collaborators, then the tools in one quiet wrapping line under it.
// Both lists come from the case study's front matter (`team` and `tools`), so there is one source.
interface Props {
  people: { name: string; role: string }[];
  tools?: string[];
}

const { people, tools = [] } = Astro.props;
---

<div class="collab">
  <p class="collab__label">Collaborators</p>
  <ul class="collab__list">
    {people.map((p) => <li><span class="collab__name">{p.name}</span>, <span class="collab__role">{p.role}</span></li>)}
  </ul>
  {
    tools.length > 0 && (
      <p class="collab__tools">
        <span class="collab__label">Tools</span> {tools.join(", ")}
      </p>
    )
  }
</div>

<style>
  .collab {
    display: grid;
    gap: var(--space-2);
  }

  .collab__label {
    margin: 0;
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }

  .collab__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }

  .collab__name {
    font-weight: var(--weight-medium);
    color: var(--color-ink);
  }

  .collab__role {
    color: var(--color-ink-muted);
  }

  .collab__tools {
    margin: var(--space-2) 0 0;
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }

  .collab__tools .collab__label {
    margin-inline-end: var(--space-2);
  }
</style>
