---
import { checkSource } from "./sources";

interface Props {
  /** Who said it, by role only. Required. */
  source: string;
}

const { source } = Astro.props;
const state = checkSource("Quote", source);
---

<figure class="quote">
  <blockquote>
    <slot />
  </blockquote>
  <figcaption class:list={["quote__source", { "is-todo": state === "todo" }]}>
    {state === "todo" ? "Source needed" : state === "untraceable" ? "Source not traceable." : source}
  </figcaption>
</figure>

<style>
  .quote {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-block: var(--rule-thin) solid var(--color-rule);
  }

  .quote blockquote {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
  }

  .quote blockquote :global(p) {
    text-wrap: balance;
  }

  .quote__source {
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }

  .is-todo {
    color: var(--color-accent);
  }
</style>
