---
// An actual image with an Enlarge button. The button opens the image in a dialog: Escape or the
// Close button dismisses it, and focus goes back to the button that opened it. "Enlarge" means a
// larger image, not an interactive prototype. `fit="contain"` keeps a tall screen whole inside a
// wide frame; the default fills the frame.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  fit?: "cover" | "contain";
  sizes?: string;
}

const { src, alt, fit = "cover", sizes = "(min-width: 72rem) 44rem, 92vw" } = Astro.props;
const widths = [...new Set([480, 720, 960, 1280, src.width])].filter((w) => w <= src.width).sort((a, b) => a - b);
---

<div class:list={["shot", `shot--${fit}`]}>
  <Picture src={src} alt={alt} widths={widths} sizes={sizes} formats={["avif", "webp"]} fallbackFormat="jpg" quality={80} loading="lazy" decoding="async" />
  <button type="button" class="shot__btn" data-enlarge data-full={src.src} data-alt={alt}>
    Enlarge<span class="visually-hidden"> image: {alt}</span>
  </button>
</div>

<style>
  .shot {
    position: relative;
    display: grid;
    inline-size: 100%;
    block-size: 100%;
    place-items: center;
    background: var(--color-placeholder);
    border: var(--rule-thin) solid var(--color-rule);
    border-radius: var(--radius-media);
    overflow: hidden;
  }

  .shot :global(picture) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .shot :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .shot--contain :global(img) {
    object-fit: contain;
  }

  .shot__btn {
    position: absolute;
    inset: auto var(--space-3) var(--space-3) auto;
    padding: var(--space-1) var(--space-3);
    border: var(--rule-thin) solid var(--color-rule-strong);
    border-radius: var(--radius-tag);
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    cursor: zoom-in;
  }

  .shot__btn:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }
</style>

<style is:global>
  .lightbox {
    margin: auto; /* the site reset removes the dialog's own centering */
    inline-size: min(96vw, 90rem);
    max-inline-size: none;
    max-block-size: 94vh;
    padding: var(--space-3);
    border: var(--rule-thin) solid var(--color-rule-strong);
    border-radius: var(--radius-media);
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  .lightbox__img {
    display: block;
    inline-size: 100%;
    max-block-size: calc(94vh - var(--space-9));
    object-fit: contain;
  }

  .lightbox__close {
    display: block;
    margin: 0 0 var(--space-3) auto;
    padding: var(--space-1) var(--space-4);
    border: var(--rule-thin) solid var(--color-rule-strong);
    border-radius: var(--radius-tag);
    background: transparent;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    cursor: pointer;
  }

  .lightbox__close:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }
</style>

<script>
  // One dialog for the whole page, made on the first click.
  let dialog: HTMLDialogElement | null = null;
  let opener: HTMLElement | null = null;

  function open(btn: HTMLElement) {
    if (!dialog) {
      dialog = document.createElement("dialog");
      dialog.className = "lightbox";
      dialog.setAttribute("aria-label", "Enlarged image");
      dialog.innerHTML = '<button type="button" class="lightbox__close">Close</button><img class="lightbox__img" alt="" />';
      document.body.append(dialog);
      dialog.querySelector(".lightbox__close")!.addEventListener("click", () => dialog!.close());
      dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog!.close(); });
      dialog.addEventListener("close", () => opener?.focus());
    }
    const img = dialog.querySelector<HTMLImageElement>(".lightbox__img")!;
    img.src = btn.dataset.full ?? "";
    img.alt = btn.dataset.alt ?? "";
    opener = btn;
    dialog.showModal();
  }

  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-enlarge]");
    if (btn) open(btn);
  });
</script>
