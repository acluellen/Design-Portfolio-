---
// One static branching diagram: a start, a decision, and two paths out of it. No motion. Wide
// screens: the start and the decision on the left, the two paths on the right, joined by a bracket.
// Phones: stacked, with the paths under the decision. Two branches only. A step or a path can take
// `state: "focus"` for the accent outline, the same as Flow.
interface Props {
  /** The step before the decision, such as the translated document. */
  start: string;
  /** The decision itself. */
  decision: string;
  branches: { label: string; outcome: string; state?: "focus" }[];
  /** Short line under the diagram: what it shows. */
  caption?: string;
}

const { start, decision, branches, caption } = Astro.props;
---

<figure class="br is-wide is-full">
  <div class="br__grid">
    <ol class="br__trunk">
      <li class="br__node">{start}</li>
      <li class="br__node br__node--focus">{decision}</li>
    </ol>
    <ul class="br__forks">
      {
        branches.map((b) => (
          <li class="br__fork">
            <span class="br__label">{b.label}</span>
            <span class:list={["br__node", b.state && `br__node--${b.state}`]}>{b.outcome}</span>
          </li>
        ))
      }
    </ul>
  </div>
  {caption && <figcaption class="br__caption">{caption}</figcaption>}
</figure>

<style>
  .br {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }

  .br__grid {
    display: grid;
    gap: var(--space-6);
  }

  .br__trunk,
  .br__forks {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .br__trunk {
    gap: var(--space-6);
  }

  .br__node {
    position: relative;
    display: block;
    padding: var(--space-4);
    font-weight: var(--weight-medium);
    color: var(--color-heading);
    border: var(--rule-thin) solid var(--color-rule-strong);
    border-radius: var(--radius-section);
  }

  .br__node--focus {
    border-color: var(--color-accent);
    border-width: var(--rule-thick);
  }

  .br__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-label-ink);
  }

  .br__fork {
    position: relative;
    display: grid;
    gap: var(--space-2);
    align-content: center;
  }

  /* Phones: arrows run down. The paths hang under the decision on a thin rule. */
  .br__trunk > .br__node::after {
    content: "↓";
    position: absolute;
    inset: 100% 0 auto;
    display: grid;
    place-items: center;
    block-size: var(--space-6);
    font-family: var(--font-mono);
    font-weight: var(--weight-regular);
    color: var(--color-ink-muted);
  }

  .br__forks {
    gap: var(--space-5);
    padding-inline-start: var(--space-5);
    border-inline-start: var(--rule-thin) solid var(--color-rule-strong);
  }

  @media (min-width: 48rem) {
    .br__grid {
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--space-7);
      align-items: center;
    }

    .br__trunk {
      grid-auto-flow: column;
      gap: var(--space-7);
    }

    .br__trunk > .br__node::after {
      content: "→";
      inset: 0 auto 0 100%;
      inline-size: var(--space-7);
      block-size: auto;
    }

    /* The bracket: one vertical line, and a short tick into each path. Two equal rows. */
    .br__forks {
      position: relative;
      grid-auto-rows: 1fr;
      gap: var(--space-4);
      padding-inline-start: var(--space-7);
      border-inline-start: 0;
    }

    .br__forks::before {
      content: "";
      position: absolute;
      inset-block: 25%;
      inset-inline-start: 0;
      border-inline-start: var(--rule-thin) solid var(--color-rule-strong);
    }

    .br__fork::before {
      content: "";
      position: absolute;
      inset-block-start: 50%;
      inset-inline-start: calc(var(--space-7) * -1);
      inline-size: var(--space-7);
      border-block-start: var(--rule-thin) solid var(--color-rule-strong);
    }
  }

  .br__caption {
    max-inline-size: var(--measure-reading);
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }
</style>
