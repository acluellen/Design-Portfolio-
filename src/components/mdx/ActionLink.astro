---
// A button that links out, such as "View the affinity map in FigJam". `variant="text"` is a plain text
// link instead of a button (`small` sets it in small type). Without `href` it shows a dashed
// placeholder in dev and review previews, and nothing in production.
import Button from "../site/Button.astro";
import { showPlaceholders } from "../../lib/case-studies";

interface Props {
  label: string;
  href?: string;
  variant?: "primary" | "secondary" | "text";
  /** Text variant only: small type, for a quiet side link. */
  small?: boolean;
}

const { label, href, variant = "secondary", small = false } = Astro.props;
const buttonVariant = variant === "text" ? "secondary" : variant;
---

{
  href && variant === "text" ? (
    <p class:list={["action", "action--text", { "action--small": small }]}>
      <a href={href} target="_blank" rel="noopener">
        {label}
        <span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    </p>
  ) : href ? (
    <p class="action">
      <Button href={href} variant={buttonVariant} external>
        {label}
        <span class="visually-hidden"> (opens in a new tab)</span>
      </Button>
    </p>
  ) : (
    showPlaceholders && (
      <p class="action">
        <span class="placeholder-chip">Placeholder · {label}</span>
      </p>
    )
  )
}

<style>
  .action--small {
    font-size: var(--step--1);
  }

  .placeholder-chip {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-height);
    padding-inline: var(--control-padding);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    border: var(--rule-thick) dashed var(--color-accent);
    border-radius: var(--radius-control);
  }
</style>
