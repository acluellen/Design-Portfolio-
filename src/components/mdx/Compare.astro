---
// Two images side by side, each with a small label: a before and an after.
// Tall phone screens sit next to each other; on very narrow screens they stack.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  before: ImageMetadata;
  beforeAlt: string;
  beforeLabel?: string;
  after: ImageMetadata;
  afterAlt: string;
  afterLabel?: string;
  caption?: string;
}

const {
  before,
  beforeAlt,
  beforeLabel = "Before",
  after,
  afterAlt,
  afterLabel = "After",
  caption,
} = Astro.props;

const widths = (img: ImageMetadata) =>
  [...new Set([320, 480, 640, img.width])].filter((w) => w <= img.width).sort((a, b) => a - b);
const sizes = "(min-width: 48rem) 20rem, 45vw";
---

<figure class="compare">
  <div class="compare__pair">
    <div class="compare__item">
      <p class="label">{beforeLabel}</p>
      <Picture src={before} alt={beforeAlt} widths={widths(before)} sizes={sizes} formats={["avif", "webp"]} fallbackFormat="jpg" quality={70} loading="lazy" decoding="async" />
    </div>
    <div class="compare__item">
      <p class="label">{afterLabel}</p>
      <Picture src={after} alt={afterAlt} widths={widths(after)} sizes={sizes} formats={["avif", "webp"]} fallbackFormat="jpg" quality={70} loading="lazy" decoding="async" />
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .compare {
    display: grid;
    gap: var(--space-3);
  }

  .compare__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    align-items: start;
  }

  @media (max-width: 22rem) {
    .compare__pair {
      grid-template-columns: 1fr;
    }
  }

  .compare__item {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .compare__item :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: var(--rule-thin) solid var(--color-rule);
    border-radius: var(--radius-media);
  }

  .compare figcaption {
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }
</style>
