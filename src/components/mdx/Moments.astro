---
// Large visual moments that each show one decision: a short title and caption beside a big frame,
// alternating sides so the page does not repeat one layout. The frame is a placeholder (previews
// only) until the real interface capture arrives; pass `src` to show an image instead.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { showPlaceholders } from "../../lib/case-studies";

interface Item {
  title: string;
  caption: string;
  /** Names the pending capture, shown inside the placeholder. */
  label: string;
  kind?: "dashboard" | "phone" | "diagram";
  src?: ImageMetadata;
  alt?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="mom is-wide is-full">
  {
    items.map((item) => (
      <figure class="mom__item">
        <figcaption class="mom__text">
          <span class="mom__title">{item.title}</span>
          <span class="mom__caption">{item.caption}</span>
        </figcaption>
        {item.src ? (
          <Picture src={item.src} alt={item.alt ?? ""} widths={[640, 960, 1280]} sizes="(min-width: 72rem) 44rem, 92vw" formats={["avif", "webp"]} fallbackFormat="jpg" loading="lazy" />
        ) : (
          showPlaceholders && (
            <div class={`mom__frame mom__frame--${item.kind ?? "dashboard"}`}>
              <span class="mom__label">Placeholder · {item.label}</span>
            </div>
          )
        )}
      </figure>
    ))
  }
</div>

<style>
  .mom {
    display: grid;
    gap: var(--space-8);
  }

  .mom__item {
    display: grid;
    gap: var(--space-4);
    align-items: center;
    margin: 0;
  }

  @media (min-width: 56rem) {
    .mom__item {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: var(--space-7);
    }

    .mom__item:nth-child(even) .mom__text {
      order: 2;
    }
  }

  .mom__text {
    display: grid;
    gap: var(--space-2);
  }

  .mom__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    color: var(--color-heading);
  }

  .mom__caption {
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }

  .mom__frame {
    display: grid;
    align-content: end;
    padding: var(--space-4);
    aspect-ratio: var(--ratio-dashboard);
    background: var(--color-placeholder);
    border: var(--rule-thick) dashed var(--color-accent);
    border-radius: var(--radius-media);
  }

  .mom__frame--phone {
    inline-size: min(100%, 22rem);
    justify-self: center;
    aspect-ratio: var(--ratio-about-media);
  }

  .mom__frame--diagram {
    aspect-ratio: var(--ratio-diagram);
  }

  .mom__label {
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
  }

  .mom :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: var(--rule-thin) solid var(--color-rule);
    border-radius: var(--radius-media);
  }
</style>
