---
// Lays out several <Stat> side by side. Optional.
---

<div class="stat-group">
  <slot />
</div>

<style>
  /* One column on phones, so three stats never land as two plus one. Side by side from 40rem. */
  .stat-group {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 40rem) {
    .stat-group {
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    }
  }
</style>
