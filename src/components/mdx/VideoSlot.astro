---
// A screen recording in a phone shaped frame, with a caption. Plays only when the visitor presses
// play. Without `src` it shows a dashed placeholder in dev and review previews, and nothing in
// production.
import { showPlaceholders } from "../../lib/case-studies";

interface Props {
  /** Path to the video in /public, such as "/video/athenascribe-walkthrough.mp4". */
  src?: string;
  /** What the recording shows, for the placeholder and for screen readers. */
  label: string;
  caption: string;
}

const { src, label, caption } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

{
  (src || showPlaceholders) && (
    <figure class="video-slot">
      {src ? (
        <video class="video-slot__frame" controls preload="metadata" playsinline aria-label={label}>
          <source src={`${base}${src}`} type="video/mp4" />
        </video>
      ) : (
        <div class="video-slot__frame video-slot__frame--placeholder">
          <span class="video-slot__play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
          </span>
          <span class="video-slot__label">Placeholder · {label}</span>
        </div>
      )}
      <figcaption class="video-slot__caption">{caption}</figcaption>
    </figure>
  )
}

<style>
  .video-slot {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    margin: 0;
  }

  .video-slot__frame {
    display: block;
    inline-size: min(100%, 18rem);
    aspect-ratio: 9 / 19.5;
    background: var(--color-paper);
    border: var(--rule-thin) solid var(--color-rule-strong);
    border-radius: var(--radius-section);
    object-fit: cover;
  }

  .video-slot__frame--placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-3);
    padding: var(--space-5);
    text-align: center;
    border: var(--rule-thick) dashed var(--color-accent);
  }

  .video-slot__play {
    display: grid;
    place-items: center;
    inline-size: var(--size-play);
    block-size: var(--size-play);
    border-radius: 50%;
    color: var(--color-always-dark-ink);
    background: var(--color-overlay);
  }

  .video-slot__label {
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
  }

  .video-slot__caption {
    max-inline-size: 22rem;
    font-size: var(--step--1);
    color: var(--color-ink-muted);
    text-align: center;
  }
</style>
