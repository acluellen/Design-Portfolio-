---
// A small square number in mono that ties a row to a finding or marks a step. Screen readers hear the label
// and the number, for example "Finding 1".
interface Props {
  n: number | string;
  label?: string;
}

const { n, label } = Astro.props;
---

<span class="badge">{label && <span class="visually-hidden">{label} </span>}{n}</span>

<style>
  .badge {
    display: inline-grid;
    flex-shrink: 0;
    place-items: center;
    inline-size: var(--size-badge);
    block-size: var(--size-badge);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    line-height: 1;
    color: var(--color-heading);
    background: var(--color-paper);
    border: var(--rule-thin) solid var(--color-heading);
  }
</style>
