---
// A short numbered list for annotations that go with one large still: a quiet numeral in a thin ring,
// then one line of text. No boxes. When the real still exists, the same numbers can be placed on it.
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ol class="num" role="list">
  {
    items.map((text, i) => (
      <li class="num__item">
        <span class="num__n" aria-hidden="true">{i + 1}</span>
        <span>{text}</span>
      </li>
    ))
  }
</ol>

<style>
  .num {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    max-inline-size: var(--measure-reading);
  }

  .num__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    color: var(--color-ink);
  }

  .num__n {
    display: inline-grid;
    place-items: center;
    inline-size: var(--space-5);
    block-size: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-heading);
    border: var(--rule-thin) solid var(--color-rule-strong);
    border-radius: 50%;
  }
</style>
