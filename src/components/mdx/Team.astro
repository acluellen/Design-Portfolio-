---
interface Props {
  label?: string;
}

const { label = "What the team owned" } = Astro.props;
---

<div class="owner owner--team">
  <p class="label owner__label">{label}</p>
  <div class="owner__body"><slot /></div>
</div>

<style>
  .owner {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-width: 0;
    padding-block-start: var(--space-4);
    border-top: var(--rule-thick) solid var(--color-rule-strong);
  }

  .owner__body :global(ul) {
    display: grid;
    gap: var(--space-2);
  }
</style>
