---
// A camera tour of Aaron's FigJam research board, drawn on one fixed surface: the wide board
// screenshot, a sharp export of each of the three category lists placed over the thumbnails, and the
// full size highlighted card of each list placed over its own thumbnail. The camera moves over that
// surface and never swaps an image: whole board, Emergency Alerts, Posts and Events, Forms and
// Attachments, then back to the whole board. It plays while on screen, loops, and pauses on tap (the
// same controls as the other demos). With reduced motion nothing plays by itself: the whole board
// shows and the button starts the tour.
interface Props {
  /** The visible line directly under the tour. */
  caption: string;
  /** What a screen reader hears for the tour. */
  description: string;
}

const { caption, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const file = (name: string) => `${base}/media/researchtour/${name}.webp`;
---

<figure class="tour" data-tour data-state="idle">
  <div
    class="tour__frame"
    data-board-src={file("board")}
    data-listemer-src={file("listemer")}
    data-listposts-src={file("listposts")}
    data-listforms-src={file("listforms")}
    data-cardemer-src={file("cardemer")}
    data-cardposts-src={file("cardposts")}
    data-cardforms-src={file("cardforms")}
  >
    <img class="tour__poster" src={file("board")} alt="" width={2000} height={1112} loading="lazy" decoding="async" />
    <canvas class="tour__canvas" role="img" aria-label={description} hidden></canvas>
    <button type="button" class="tour__tap" data-tour-btn aria-label="Play animation">
      <svg class="tour__i" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
    </button>
  </div>
  <figcaption class="tour__caption">{caption}</figcaption>
</figure>

<style>
  .tour {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-inline-size: 0;
    margin: 0;
  }

  .tour__frame {
    position: relative;
    aspect-ratio: 2000 / 1112;
    overflow: hidden;
    background: var(--color-paper);
    border-radius: var(--radius-media);
  }

  .tour__poster,
  .tour__canvas {
    position: absolute;
    inset: 0;
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .tour__canvas[hidden] {
    display: none;
  }

  .tour[data-ready] .tour__poster {
    visibility: hidden;
  }

  .tour__tap {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-always-dark-ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .tour__tap:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: calc(var(--focus-offset) * -1);
  }

  .tour__i {
    display: none;
    box-sizing: content-box;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    padding: var(--space-3);
    border-radius: 50%;
    background: var(--color-overlay);
  }

  /* The play mark shows only after a visitor pauses the tour, or with reduced motion. Never while
     it loads, scrolls into view, or waits off screen. */
  .tour[data-mark] .tour__i {
    display: block;
  }

  .tour__caption {
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: var(--color-ink-muted);
  }
</style>

<script>
  // Board space is the pixels of board.webp (2000 by 1112). Every other layer is placed in it:
  // x, y and w are board pixels; the height follows each picture's own shape.
  const BOARD = { w: 2000, h: 1112 };
  const PLACE = {
    board: { x: 0, y: 0, w: 2000 },
    listemer: { x: 346.5, y: 3.92, w: 840.7 },
    listposts: { x: 347.15, y: 417.08, w: 839.39 },
    listforms: { x: 347.15, y: 809.32, w: 839.39 },
    cardemer: { x: 959.79, y: 272.53, w: 183.69 },
    cardposts: { x: 952.78, y: 637.84, w: 183.83 },
    cardforms: { x: 947.32, y: 995.67, w: 183.41 },
  } as const;
  type Key = keyof typeof PLACE;
  const ORDER = Object.keys(PLACE) as Key[];
  // Seconds. The tour reads like a scroll through one list: the whole board, in to a list (the card
  // with its neighbors in view), in to the card, back out to the list, then a level pan to the next
  // list. The last card returns straight to the whole board.
  // Move times follow the size of the zoom, at a steady rate of about 1.7 times the scale each second:
  // the small zoom from the whole board to a list is short, the long pull back from a card is longer.
  // `open` is the short beat on the whole board when the loop comes round; the first play adds
  // `openFirst` on top, so a visitor still gets a full establishing shot.
  const T = { open: 0.5, openFirst: 0.7, intoList: 1.1, listHold: 0.3, toCard: 0.9, card: 3.5, fromCard: 0.9, pan: 1.2, back: 1.4 };

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  type Cam = { cx: number; cy: number; k: number };
  type Seg = { dur: number; from: Cam; to: Cam };

  const smoother = (u: number) => u * u * u * (u * (u * 6 - 15) + 10);
  // Leave a screen quickly and settle slowly onto the next: the move is half done at about 40% of its
  // time. It starts and ends at rest, so every hold stays still.
  const ease = (u: number) => smoother(Math.pow(u, 0.8));

  // The camera from a to b. The zoom is even on a log scale; the center follows so the target stays
  // on a straight path (a pure pan when both zooms match).
  function between(a: Cam, b: Cam, u: number): Cam {
    const e = ease(u);
    const la = Math.log(a.k);
    const lb = Math.log(b.k);
    const kBase = Math.exp(la + (lb - la) * e);
    const w = Math.abs(lb - la) < 1e-4 ? e : (1 / a.k - 1 / kBase) / (1 / a.k - 1 / b.k);
    return { cx: a.cx + (b.cx - a.cx) * w, cy: a.cy + (b.cy - a.cy) * w, k: kBase };
  }

  function load(src: string) {
    return new Promise<HTMLImageElement>((resolve, reject) => {
      const img = new Image();
      img.decoding = "async";
      img.onload = () => img.decode().catch(() => {}).then(() => resolve(img));
      img.onerror = () => reject(new Error(src));
      img.src = src;
    });
  }

  document.querySelectorAll<HTMLElement>("[data-tour]").forEach((root) => {
    const frame = root.querySelector<HTMLElement>(".tour__frame")!;
    const canvas = root.querySelector<HTMLCanvasElement>(".tour__canvas")!;
    const btn = root.querySelector<HTMLButtonElement>("[data-tour-btn]")!;
    const ctx = canvas.getContext("2d")!;
    const label = { playing: "Pause animation", paused: "Play animation", idle: "Play animation" };

    let imgs: Record<string, HTMLImageElement> | null = null;
    let loading = false;
    let segs: Seg[] = [];
    let total = 0;
    let vw = 0;
    let vh = 0;
    let dpr = 1;
    let t = -T.openFirst;
    let last = 0;
    let raf = 0;
    let playing = false;
    let userPaused = false;
    let ratio = 0;
    let kList = 1; // zoom that shows a whole list, the same for all three so the pans stay level
    let kCard = 1; // the smallest zoom that shows a whole card
    const hasFilter = "filter" in ctx;
    const CARDS: Key[] = ["cardemer", "cardposts", "cardforms"];

    function paint() {
      const s = playing ? "playing" : t > 0 ? "paused" : "idle";
      root.dataset.state = s;
      root.toggleAttribute("data-mark", userPaused || (reduce.matches && !playing));
      btn.setAttribute("aria-label", label[s]);
    }

    // A camera that looks at pixel (px, py) of a card, with s screen pixels per card pixel.
    function onCard(key: Key, px: number, py: number, s: number): Cam {
      const img = imgs![key];
      const f = PLACE[key].w / img.naturalWidth; // board pixels per card pixel
      return { cx: PLACE[key].x + px * f, cy: PLACE[key].y + py * f, k: s / f };
    }

    // The camera stops, from the size of the view. Every stop shows its whole card, filling the view
    // (cover fit). The Forms card is wider than the view, so its edges trim a little; cx moves that
    // trim to the right side, so the logo and menu on the left stay in view.
    function whole(key: Key, cx?: number): Cam {
      const img = imgs![key];
      const s = Math.max(vw / img.naturalWidth, vh / img.naturalHeight);
      return onCard(key, cx ?? img.naturalWidth / 2, img.naturalHeight / 2, s);
    }

    function build() {
      const wholeBoard: Cam = { cx: BOARD.w / 2, cy: BOARD.h / 2, k: vw / BOARD.w };
      const a = whole("cardemer");
      const b = whole("cardposts");
      const c = whole("cardforms", 722);

      // A list stop frames the whole list picture, with a little room around it.
      const listKeys: Key[] = ["listemer", "listposts", "listforms"];
      const fit = listKeys.map((key) => {
        const bw = PLACE[key].w;
        const bh = (bw * imgs![key].naturalHeight) / imgs![key].naturalWidth;
        return Math.min(vw / bw, vh / bh) * 0.94;
      });
      kList = Math.min(...fit);
      kCard = Math.min(a.k, b.k, c.k);
      const [l1, l2, l3] = listKeys.map((key): Cam => {
        const bw = PLACE[key].w;
        const bh = (bw * imgs![key].naturalHeight) / imgs![key].naturalWidth;
        return { cx: PLACE[key].x + bw / 2, cy: PLACE[key].y + bh / 2, k: kList };
      });

      const hold = (cam: Cam, dur: number): Seg => ({ dur, from: cam, to: cam });
      const move = (dur: number, from: Cam, to: Cam): Seg => ({ dur, from, to });
      segs = [
        hold(wholeBoard, T.open),
        move(T.intoList, wholeBoard, l1),
        hold(l1, T.listHold),
        move(T.toCard, l1, a),
        hold(a, T.card),
        move(T.fromCard, a, l1),
        move(T.pan, l1, l2),
        hold(l2, T.listHold),
        move(T.toCard, l2, b),
        hold(b, T.card),
        move(T.fromCard, b, l2),
        move(T.pan, l2, l3),
        hold(l3, T.listHold),
        move(T.toCard, l3, c),
        hold(c, T.card),
        move(T.back, c, wholeBoard),
      ];
      total = segs.reduce((n, s) => n + s.dur, 0);
    }

    function camAt(sec: number): Cam {
      let r = sec % total;
      for (const s of segs) {
        if (r < s.dur) return s.from === s.to ? s.from : between(s.from, s.to, r / s.dur);
        r -= s.dur;
      }
      return segs[0].from;
    }

    function layer(img: HTMLImageElement, cam: Cam, bx: number, by: number, bw: number) {
      const bh = (bw * img.naturalHeight) / img.naturalWidth;
      const tx = vw / 2 - cam.k * cam.cx;
      const ty = vh / 2 - cam.k * cam.cy;
      const dx = tx + bx * cam.k;
      const dy = ty + by * cam.k;
      const dw = bw * cam.k;
      const dh = bh * cam.k;
      const x0 = Math.max(0, dx);
      const y0 = Math.max(0, dy);
      const x1 = Math.min(vw, dx + dw);
      const y1 = Math.min(vh, dy + dh);
      if (x1 <= x0 || y1 <= y0) return;
      const fx = img.naturalWidth / dw;
      const fy = img.naturalHeight / dh;
      ctx.drawImage(img, (x0 - dx) * fx, (y0 - dy) * fy, (x1 - x0) * fx, (y1 - y0) * fy, x0 * dpr, y0 * dpr, (x1 - x0) * dpr, (y1 - y0) * dpr);
    }

    // A thin accent ring around the three highlighted cards, shown only while the whole board is in
    // view. It fades with the zoom, so it is gone before the camera arrives at a card and returns on the
    // way back out.
    function ring(cam: Cam) {
      const r = Math.log(cam.k / (vw / BOARD.w));
      const t = Math.min(1, Math.max(0, (r - 0.2) / 1.2));
      const alpha = 1 - t * t * (3 - 2 * t);
      if (alpha <= 0.01) return;
      const color = getComputedStyle(frame).getPropertyValue("--color-accent").trim() || "#1d4ed8";
      const tx = vw / 2 - cam.k * cam.cx;
      const ty = vh / 2 - cam.k * cam.cy;
      const pad = 3;
      ctx.save();
      ctx.globalAlpha = alpha;
      ctx.strokeStyle = color;
      ctx.lineWidth = 2 * dpr;
      (["cardemer", "cardposts", "cardforms"] as Key[]).forEach((key) => {
        const img = imgs![key];
        const bw = PLACE[key].w;
        const bh = (bw * img.naturalHeight) / img.naturalWidth;
        const x = (tx + PLACE[key].x * cam.k - pad) * dpr;
        const y = (ty + PLACE[key].y * cam.k - pad) * dpr;
        ctx.strokeRect(x, y, (bw * cam.k + pad * 2) * dpr, (bh * cam.k + pad * 2) * dpr);
      });
      ctx.restore();
    }

    // How far the camera has gone from the list view toward a card: 0 at the list, 1 at the card.
    function focus(cam: Cam) {
      const span = Math.log(kCard / kList);
      if (span <= 0) return 0;
      const u = Math.min(1, Math.max(0, (Math.log(cam.k / kList) - 0.1 * span) / (0.8 * span)));
      return u * u * (3 - 2 * u);
    }

    // The card nearest the middle of the view stays sharp while the camera moves in on it.
    function nearest(cam: Cam): Key {
      let best = CARDS[0];
      let d = Infinity;
      CARDS.forEach((key) => {
        const bw = PLACE[key].w;
        const bh = (bw * imgs![key].naturalHeight) / imgs![key].naturalWidth;
        const dd = Math.hypot(PLACE[key].x + bw / 2 - cam.cx, PLACE[key].y + bh / 2 - cam.cy);
        if (dd < d) { d = dd; best = key; }
      });
      return best;
    }

    function draw(cam: Cam) {
      if (!imgs) return;
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = "high";
      const bg = getComputedStyle(frame).backgroundColor;
      // Beyond the board's edge (the first and last list stops reach past it) the canvas is the page's
      // own paper color, the same as the board's transparent margin, so the tour sits on the page.
      ctx.fillStyle = bg;
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      const f = focus(cam);
      const draw1 = (key: Key) => layer(imgs![key], cam, PLACE[key].x, PLACE[key].y, PLACE[key].w);
      if (f < 0.02) {
        ORDER.forEach(draw1);
      } else {
        // Everything around the chosen card softens and dims as the camera closes in, then clears
        // again on the way back out. Without canvas blur support only the dimming shows.
        const keep = nearest(cam);
        if (hasFilter) (ctx as any).filter = `blur(${(5 * f * dpr).toFixed(2)}px)`;
        ORDER.forEach((key) => { if (key !== keep) draw1(key); });
        if (hasFilter) (ctx as any).filter = "none";
        ctx.globalAlpha = 0.4 * f;
        ctx.fillStyle = bg;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.globalAlpha = 1;
        draw1(keep);
      }
      ring(cam);
    }

    function size() {
      const r = frame.getBoundingClientRect();
      vw = r.width;
      vh = r.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(vw * dpr);
      canvas.height = Math.round(vh * dpr);
      build();
      draw(camAt(t));
    }

    function tick(now: number) {
      if (!playing) return;
      t += Math.min(now - last, 100) / 1000;
      last = now;
      draw(camAt(t));
      raf = requestAnimationFrame(tick);
    }

    function play() {
      if (!imgs || playing) return;
      playing = true;
      last = performance.now();
      paint();
      raf = requestAnimationFrame(tick);
    }

    function pause() {
      playing = false;
      cancelAnimationFrame(raf);
      paint();
    }

    async function prepare() {
      if (imgs || loading) return;
      loading = true;
      const d = frame.dataset;
      const src: Record<Key, string | undefined> = {
        board: d.boardSrc,
        listemer: d.listemerSrc,
        listposts: d.listpostsSrc,
        listforms: d.listformsSrc,
        cardemer: d.cardemerSrc,
        cardposts: d.cardpostsSrc,
        cardforms: d.cardformsSrc,
      };
      try {
        const loaded = await Promise.all(ORDER.map((k) => load(src[k]!)));
        imgs = Object.fromEntries(ORDER.map((k, i) => [k, loaded[i]]));
      } catch {
        loading = false;
        return; // the whole board poster stays
      }
      canvas.hidden = false;
      size();
      root.setAttribute("data-ready", "");
      new ResizeObserver(size).observe(frame);
      resume();
    }

    function resume() {
      if (reduce.matches || userPaused || ratio < 0.5) return;
      play();
    }

    btn.addEventListener("click", () => {
      if (!imgs) { userPaused = false; prepare().then(play); return; }
      if (playing) { userPaused = true; pause(); return; }
      userPaused = false;
      play();
    });

    // Load the pictures a little before the tour scrolls into view.
    new IntersectionObserver(([e]) => { if (e.isIntersecting) prepare(); }, { rootMargin: "400px 0px" }).observe(root);

    new IntersectionObserver(([e]) => {
      ratio = e.intersectionRatio;
      if (ratio < 0.25 && playing) pause();
      else resume();
    }, { threshold: [0, 0.25, 0.5, 0.75, 1] }).observe(root);

    reduce.addEventListener("change", () => { if (reduce.matches) pause(); else resume(); paint(); });
    paint();
  });
</script>
