---
// An image with required alt text. Pass an imported image (optimized by Astro: AVIF and WebP,
// sized for the reading column) or a path under public/.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: string | ImageMetadata;
  alt: string;
  caption?: string;
  /** Tall images, such as a phone screen: shown narrower and centered. */
  narrow?: boolean;
}

const { src, alt, caption, narrow = false } = Astro.props;

if (alt === undefined) {
  throw new Error(`<Figure> is missing alt text. Add alt="" only if the image is decorative.`);
}
---

<figure class:list={["figure", { "figure--narrow": narrow }]}>
  {
    typeof src === "string" ? (
      <img src={src} alt={alt} loading="lazy" />
    ) : (
      <Picture
        src={src}
        alt={alt}
        widths={[...new Set([480, 720, 960, 1280, src.width])].filter((w) => w <= src.width).sort((a, b) => a - b)}
        sizes={narrow ? "(min-width: 30rem) 20rem, 70vw" : "(min-width: 48rem) 42rem, 92vw"}
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        quality={70}
        loading="lazy"
        decoding="async"
      />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    display: grid;
    gap: var(--space-3);
  }

  .figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: var(--rule-thin) solid var(--color-rule);
    border-radius: var(--radius-media);
  }

  /* Only the outer element narrows; an image inside a picture keeps filling it. */
  .figure--narrow > :global(picture),
  .figure--narrow > :global(img) {
    justify-self: center;
    inline-size: min(70%, 20rem);
  }

  .figure figcaption {
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }
</style>
