---
import { render } from "astro:content";
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import { getCaseStudies } from "../../lib/case-studies";
import { mdxComponents } from "../../components/mdx";

export async function getStaticPaths() {
  const studies = await getCaseStudies();
  return studies.map((study, i) => ({
    params: { slug: study.id },
    props: { study, prev: studies[i - 1], next: studies[i + 1] },
  }));
}

const { study, prev, next } = Astro.props;
const { Content, headings } = await render(study);
const sections = headings.filter((h) => h.depth === 2);
---

<CaseStudyLayout study={study} prev={prev} next={next} sections={sections}>
  <Content components={mdxComponents} />
</CaseStudyLayout>
