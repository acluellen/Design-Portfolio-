---
// About page (October 10 direction): the portrait stays beside the text while the page scrolls,
// then one short resume list and the quotes. Below, "A few things that shaped me": numbered photo
// tiles with captions. The page ends with the same navy contact block as the home page.
// Placeholders (quotes, photos still to come) show in review previews only.
import PageLayout from "../layouts/PageLayout.astro";
import Photo from "../components/site/Photo.astro";
import KronClip from "../components/site/KronClip.astro";
import { showPlaceholders } from "../lib/case-studies";
import { quotes, resume, shaped } from "../data/about";

// A tile row with no photo and no clip is a placeholder row: previews only.
const rows = shaped.filter((row) => showPlaceholders || row.some((t) => t.photo || t.clip));
let count = 0;
const numbered = rows.map((row) => row.map((tile) => ({ ...tile, number: String(++count).padStart(2, "0") })));
---

<PageLayout title="About" description="Aaron Luellen, a product designer in Oakland focused on clarity." flushBottom contact>
  <div class="container about-page">
    <!-- Portrait and text share one block, so the sticky portrait stops where the text ends. -->
    <div class="about-page__main">
    <figure class="about-page__portrait">
      <!-- Draft portrait; swap the file src/assets/photos/aaron-portrait.jpg to replace it. -->
      <Photo
        name="aaron-portrait"
        widths={[320, 480, 704]}
        sizes="(min-width: 64rem) 22rem, 70vw"
        cover={4 / 5}
        ratio="4 / 5"
        loading="eager"
        class="about-page__photo"
      />
    </figure>

    <div class="about-page__content">
      <h1>Hey, I’m Aaron.</h1>
      <div class="about-page__text">
        <p class="about-page__lede">
          I’m a product designer based in Oakland. For much of my adult life, I’ve competed professionally
          in Muay Thai while coaching fighters, mentoring young people, and earning my degree in psychology.
          Those years shaped how I understand people: how they learn, what motivates them, and what makes
          an experience worth returning to. Product design is where I’m putting that understanding to work.
        </p>
        <p>
          Working closely with people has given me an appreciation for how differently we can experience
          the same situation. As a coach, I learned to pay attention to what actually lands. I enjoy user
          research for the same reason. It gives me a chance to check my assumptions before turning them
          into design decisions. I want those insights to influence what gets built, down to the smallest
          details.
        </p>
        <p>
          Outside of design, I enjoy spending time with people I care about, reading, hiking, and traveling
          whenever I can. There’s always something else I’m interested in learning.
        </p>
      </div>

      <!-- One short list, one line each: year, place, role. No year until Aaron gives one. -->
      <section class="ledger" aria-labelledby="experience-heading">
        <h2 id="experience-heading" class="ledger__title">/ Experience</h2>
        <ul class="ledger__rows">
          {
            resume.map((row) => (
              <li class="ledger__row">
                <span class="ledger__when">{row.when}</span>
                <span class="ledger__place" translate="no">{row.place}</span>
                <span class="ledger__what">
                  {row.href ? (
                    <a href={row.href} target="_blank" rel="noopener noreferrer">
                      {row.what}
                      <span class="visually-hidden"> (opens in a new tab)</span>
                    </a>
                  ) : (
                    row.what
                  )}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      {
        (quotes.length > 0 || showPlaceholders) && (
          <section class="ledger" aria-labelledby="quotes-heading">
            <h2 id="quotes-heading" class="ledger__title">/ What people say</h2>
            {quotes.length > 0 ? (
              quotes.map((q) => (
                <figure class="quote">
                  <blockquote>“{q.quote}”</blockquote>
                  <figcaption>{q.name}, {q.role}</figcaption>
                </figure>
              ))
            ) : (
              <p class="quote-slot">Quotes from mentors and teammates go here.</p>
            )}
          </section>
        )
      }
    </div>
    </div>

    <!-- Numbered tiles with short captions. Each row ends at one height. -->
    <section class="shaped" aria-labelledby="shaped-heading">
      <h2 id="shaped-heading">A few things that shaped me</h2>
      {
        numbered.map((row) => (
          <ul class="shaped__row">
            {row.map((tile) => (
              <li class:list={["shaped__tile", { "shaped__tile--wide": tile.ratio >= 1.4 }]} style={`--ratio: ${tile.ratio}`}>
                <p class="shaped__label">
                  <span class="shaped__number" aria-hidden="true">{tile.number} /</span>
                  <span class="shaped__caption">{tile.caption}</span>
                </p>
                {tile.clip ? (
                  <KronClip bare />
                ) : tile.photo ? (
                  <Photo
                    name={tile.photo}
                    widths={[400, 700, 1000]}
                    sizes={tile.ratio >= 1.4 ? "(min-width: 76rem) 36rem, (min-width: 48rem) 48vw, 92vw" : "(min-width: 76rem) 24rem, (min-width: 48rem) 30vw, 46vw"}
                    ratio={`${tile.ratio}`}
                    class="shaped__photo"
                  />
                ) : (
                  <div class="shaped__slot" aria-hidden="true">Photo to add</div>
                )}
              </li>
            ))}
          </ul>
        ))
      }
    </section>
  </div>
</PageLayout>

<style>
  .about-page {
    display: grid;
    gap: var(--space-9);
    padding-block-start: var(--space-8);
  }

  .about-page__main {
    display: grid;
    gap: var(--space-8);
  }

  .about-page > *,
  .about-page__main > * {
    min-width: 0;
  }

  /* From 64rem: portrait left, text right. The portrait stays in view while the text scrolls and
     stops at the end of the text block, before the gym photos. */
  @media (min-width: 64rem) {
    .about-page__main {
      grid-template-columns: var(--size-portrait) 1fr;
      column-gap: var(--space-9);
      align-items: start;
    }

    .about-page__portrait {
      position: sticky;
      top: calc(var(--header-height) + var(--space-6));
    }
  }

  .about-page__portrait {
    margin: 0;
  }

  /* The gray placeholder, styled like the home About photo. */
  .about-page__portrait .about-page__slot {
    display: grid;
    place-items: center;
    background: var(--color-placeholder);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .about-page__portrait :global(.about-page__photo) {
    display: block;
    inline-size: min(70%, var(--size-portrait));
    block-size: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: var(--focus-portrait);
    border-radius: var(--radius-media);
  }

  @media (min-width: 64rem) {
    .about-page__portrait :global(.about-page__photo) {
      inline-size: 100%;
    }
  }

  .about-page__portrait .about-page__slot.about-page__slot {
    display: grid;
  }

  .about-page__content {
    display: grid;
    gap: var(--space-8);
  }

  .about-page__content h1 {
    font-size: var(--step-5);
  }

  .about-page__text {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure-reading);
    color: var(--color-ink-muted);
  }

  .about-page__lede {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--color-ink);
  }

  /* The resume list: a mono "/ Title", then one line per row over thin rules: year, place, role. */
  .ledger {
    display: grid;
    gap: var(--space-3);
  }

  .ledger__title {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .ledger__rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-block-start: var(--rule-thin) solid var(--color-rule-strong);
  }

  /* Phones: place and role stacked, year on the right. From 40rem: one line, year first. */
  .ledger__row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-1) var(--space-5);
    padding-block: var(--space-3);
    border-block-end: var(--rule-thin) solid var(--color-rule);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: var(--leading-snug);
  }

  .ledger__when {
    grid-column: 2;
    grid-row: 1;
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .ledger__place {
    grid-column: 1;
    grid-row: 1;
    color: var(--color-heading);
  }

  .ledger__what {
    grid-column: 1;
    color: var(--color-ink-muted);
  }

  @media (min-width: 40rem) {
    .ledger__row {
      grid-template-columns: 13ch 1fr 1fr; /* fixed year column, so every row lines up */
    }

    .ledger__when,
    .ledger__place,
    .ledger__what {
      grid-column: auto;
      grid-row: auto;
    }
  }

  .quote {
    margin: 0;
    padding-block: var(--space-4);
    border-block-end: var(--rule-thin) solid var(--color-rule);
    display: grid;
    gap: var(--space-2);
  }

  .quote figcaption {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  /* Review previews only: the spot the quotes will fill. */
  .quote-slot {
    display: grid;
    place-items: center;
    min-block-size: var(--size-quote-slot);
    padding: var(--space-5);
    background: var(--color-placeholder);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-align: center;
    color: var(--color-ink-muted);
  }

  /* A few things that shaped me. Phones: wide tiles full width and first in their row, the rest
     two across.
     From 48rem: each row on one line, tiles sized by their shape so a row ends at one height. */
  .shaped {
    display: grid;
    gap: var(--space-6);
  }

  .shaped h2 {
    font-size: var(--step-4);
    font-weight: var(--weight-light);
  }

  .shaped__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shaped__tile {
    flex: 1 1 calc(50% - var(--space-3));
    display: grid;
    gap: var(--space-2);
    align-content: start;
    min-width: 0;
  }

  .shaped__tile--wide {
    flex-basis: 100%;
    order: -1;
  }

  @media (min-width: 48rem) {
    .shaped__row {
      flex-wrap: nowrap;
    }

    .shaped__tile {
      flex: var(--ratio) 1 0;
      order: 0;
    }
  }

  .shaped__tile :global(.shaped__photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ratio);
    object-fit: cover;
    border-radius: var(--radius-media);
  }

  .shaped__slot {
    display: grid;
    place-items: center;
    aspect-ratio: var(--ratio);
    background: var(--color-placeholder);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  /* "01 / CAPTION" above each picture, in the same small mono capitals as the Selected work tiles
     on the home page. */
  .shaped__label {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: var(--leading-snug);
  }

  .shaped__number {
    flex: none;
    color: var(--color-ink-muted);
  }

  .shaped__caption {
    color: var(--color-heading);
  }
</style>
