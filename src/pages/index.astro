---
import PageLayout from "../layouts/PageLayout.astro";
import Button from "../components/site/Button.astro";
import Photo from "../components/site/Photo.astro";
import ContactEmail from "../components/site/ContactEmail.astro";
import KronClip from "../components/site/KronClip.astro";
import { site } from "../site.config";
import WorkCard from "../components/site/WorkCard.astro";
import { caseStudyHref, getAllCaseStudies } from "../lib/case-studies";

// Selected work: the featured case study as one large card, the rest below by `order`.
const studies = (await getAllCaseStudies()).filter((s) => s.data.card);
const featured = studies.find((s) => s.data.featured);
const others = studies.filter((s) => s !== featured);
---

<PageLayout title="Aaron Luellen" flushBottom footerEmail={false}>
  <!-- Every section sits in one stack with the same gap between them. -->
  <div class="container stack">
  <!-- 1. Name and one line. No photo and no buttons: the work starts right below. -->
  <section class="hero" aria-labelledby="hero-heading">
    <h1 id="hero-heading" translate="no">Aaron Luellen</h1>
    <p class="hero__role">Product designer, research led, Oakland</p>
  </section>

  <!-- 2. Selected work, right after the name: one featured card, then smaller cards. Cards link only when published. -->
  <section id="work" class="work" aria-labelledby="work-heading" data-reveal>
    <h2 id="work-heading">Selected work</h2>
    {featured && <WorkCard study={featured} href={caseStudyHref(featured)} featured />}
    {
      others.length > 0 && (
        <div class="work__grid">
          {others.map((study) => (
            <WorkCard study={study} href={caseStudyHref(study)} />
          ))}
        </div>
      )
    }
  </section>

  <!-- 3. BRIDGEGOOD and KRON4. Text in two columns, then the clip opens as it scrolls in and leads into About. -->
  <section class="apprenticeship" aria-labelledby="recent-heading" data-reveal>
    <div class="apprenticeship__text">
      <div class="recent">
        <h2 id="recent-heading">
          <a class="recent__org" href={site.bridgegood} target="_blank" rel="noopener noreferrer" aria-describedby="bridgegood-new-tab" translate="no">BRIDGEGOOD</a> UX Design Apprenticeship
        </h2>
        <span id="bridgegood-new-tab" class="visually-hidden">Opens in a new tab</span>
        <div class="recent__lines">
          <p>Launched by <span translate="no">Google.org</span> and the <span translate="no">Golden State Warriors</span>, with mentors from <span translate="no">Google</span>, <span translate="no">Meta</span>, and <span translate="no">YouTube</span>.</p>
          <p>
            The team built <span translate="no">AthenaScribe</span>, a translation tool with human review for <span translate="no">Oakland Unified</span> families,
            and presented it at Demo Day at <span translate="no">Block HQ</span>.
          </p>
        </div>
      </div>
      <div class="split__text">
        <h3 class="split__title" translate="no">Purpose to Pixels: BRIDGEGOOD on KRON4</h3>
        <p>
          Live with <span translate="no">BRIDGEGOOD</span>’s executive director, talking about open communication between Oakland
          families and their schools, and why design for social good matters.
        </p>
        <div class="actions">
          <Button href={site.kron4Video || undefined} variant="secondary" external>
            Watch on YouTube
          </Button>
        </div>
      </div>
    </div>
    <div class="apprenticeship__video">
      <KronClip opens />
    </div>
  </section>

  <!-- 4. About: the intro that used to sit at the top, the portrait, the coaching story, and the gym photos. -->
  <section id="about" class="about" aria-labelledby="about-heading" data-reveal>
    <div class="about__top">
      <div class="about__text">
        <p class="label">About</p>
        <h2 id="about-heading">From coaching systems to product design.</h2>
        <p class="about__lede">
          I’m a product designer with a background in Muay Thai, bringing a human centered mindset from the gym
          to the products I design. I focus on understanding people, solving real problems, and helping
          users reach their goals.
        </p>
        <div class="about__body">
          <p>
            My approach to teamwork was built through years of competing and coaching in martial arts. In
            my last role, I ran the fight team: recruiting fighters out of group classes, planning their
            camps and weight cuts, and getting them ready to compete.
          </p>
          <p>
            Competing taught me that close fights come down to the basics. Coaching taught me that every
            fighter uses those basics differently.
          </p>
          <p>
            On a design team, that means knowing the fundamentals cold and finding what each person does
            best. On your team, I will learn how everyone works and put my effort where it moves the whole
            group forward.
          </p>
        </div>
      </div>
      <Photo
        name="headshot"
        widths={[320, 480, 720]}
        sizes="(min-width: 48rem) 22rem, 70vw"
        cover={4 / 5}
        ratio="4 / 5"
        class="about__portrait"
      />
    </div>
    <figure class="about__figure">
      <div class="about__row">
        <div class="about__cell about__cell--tall">
          <Photo name="about-watch" widths={[400, 600, 800]} sizes="(min-width: 76rem) 20rem, (min-width: 48rem) 26vw, 46vw" ratio="4 / 5" class="about__photo about__photo--tall" />
        </div>
        <div class="about__cell about__cell--wide">
          <Photo name="about-pads" widths={[600, 900, 1280]} sizes="(min-width: 76rem) 35rem, (min-width: 48rem) 46vw, 92vw" ratio="7 / 5" class="about__photo about__photo--wide" />
        </div>
        <div class="about__cell about__cell--tall">
          <Photo name="about-camera" widths={[400, 600, 800]} sizes="(min-width: 76rem) 20rem, (min-width: 48rem) 26vw, 46vw" ratio="4 / 5" class="about__photo about__photo--tall" />
        </div>
      </div>
      <figcaption class="credit">Photos: BRIDGEGOOD</figcaption>
    </figure>
  </section>

  <!-- 5. Closing banner, navy in both themes: the whole group photo, then the invitation below it -->
  <section class="panel panel--dark panel--flush surface-always-dark banner" aria-labelledby="banner-heading" data-reveal>
    <figure class="banner__figure">
      <Photo name="group" widths={[800, 1280, 1920, 2560]} sizes="(min-width: 76rem) 72rem, 94vw" ratio="2000 / 1150" class="banner__photo" />
      <figcaption class="credit banner__credit">Photos: BRIDGEGOOD</figcaption>
    </figure>
    <div class="banner__content">
      <h2 id="banner-heading">Hiring an associate product designer?</h2>
      <p>
        I’m open to associate product design roles, especially on teams building for schools, families, or
        people short on time.
      </p>
      <ContactEmail class="banner__email" />
    </div>
  </section>
  </div>
</PageLayout>

<style>
  /* One stack: the same gap between every section, and before the footer. */
  .stack {
    display: grid;
    gap: var(--section-gap);
    padding-block: var(--section-gap);
  }

  /* Section panels on the page background (the closing banner). Square, like everything else. */
  .panel {
    border-radius: var(--radius-section);
    padding: var(--panel-padding);
  }

  .panel--dark {
    border: var(--rule-thin) solid var(--color-dark-panel-edge);
  }

  /* Media runs to the panel edges. */
  .panel--flush {
    padding: 0;
    overflow: hidden;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* 1. Name and one line. The name is the largest text on the site. */
  .hero {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-9) var(--space-6);
  }

  .hero h1 {
    font-size: var(--step-6);
    line-height: 0.95;
  }

  .hero__role {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink-muted);
  }

  /* Sections after the name open with a thin rule, like a page in a notebook. */
  .work,
  .apprenticeship,
  .about {
    padding-block-start: var(--space-6);
    border-block-start: var(--rule-thin) solid var(--color-rule);
  }

  /* 2. Selected work */
  .work {
    display: grid;
    gap: var(--space-6);
  }

  .work h2 {
    font-size: var(--step-4);
    margin-block-end: var(--space-2);
  }

  .work__grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 48rem) {
    .work__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* 3. BRIDGEGOOD and KRON4: two text columns, then the clip centered below. */
  .apprenticeship {
    display: grid;
    gap: var(--space-8);
  }

  .apprenticeship > * {
    min-width: 0;
  }

  .apprenticeship__text {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 64rem) {
    .apprenticeship__text {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  .apprenticeship__video {
    justify-self: center;
    inline-size: min(100%, var(--size-clip));
  }

  .recent {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .recent h2 {
    font-size: var(--step-3);
  }

  .recent__org {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: var(--rule-thick);
    text-underline-offset: var(--underline-offset);
  }

  .recent__org:hover {
    color: var(--color-accent);
  }

  .recent__lines {
    display: grid;
    gap: var(--space-3);
    max-width: var(--measure-reading);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  .split__text {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .split__title {
    font-size: var(--step-2);
  }

  /* 4. About: text and portrait, then one row of gym photos at equal heights. */
  .about {
    display: grid;
    gap: var(--space-8);
  }

  .about__top {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }

  .about__top > * {
    min-width: 0;
  }

  @media (min-width: 48rem) {
    .about__top {
      grid-template-columns: 1fr var(--size-portrait);
      gap: var(--space-8);
    }
  }

  .about__text {
    display: grid;
    gap: var(--space-5);
  }

  .about__text h2 {
    font-size: var(--step-4);
  }

  .about__lede {
    max-width: var(--measure-reading);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  .about__body {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure-reading);
    color: var(--color-ink-muted);
  }

  .about :global(.about__portrait) {
    display: block;
    inline-size: min(70%, var(--size-portrait));
    block-size: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-media);
  }

  @media (min-width: 48rem) {
    .about :global(.about__portrait) {
      inline-size: 100%;
    }
  }

  .about__figure {
    display: grid;
    gap: var(--space-3);
  }

  .about__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .about__row :global(.about__photo) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: var(--radius-media);
  }

  .about__row :global(.about__photo--tall) {
    aspect-ratio: 4 / 5;
  }

  .about__row :global(.about__photo--wide) {
    aspect-ratio: 7 / 5;
  }

  .about__cell {
    min-width: 0;
  }

  /* Phones and small tablets: the wide photo on top, the two tall ones below. */
  @media (max-width: 47.99rem) {
    .about__cell--wide {
      grid-column: 1 / -1;
      order: -1;
    }
  }

  @media (min-width: 48rem) {
    .about__row {
      grid-template-columns: var(--about-row);
    }
  }

  .credit {
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }

  /* 5. Closing banner: the photo shows whole, with nothing laid over it. */
  .banner__figure {
    display: grid;
    gap: var(--space-3);
  }

  /* Credit and text keep the panel padding; only the photo runs edge to edge. */
  .banner__credit {
    padding-inline: var(--panel-padding);
  }

  .banner :global(.banner__photo) {
    display: block;
    width: 100%;
    height: auto;
  }

  .banner__credit {
    text-align: end;
  }

  .banner__content {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    padding: var(--space-6) var(--panel-padding) var(--panel-padding);
    text-align: center;
  }

  .banner__content h2 {
    font-size: var(--step-4);
  }

  .banner__content p {
    max-width: var(--measure-reading);
  }

  .banner__content :global(.banner__email) {
    justify-content: center;
    margin-block-start: var(--space-2);
  }
</style>
