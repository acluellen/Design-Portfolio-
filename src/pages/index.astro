---
import PageLayout from "../layouts/PageLayout.astro";
import Button from "../components/site/Button.astro";
import Photo from "../components/site/Photo.astro";
import ContactEmail from "../components/site/ContactEmail.astro";
import KronClip from "../components/site/KronClip.astro";
import { site } from "../site.config";
import WorkCard from "../components/site/WorkCard.astro";
import { caseStudyHref, getAllCaseStudies } from "../lib/case-studies";

// Selected work: the featured case study as one large card, the rest below by `order`.
const studies = (await getAllCaseStudies()).filter((s) => s.data.card);
const featured = studies.find((s) => s.data.featured);
const others = studies.filter((s) => s !== featured);
---

<PageLayout title="Aaron Luellen" flushBottom footerEmail={false}>
  <!-- Every section sits in one stack with the same gap between them. -->
  <div class="container stack">
  <!-- 1. Hero -->
  <section class="hero">
    <Photo
      name="headshot"
      widths={[320, 480, 720, 960]}
      sizes="(min-width: 80rem) 26rem, (min-width: 48rem) 24vw, 70vw"
      cover={4 / 5}
      loading="eager"
      priority
      ratio="4 / 5"
      class="hero__portrait"
    />
    <div class="hero__text">
      <h1>Hi, I’m Aaron</h1>
      <p class="hero__lede">
        I’m a product designer with a background in Muay Thai, bringing a human centered mindset from the gym
        to the products I design. I focus on understanding people, solving real problems, and helping
        users reach their goals.
      </p>
      <div class="actions">
        <Button href="#work">View my work</Button>
        <Button href="#about" variant="secondary">About me</Button>
      </div>
    </div>
  </section>

  <!-- BRIDGEGOOD and the KRON4 clip, right under the hero: text left, clip right. Phones: text first. -->
  <section class="panel panel--light apprenticeship" aria-labelledby="recent-heading" data-reveal>
    <div class="apprenticeship__text">
      <div class="recent">
        <h2 id="recent-heading">
          <a class="recent__org" href={site.bridgegood} target="_blank" rel="noopener noreferrer" aria-describedby="bridgegood-new-tab" translate="no">BRIDGEGOOD</a> UX Design Apprenticeship
        </h2>
        <span id="bridgegood-new-tab" class="visually-hidden">Opens in a new tab</span>
        <div class="recent__lines">
          <p>Launched by <span translate="no">Google.org</span> and the <span translate="no">Golden State Warriors</span>, with mentors from <span translate="no">Google</span>, <span translate="no">Meta</span>, and <span translate="no">YouTube</span>.</p>
          <p>
            The team built <span translate="no">AthenaScribe</span>, a translation tool with human review for <span translate="no">Oakland Unified</span> families,
            and presented it at Demo Day at <span translate="no">Block HQ</span>.
          </p>
        </div>
      </div>
      <div class="split__text">
        <h3 class="split__title" translate="no">Purpose to Pixels: BRIDGEGOOD on KRON4</h3>
        <p>
          Live with <span translate="no">BRIDGEGOOD</span>’s executive director, talking about open communication between Oakland
          families and their schools, and why design for social good matters.
        </p>
        <div class="actions">
          <Button href={site.kron4Video || undefined} variant="secondary" external>
            Watch on YouTube
          </Button>
        </div>
      </div>
    </div>
    <div class="apprenticeship__video">
      <KronClip />
    </div>
  </section>

  <!-- 2. Selected work: one featured card, then smaller cards. Cards link only when published. -->
  <section id="work" class="work" aria-labelledby="work-heading" data-reveal>
    <h2 id="work-heading">Selected work</h2>
    {featured && <WorkCard study={featured} href={caseStudyHref(featured)} featured />}
    {
      others.length > 0 && (
        <div class="work__grid">
          {others.map((study) => (
            <WorkCard study={study} href={caseStudyHref(study)} />
          ))}
        </div>
      )
    }
  </section>

  <!-- 4. Coaching, always dark -->
  <section id="about" class="panel panel--dark surface-always-dark coaching" aria-labelledby="coaching-heading" data-reveal>
    <div class="coaching__inner">
      <div class="coaching__text">
        <h2 id="coaching-heading">From coaching systems to product design.</h2>
        <div class="coaching__body">
          <p>
            My approach to teamwork was built through years of competing and coaching in martial arts. In
            my last role, I ran the fight team: recruiting fighters out of group classes, planning their
            camps and weight cuts, and getting them ready to compete.
          </p>
          <p>
            Competing taught me that close fights come down to the basics. Coaching taught me that every
            fighter uses those basics differently.
          </p>
          <p>
            On a design team, that means knowing the fundamentals cold and finding what each person does
            best. On your team, I will learn how everyone works and put my effort where it moves the whole
            group forward.
          </p>
        </div>
      </div>
      <figure class="coaching__figure">
      <div class="coaching__photos">
        <Photo name="coaching-1" widths={[400, 600, 800]} sizes="(min-width: 64rem) 17rem, (min-width: 30rem) 46vw, 92vw" cover={4 / 5} class="coaching__photo" />
        <Photo name="coaching-2" widths={[400, 600, 800]} sizes="(min-width: 64rem) 17rem, (min-width: 30rem) 46vw, 92vw" cover={4 / 5} class="coaching__photo" />
      </div>
        <figcaption class="credit">Photos: BRIDGEGOOD</figcaption>
      </figure>
    </div>
  </section>

  <!-- 5. Closing banner, always dark: the whole group photo, then the invitation below it -->
  <section class="panel panel--dark panel--flush surface-always-dark banner" aria-labelledby="banner-heading" data-reveal>
    <figure class="banner__figure">
      <Photo name="group" widths={[800, 1280, 1920, 2560]} sizes="(min-width: 76rem) 72rem, 94vw" ratio="2000 / 1150" class="banner__photo" />
      <figcaption class="credit banner__credit">Photos: BRIDGEGOOD</figcaption>
    </figure>
    <div class="banner__content">
      <h2 id="banner-heading">Hiring an associate product designer?</h2>
      <p>
        I’m open to associate product design roles, especially on teams building for schools, families, or
        people short on time.
      </p>
      <ContactEmail class="banner__email" />
    </div>
  </section>
  </div>
</PageLayout>

<style>
  /* One stack: the same gap between every section, and before the footer. */
  .stack {
    display: grid;
    gap: var(--section-gap);
    padding-block: var(--section-gap);
  }

  /* Rounded section panels on the page background. All share --radius-section. */
  .panel {
    border-radius: var(--radius-section);
    padding: var(--panel-padding);
  }

  .panel--light {
    background: var(--color-paper-raised);
    border: var(--rule-thin) solid var(--color-rule);
  }

  .panel--dark {
    border: var(--rule-thin) solid var(--color-dark-panel-edge);
  }

  /* Media runs to the panel edges; the curve clips it. */
  .panel--flush {
    padding: 0;
    overflow: hidden;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* 1. Hero */
  /* Extra air above the hero only; the stack gap handles the space below it. */
  .hero {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    padding-block-start: var(--section-gap);
  }

  /* Portrait, chest up, 4:5, with the site's one curve. */
  .hero :global(.hero__portrait) {
    display: block;
    inline-size: min(100%, var(--size-portrait));
    block-size: auto;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-section);
    object-fit: cover;
  }

  .hero__text {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  .hero__text h1 {
    font-size: var(--step-5);
  }

  .hero__lede {
    max-width: var(--measure-reading);
    color: var(--color-ink-muted);
  }

  @media (max-width: 47.99rem) {
    .hero :global(.hero__portrait) {
      inline-size: 70%;
    }
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: var(--size-portrait) 1fr;
      gap: var(--space-8);
    }
  }

  /* 3. BRIDGEGOOD and KRON4: one panel, text left and video right. Stacks text first. */
  .apprenticeship {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .apprenticeship > * {
    min-width: 0;
  }

  .apprenticeship__text {
    display: grid;
    gap: var(--space-7);
  }

  /* Stacked (phones and small tablets): the clip comes first, above the text. */
  @media (max-width: 63.99rem) {
    .apprenticeship__video {
      order: -1;
    }
  }

  @media (min-width: 64rem) {
    .apprenticeship {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  .recent {
    display: grid;
    gap: var(--space-5);
  }

  /* About half the size of "Hi, I'm Aaron", so the name stays the biggest text on the page. */
  .recent h2 {
    font-size: var(--step-2);
  }

  @media (min-width: 48rem) {
    .recent h2 {
      font-size: var(--step-3);
    }
  }

  .recent__org {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: var(--rule-thick);
    text-underline-offset: var(--underline-offset);
  }

  .recent__org:hover {
    color: var(--color-accent);
  }

  .recent__lines {
    display: grid;
    gap: var(--space-3);
    max-width: var(--measure-reading);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  .split__text {
    display: grid;
    gap: var(--space-4);
  }

  .split__title {
    font-size: var(--step-2);
  }

  /* 2. Selected work */
  .work {
    display: grid;
    gap: var(--space-6);
  }

  .work h2 {
    font-size: var(--step-4);
    margin-block-end: var(--space-2);
  }

  .work__grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 48rem) {
    .work__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* 4. Coaching */
  .coaching__inner {
    display: grid;
    gap: var(--space-8);
  }

  .coaching__text {
    display: grid;
    gap: var(--space-7);
    align-content: start;
    min-width: 0;
  }

  .coaching__text h2 {
    font-size: var(--step-4);
  }

  .coaching__body {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure-reading);
  }

  .coaching__figure {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-width: 0;
  }

  .credit {
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }

  .coaching__photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    align-content: start;
    min-width: 0;
  }

  /* Two portrait crops side by side. */
  .coaching__photos :global(.coaching__photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-media);
  }

  @media (min-width: 64rem) {
    .coaching__inner {
      grid-template-columns: 5fr 6fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 30rem) {
    .coaching__photos {
      grid-template-columns: 1fr;
    }
  }

  /* 5. Closing banner: the photo shows whole, with nothing laid over it. */
  .banner__figure {
    display: grid;
    gap: var(--space-3);
  }

  /* Credit and text keep the panel padding; only the photo runs edge to edge. */
  .banner__credit {
    padding-inline: var(--panel-padding);
  }

  .banner :global(.banner__photo) {
    display: block;
    width: 100%;
    height: auto;
  }

  .banner__credit {
    text-align: end;
  }

  .banner__content {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    padding: var(--space-6) var(--panel-padding) var(--panel-padding);
    text-align: center;
  }

  .banner__content h2 {
    font-size: var(--step-4);
  }

  .banner__content p {
    max-width: var(--measure-reading);
  }

  .banner__content :global(.banner__email) {
    justify-content: center;
    margin-block-start: var(--space-2);
  }
</style>
