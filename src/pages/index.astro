---
import PageLayout from "../layouts/PageLayout.astro";
import { mailto, site } from "../site.config";
import fs from "node:fs";
import WorkTile from "../components/site/WorkTile.astro";
import { caseStudyHref, getAllCaseStudies } from "../lib/case-studies";

// Selected work: every case study with a card, as equal tiles in two columns, by `order` (Micah Hoang).
const studies = (await getAllCaseStudies()).filter((s) => s.data.card);
// The Resume link goes live once public/resume.pdf exists; until then it shows as plain text.
const hasResume = fs.existsSync(new URL("../../public/resume.pdf", import.meta.url));
const year = new Date().getFullYear();
---

<PageLayout title="Aaron Luellen" flushBottom contact>
  <!-- Every section sits in one stack with the same gap between them. -->
  <div class="container stack">
  <!-- 1. Name, one line, and a links row. Nothing else, so it reads like a simple editorial page. -->
  <section class="hero" aria-labelledby="hero-heading">
    <h1 id="hero-heading" translate="no">Aaron Luellen</h1>
    <p class="hero__role">Product designer focused on clarity.</p>
    <!-- Links on the left, the year on the right, just above the Selected work line. -->
    <div class="hero__row">
      <ul class="hero__links" aria-label="Links">
        <li>{site.linkedin ? <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a> : <span>LinkedIn</span>}</li>
        <li>{hasResume ? <a href={site.resumePath}>Resume</a> : <span>Resume</span>}</li>
        <li><a href={mailto}>Email</a></li>
      </ul>
      <p class="hero__year">©{year}</p>
    </div>
  </section>

  <!-- 2. Selected work as equal image tiles, two per row. Tiles link only when published. -->
  <section id="work" class="work" aria-labelledby="work-heading" data-reveal>
    <h2 id="work-heading">Selected work</h2>
    <div class="work__grid">
      {studies.map((study, i) => <WorkTile study={study} href={caseStudyHref(study)} index={i + 1} />)}
    </div>
  </section>

  <!-- 3. About: a large heading like "Selected work", then a small photo on the left (placeholder for
       now) with the blurb and the link beside it. The apprenticeship, the KRON4 clip, and the gym
       photos live on the About page. -->
  <section id="about" class="about" aria-labelledby="about-heading" data-reveal>
    <h2 id="about-heading" class="visually-hidden">About Aaron</h2>
    <div class="about__body">
      <div class="about__media" aria-hidden="true">
        <span>Photo</span>
      </div>
      <div class="about__text">
        <p class="about__blurb">
          I’m interested in the small details that can change someone’s entire experience. The explanation
          that finally makes sense, the unexpected moment of confusion, or the reason someone decides to
          keep going.
        </p>
        <p class="about__blurb">
          Research gives me a way to understand those moments and bring what I learn into design.
        </p>
        <a class="about__more" href="/about/">Read more<span class="visually-hidden"> about Aaron</span></a>
      </div>
    </div>
  </section>
  </div>
</PageLayout>

<script>
  // Section lines draw left to right each time the line itself comes into view, and reset once it
  // leaves the screen, so they replay on every pass. Without motion (reduced motion setting) the
  // lines simply show.
  const motion = window.matchMedia("(prefers-reduced-motion: no-preference)");
  const ruled = [...document.querySelectorAll<HTMLElement>(".work, .about")];
  if (motion.matches && ruled.length > 0) {
    document.documentElement.classList.add("rules-ready");
    let queued = false;
    const check = () => {
      queued = false;
      const height = window.innerHeight;
      for (const el of ruled) {
        // The line sits on the section's top edge.
        const top = el.getBoundingClientRect().top;
        // Draws once the line is a quarter of the way up the screen, where the eye is.
        if (top >= 0 && top <= height * 0.75) el.classList.add("is-drawn");
        else if (top < 0 || top > height) el.classList.remove("is-drawn");
      }
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(check);
      }
    };
    // A line already on screen at load waits for the page to load and its section to finish
    // fading in, so the draw is seen.
    // The build may write the token in seconds (".6s") or milliseconds.
    const token = getComputedStyle(document.documentElement).getPropertyValue("--duration-reveal").trim();
    const reveal = (parseFloat(token) || 0) * (token.endsWith("ms") ? 1 : 1000);
    const start = () =>
      window.setTimeout(() => {
        check();
        window.addEventListener("scroll", queue, { passive: true });
        window.addEventListener("resize", queue, { passive: true });
      }, reveal);
    if (document.readyState === "complete") start();
    else window.addEventListener("load", start, { once: true });
  }
</script>

<style>
  /* One stack: the same gap between every section, and before the footer. */
  .stack {
    display: grid;
    gap: var(--section-gap);
    padding-block: var(--space-page-top) var(--section-gap);
  }

  /* 1. Name and one line close under the header, then the links row with the year at its right
     end. The hero pulls the next section up so that row sits just above the Selected work line. */
  .hero {
    display: grid;
    gap: var(--space-5);
    margin-block-end: calc(0px - var(--section-gap));
  }

  /* The name, set like a wordmark: the heaviest weight, tight letter spacing. */
  .hero h1 {
    font-size: var(--step-6);
    font-weight: var(--weight-wordmark);
    letter-spacing: var(--tracking-wordmark);
    line-height: 0.95;
  }

  /* Light, so the name carries the weight. */
  /* Small and regular on two short lines (Micah Hoang), so the name and the work carry the page. */
  .hero__role {
    max-width: var(--measure-role);
    font-family: var(--font-display);
    font-weight: var(--weight-regular);
    font-size: var(--size-role);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-heading);
  }

  /* Links left, year right. Mono, like the labels. */
  .hero__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-5);
    margin-block-start: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  /* One comma separated line, every item the same ink (Micah Hoang). Underline on hover only. */
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__links a,
  .hero__links span {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-height);
  }

  .hero__links a,
  .hero__links span {
    color: var(--color-ink);
    text-decoration: none;
  }

  .hero__links a:hover {
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .hero__links li:not(:last-child)::after {
    content: ",";
    color: var(--color-ink);
  }

  .hero__links li {
    display: inline-flex;
    align-items: center;
  }

  /* Sections after the name open with a thin rule across the content column. As the line scrolls
     into view it draws from left to right (Micah Hoang). With reduced motion, or before the script
     runs, it simply shows. */
  .work,
  .about {
    position: relative;
    padding-block-start: var(--space-6);
  }

  .work::before,
  .about::before {
    content: "";
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    border-block-start: var(--rule-thin) solid var(--color-rule-section);
    transform-origin: left center;
  }

  /* The draw replays every time the line comes back into view (Micah Hoang). The script above
     adds .is-drawn on the way in and removes it once the line has left the screen. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.rules-ready) .work:not(.is-drawn)::before,
    :global(.rules-ready) .about:not(.is-drawn)::before {
      transform: scaleX(0);
    }

    .work.is-drawn::before,
    .about.is-drawn::before {
      animation: rule-draw var(--duration-rule-draw) var(--ease-roll) both;
    }
  }

  @keyframes rule-draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* 2. Selected work: equal tiles, two side by side from 48rem. */
  .work {
    display: grid;
    gap: var(--gap-section-heading);
  }

  .work h2 {
    font-size: var(--step-4);
    font-weight: var(--weight-light);
  }

  .work__grid {
    display: grid;
    gap: var(--gap-tile-row) var(--gap-tile-column);
  }

  @media (min-width: 48rem) {
    .work__grid {
      grid-template-columns: 1fr 1fr;
      row-gap: var(--space-7);
    }
  }

  /* 3. About: the heading matches "Selected work". Below it the photo takes a quarter of the width
     with the text beside it, both aligned to the top. Phones: the photo above the text. */
  /* No visible heading (Micah Hoang): the line, then the photo and blurb. The heading stays for
     screen readers. */
  .about {
    display: grid;
    padding-block-start: var(--space-9);
  }

  .about h2 {
    font-size: var(--step-4);
    font-weight: var(--weight-light);
  }

  .about__body {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  /* Small photo with the blurb right beside it, from 40rem. */
  @media (min-width: 40rem) {
    .about__body {
      grid-template-columns: var(--size-about-photo) 1fr;
      column-gap: var(--space-5);
    }
  }

  .about__media {
    display: grid;
    place-items: center;
    inline-size: min(100%, var(--size-about-photo-phone));
    aspect-ratio: var(--ratio-about-photo);
    background: var(--color-placeholder);
    border-radius: var(--radius-media);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  @media (min-width: 40rem) {
    .about__media {
      inline-size: 100%;
    }
  }

  .about__text {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  /* Light like the hero subtitle, one step smaller (Micah Hoang's scale). The first line sits level
     with the photo's top. */
  .about__blurb {
    max-width: var(--measure-about);
    margin-block-start: 0;
    font-family: var(--font-text);
    font-weight: var(--weight-regular);
    font-size: var(--size-about-text);
    line-height: var(--leading-about);
    color: var(--color-ink);
    text-wrap: pretty;
  }

  /* Plain small mono capitals in the main text color. Underline on hover only. */
  .about__blurb:first-child {
    margin-block-start: calc((1lh - 1cap) / -2);
  }

  .about__more {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-height);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
  }

  .about__more:hover {
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }
</style>
