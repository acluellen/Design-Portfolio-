---
import PageLayout from "../layouts/PageLayout.astro";
import Button from "../components/site/Button.astro";
import Photo from "../components/site/Photo.astro";
import VideoEmbed from "../components/site/VideoEmbed.astro";
import WorkCarousel from "../components/site/WorkCarousel.astro";
import { site } from "../site.config";
---

<PageLayout title="Aaron Luellen" flushBottom>
  <!-- 1. Hero -->
  <section class="container hero">
    <Photo
      name="headshot"
      widths={[240, 480, 720]}
      sizes="clamp(9rem, 6rem + 10vw, 14rem)"
      cover={1}
      loading="eager"
      ratio="1 / 1"
      class="hero__headshot"
    />
    <div class="hero__text">
      <h1>Hi, I’m Aaron</h1>
      <p class="hero__lede">
        I’m a product designer with a background in MMA, bringing a human centered mindset from the gym
        to the products I design. I focus on understanding people, solving real problems, and helping
        users reach their goals.
      </p>
      <div class="actions">
        <Button href="#work">View My Work</Button>
        <Button href="/about/" variant="secondary">About Me</Button>
      </div>
    </div>
  </section>

  <!-- 2. Most recently -->
  <section class="band" aria-labelledby="recent-heading">
    <div class="container band__inner">
      <div class="recent">
        <h2 id="recent-heading">Most recently,</h2>
        <p>
          I attended the BridgeGood UX Design Apprenticeship, a program launched by Google and the Golden
          State Warriors, with mentors from Meta, PayPal, and Adobe. The team built AthenaScribe, an AI
          translation platform for families of Oakland Unified School District receiving school documents
          they could not read, then presented it at Demo Day at Block HQ.
        </p>
      </div>
      <div class="split split--media">
        <VideoEmbed
          url={site.kron4Video}
          title="Purpose to Pixels: BridgeGood on KRON4"
          cover="kron4-cover"
          sizes="(min-width: 76rem) 37rem, (min-width: 56rem) 52vw, 92vw"
        />
        <div class="split__text">
          <h3 class="split__title">Purpose to Pixels: BridgeGood on KRON4</h3>
          <p>
            Live with BridgeGood’s executive director, talking about open communication between Oakland
            families and their schools, and why design for social good matters.
          </p>
          <div class="actions">
            <Button href={site.kron4Video || undefined} variant="secondary" external>
              Watch on YouTube
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Selected Work -->
  <WorkCarousel heading="Selected Work" />

  <!-- 4. Coaching, always dark -->
  <section class="surface-always-dark coaching" aria-labelledby="coaching-heading">
    <div class="container coaching__inner">
      <div class="coaching__text">
        <h2 id="coaching-heading">From coaching systems to Product Design.</h2>
        <div class="coaching__body">
          <p>
            My approach to teamwork was built through years of competing and coaching in martial arts. In
            my last role, I ran the fight team: recruiting fighters out of group classes, planning their
            camps and weight cuts, and getting them ready to compete.
          </p>
          <p>
            Competing taught me that close fights come down to the basics. Coaching taught me that every
            fighter uses those basics differently.
          </p>
          <p>
            On a design team, that means knowing the fundamentals cold and finding what each person does
            best. On your team, I will learn how everyone works and put my effort where it moves the whole
            group forward.
          </p>
        </div>
      </div>
      <figure class="coaching__figure">
      <div class="coaching__photos">
        <Photo name="coaching-1" widths={[400, 600, 800]} sizes="(min-width: 64rem) 17rem, (min-width: 30rem) 46vw, 92vw" cover={4 / 5} class="coaching__photo" />
        <Photo name="coaching-2" widths={[400, 600, 800]} sizes="(min-width: 64rem) 17rem, (min-width: 30rem) 46vw, 92vw" cover={4 / 5} class="coaching__photo" />
        <Photo name="coaching-3" widths={[640, 960, 1280]} sizes="(min-width: 64rem) 34rem, 92vw" cover={16 / 9} class="coaching__photo coaching__photo--wide" />
      </div>
        <figcaption class="credit">Photos: BRIDGEGOOD</figcaption>
      </figure>
    </div>
  </section>

  <!-- 5. Closing banner, always dark: the whole group photo, then the invitation below it -->
  <section class="surface-always-dark banner" aria-labelledby="banner-heading">
    <figure class="banner__figure">
      <Photo name="group" widths={[800, 1280, 1920, 2560]} sizes="100vw" ratio="2000 / 1150" class="banner__photo" />
      <figcaption class="container credit banner__credit">Photos: BRIDGEGOOD</figcaption>
    </figure>
    <div class="container banner__content">
      <h2 id="banner-heading">Interested in working together?</h2>
      <p>
        I’m open to Product Design opportunities where research, product thinking, and clear interaction
        design can help make complicated systems easier to use.
      </p>
      <div class="actions actions--center">
        <Button href="#work">View My Work</Button>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  section {
    scroll-margin-top: var(--space-5);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .actions--center {
    justify-content: center;
  }

  /* 1. Hero */
  .hero {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    padding-block: var(--space-9);
  }

  .hero :global(.hero__headshot) {
    inline-size: var(--size-headshot);
    block-size: var(--size-headshot);
    border-radius: var(--radius-pill);
    object-fit: cover;
    object-position: 50% 30%;
  }

  .hero__text {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  .hero__text h1 {
    font-size: var(--step-5);
  }

  .hero__lede {
    max-width: var(--measure-reading);
    color: var(--color-ink-muted);
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: auto 1fr;
      gap: var(--space-8);
    }
  }

  /* 2. Most recently */
  .band {
    background: var(--color-band);
  }

  .band__inner {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-9);
  }

  .recent {
    display: grid;
    gap: var(--space-5);
  }

  .recent h2 {
    font-size: var(--step-4);
  }

  .recent p {
    max-width: var(--measure-reading);
  }

  .split {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .split > * {
    min-width: 0;
  }

  .split__text {
    display: grid;
    gap: var(--space-5);
  }

  .split__title {
    font-size: var(--step-3);
  }

  @media (min-width: 56rem) {
    .split--media {
      grid-template-columns: 7fr 5fr;
      gap: var(--space-8);
    }
  }

  /* 4. Coaching */
  .coaching__inner {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-9);
  }

  .coaching__text {
    display: grid;
    gap: var(--space-7);
    align-content: start;
    min-width: 0;
  }

  .coaching__text h2 {
    font-size: var(--step-4);
  }

  .coaching__body {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure-reading);
  }

  .coaching__figure {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-width: 0;
  }

  .credit {
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }

  .coaching__photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    align-content: start;
    min-width: 0;
  }

  /* Two portrait crops on top, one wide photo below. */
  .coaching__photos :global(.coaching__photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-media);
  }

  .coaching__photos :global(.coaching__photo--wide) {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }

  /* Real photos sit inside <picture>, which is the actual grid item. */
  .coaching__photos > :global(picture:has(.coaching__photo--wide)) {
    grid-column: 1 / -1;
  }

  @media (min-width: 64rem) {
    .coaching__inner {
      grid-template-columns: 5fr 6fr;
      gap: var(--space-9);
    }
  }

  @media (max-width: 30rem) {
    .coaching__photos {
      grid-template-columns: 1fr;
    }
  }

  /* 5. Closing banner: the photo shows whole, with nothing laid over it. */
  .banner__figure {
    display: grid;
    gap: var(--space-3);
  }

  .banner :global(.banner__photo) {
    display: block;
    width: 100%;
    height: auto;
  }

  .banner__credit {
    text-align: end;
  }

  .banner__content {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    padding-block: var(--space-8) var(--space-9);
    text-align: center;
  }

  .banner__content h2 {
    font-size: var(--step-4);
  }

  .banner__content p {
    max-width: var(--measure-reading);
  }
</style>
