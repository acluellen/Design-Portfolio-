---
import PageLayout from "../layouts/PageLayout.astro";
import Button from "../components/site/Button.astro";
import Photo from "../components/site/Photo.astro";
import VideoEmbed from "../components/site/VideoEmbed.astro";
import WorkCard from "../components/site/WorkCard.astro";
import { caseStudyHref, getAllCaseStudies } from "../lib/case-studies";
import { mailto, site } from "../site.config";

// Selected work: the featured case study as one large card, the rest below by `order`.
const studies = (await getAllCaseStudies()).filter((s) => s.data.card);
const featured = studies.find((s) => s.data.featured);
const others = studies.filter((s) => s !== featured);
---

<PageLayout title="Aaron Luellen" flushBottom>
  <!-- Every section sits in one stack with the same gap between them. -->
  <div class="container stack">
  <!-- 1. Hero -->
  <section class="hero">
    <Photo
      name="headshot"
      widths={[240, 480, 720]}
      sizes="clamp(9rem, 6rem + 10vw, 14rem)"
      cover={1}
      loading="eager"
      ratio="1 / 1"
      class="hero__headshot"
    />
    <div class="hero__text">
      <h1>Hi, I’m Aaron</h1>
      <p class="hero__lede">
        I’m a product designer with a background in MMA, bringing a human centered mindset from the gym
        to the products I design. I focus on understanding people, solving real problems, and helping
        users reach their goals.
      </p>
      <div class="actions">
        <Button href="#work">View my work</Button>
        <Button href="#about" variant="secondary">About me</Button>
      </div>
    </div>
  </section>

  <!-- 2. BRIDGEGOOD apprenticeship -->
  <section class="panel panel--light" aria-labelledby="recent-heading" data-reveal>
    <div class="band__inner">
      <div class="recent">
        <h2 id="recent-heading">
          <a class="recent__org" href={site.bridgegood} target="_blank" rel="noopener noreferrer">BRIDGEGOOD<span class="visually-hidden"> (opens in a new tab)</span></a> UX Design Apprenticeship
        </h2>
        <div class="recent__lines">
          <p>Launched by Google.org and the Golden State Warriors, with mentors from Google, Meta, and YouTube.</p>
          <p>
            The team built AthenaScribe, a translation tool with human review for Oakland Unified families,
            and presented it at Demo Day at Block HQ.
          </p>
        </div>
      </div>
      <div class="split split--media">
        <VideoEmbed
          url={site.kron4Video}
          title="Purpose to Pixels: BRIDGEGOOD on KRON4"
          cover="kron4-cover"
          sizes="(min-width: 76rem) 37rem, (min-width: 56rem) 52vw, 92vw"
        />
        <div class="split__text">
          <h3 class="split__title">Purpose to Pixels: BRIDGEGOOD on KRON4</h3>
          <p>
            Live with BRIDGEGOOD’s executive director, talking about open communication between Oakland
            families and their schools, and why design for social good matters.
          </p>
          <div class="actions">
            <Button href={site.kron4Video || undefined} variant="secondary" external>
              Watch on YouTube
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Selected work: one featured card, then smaller cards. Cards link only when published. -->
  <section id="work" class="work" aria-labelledby="work-heading" data-reveal>
    <h2 id="work-heading">Selected work</h2>
    {featured && <WorkCard study={featured} href={caseStudyHref(featured)} featured />}
    {
      others.length > 0 && (
        <div class="work__grid">
          {others.map((study) => (
            <WorkCard study={study} href={caseStudyHref(study)} />
          ))}
        </div>
      )
    }
  </section>

  <!-- 4. Coaching, always dark -->
  <section id="about" class="panel panel--dark surface-always-dark coaching" aria-labelledby="coaching-heading" data-reveal>
    <div class="coaching__inner">
      <div class="coaching__text">
        <h2 id="coaching-heading">From coaching systems to product design.</h2>
        <div class="coaching__body">
          <p>
            My approach to teamwork was built through years of competing and coaching in martial arts. In
            my last role, I ran the fight team: recruiting fighters out of group classes, planning their
            camps and weight cuts, and getting them ready to compete.
          </p>
          <p>
            Competing taught me that close fights come down to the basics. Coaching taught me that every
            fighter uses those basics differently.
          </p>
          <p>
            On a design team, that means knowing the fundamentals cold and finding what each person does
            best. On your team, I will learn how everyone works and put my effort where it moves the whole
            group forward.
          </p>
        </div>
      </div>
      <figure class="coaching__figure">
      <div class="coaching__photos">
        <Photo name="coaching-1" widths={[400, 600, 800]} sizes="(min-width: 64rem) 17rem, (min-width: 30rem) 46vw, 92vw" cover={4 / 5} class="coaching__photo" />
        <Photo name="coaching-2" widths={[400, 600, 800]} sizes="(min-width: 64rem) 17rem, (min-width: 30rem) 46vw, 92vw" cover={4 / 5} class="coaching__photo" />
        <Photo name="coaching-3" widths={[640, 960, 1280]} sizes="(min-width: 64rem) 34rem, 92vw" cover={16 / 9} class="coaching__photo coaching__photo--wide" />
      </div>
        <figcaption class="credit">Photos: BRIDGEGOOD</figcaption>
      </figure>
    </div>
  </section>

  <!-- 5. Closing banner, always dark: the whole group photo, then the invitation below it -->
  <section class="panel panel--dark panel--flush surface-always-dark banner" aria-labelledby="banner-heading" data-reveal>
    <figure class="banner__figure">
      <Photo name="group" widths={[800, 1280, 1920, 2560]} sizes="(min-width: 76rem) 72rem, 94vw" ratio="2000 / 1150" class="banner__photo" />
      <figcaption class="credit banner__credit">Photos: BRIDGEGOOD</figcaption>
    </figure>
    <div class="banner__content">
      <h2 id="banner-heading">Interested in working together?</h2>
      <p>
        I’m open to Product Design opportunities where research, product thinking, and clear interaction
        design can help make complicated systems easier to use.
      </p>
      <div class="actions actions--center">
        <Button href={mailto}>Email me</Button>
      </div>
    </div>
  </section>
  </div>
</PageLayout>

<style>
  /* One stack: the same gap between every section, and before the footer. */
  .stack {
    display: grid;
    gap: var(--section-gap);
    padding-block: var(--section-gap);
  }

  /* Rounded section panels on the page background. All share --radius-section. */
  .panel {
    border-radius: var(--radius-section);
    padding: var(--panel-padding);
  }

  .panel--light {
    background: var(--color-paper-raised);
    border: var(--rule-thin) solid var(--color-rule);
  }

  .panel--dark {
    border: var(--rule-thin) solid var(--color-dark-panel-edge);
  }

  /* Media runs to the panel edges; the curve clips it. */
  .panel--flush {
    padding: 0;
    overflow: hidden;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .actions--center {
    justify-content: center;
  }

  /* 1. Hero */
  /* Extra air above the hero only; the stack gap handles the space below it. */
  .hero {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    padding-block-start: var(--section-gap);
  }

  .hero :global(.hero__headshot) {
    inline-size: var(--size-headshot);
    block-size: var(--size-headshot);
    border-radius: var(--radius-pill);
    object-fit: cover;
    object-position: 50% 30%;
    transition: transform var(--duration-reveal) var(--ease-standard);
  }

  /* Small lift on hover. --lift-headshot is 0 with reduced motion. */
  .hero :global(.hero__headshot:hover) {
    transform: translateY(calc(-1 * var(--lift-headshot)));
  }

  .hero__text {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  .hero__text h1 {
    font-size: var(--step-5);
  }

  .hero__lede {
    max-width: var(--measure-reading);
    color: var(--color-ink-muted);
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: auto 1fr;
      gap: var(--space-8);
    }
  }

  /* 2. BRIDGEGOOD apprenticeship */
  .band__inner {
    display: grid;
    gap: var(--space-8);
  }

  .recent {
    display: grid;
    gap: var(--space-5);
  }

  /* About half the size of "Hi, I'm Aaron", so the name stays the biggest text on the page. */
  .recent h2 {
    font-size: var(--step-2);
  }

  @media (min-width: 48rem) {
    .recent h2 {
      font-size: var(--step-3);
    }
  }

  .recent__org {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: var(--rule-thick);
    text-underline-offset: var(--underline-offset);
  }

  .recent__org:hover {
    color: var(--color-accent);
  }

  .recent__lines {
    display: grid;
    gap: var(--space-3);
    max-width: var(--measure-reading);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  .split {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .split > * {
    min-width: 0;
  }

  .split__text {
    display: grid;
    gap: var(--space-5);
  }

  .split__title {
    font-size: var(--step-3);
  }

  @media (min-width: 56rem) {
    .split--media {
      grid-template-columns: 7fr 5fr;
      gap: var(--space-8);
    }
  }

  /* 3. Selected work */
  .work {
    display: grid;
    gap: var(--space-6);
  }

  .work h2 {
    font-size: var(--step-4);
    margin-block-end: var(--space-2);
  }

  .work__grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 48rem) {
    .work__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* 4. Coaching */
  .coaching__inner {
    display: grid;
    gap: var(--space-8);
  }

  .coaching__text {
    display: grid;
    gap: var(--space-7);
    align-content: start;
    min-width: 0;
  }

  .coaching__text h2 {
    font-size: var(--step-4);
  }

  .coaching__body {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure-reading);
  }

  .coaching__figure {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-width: 0;
  }

  .credit {
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }

  .coaching__photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    align-content: start;
    min-width: 0;
  }

  /* Two portrait crops on top, one wide photo below. */
  .coaching__photos :global(.coaching__photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-media);
  }

  .coaching__photos :global(.coaching__photo--wide) {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }

  /* Real photos sit inside <picture>, which is the actual grid item. */
  .coaching__photos > :global(picture:has(.coaching__photo--wide)) {
    grid-column: 1 / -1;
  }

  @media (min-width: 64rem) {
    .coaching__inner {
      grid-template-columns: 5fr 6fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 30rem) {
    .coaching__photos {
      grid-template-columns: 1fr;
    }
  }

  /* 5. Closing banner: the photo shows whole, with nothing laid over it. */
  .banner__figure {
    display: grid;
    gap: var(--space-3);
  }

  /* Credit and text keep the panel padding; only the photo runs edge to edge. */
  .banner__credit {
    padding-inline: var(--panel-padding);
  }

  .banner :global(.banner__photo) {
    display: block;
    width: 100%;
    height: auto;
  }

  .banner__credit {
    text-align: end;
  }

  .banner__content {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    padding: var(--space-6) var(--panel-padding) var(--panel-padding);
    text-align: center;
  }

  .banner__content h2 {
    font-size: var(--step-4);
  }

  .banner__content p {
    max-width: var(--measure-reading);
  }
</style>
