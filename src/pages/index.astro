---
// Phase 1 placeholder. Phase 3 replaces this with the real home page.
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCaseStudies } from "../lib/case-studies";

const studies = await getCaseStudies();
---

<BaseLayout title="Aaron">
  <main class="container">
    <div class="reading flow" style="padding-block: var(--space-9)">
      <p class="label">Scaffold check</p>
      <h1>Research led product design, set in calm type.</h1>
      <p>
        This page exists to check the base layout, fonts, and tokens. Headlines use Source Serif 4. Body
        text uses Inter. Links like <a href="#">this one</a> use the single terracotta accent.
      </p>
      <hr />
      <h2>Second level heading</h2>
      <p>
        Body copy sits in a reading column of about 68 characters, with generous line height and thin
        rules in place of shadowed cards.
      </p>
      <blockquote>A quote set in the display face, for scale.</blockquote>
      <h3>Third level heading</h3>
      <ul>
        <li>List item one</li>
        <li>List item two</li>
      </ul>
      <hr />
      <p class="label">Case studies in the collection: {studies.length}</p>
    </div>
  </main>
</BaseLayout>
