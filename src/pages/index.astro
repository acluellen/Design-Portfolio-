---
import PageLayout from "../layouts/PageLayout.astro";
import Photo from "../components/site/Photo.astro";
import ContactEmail from "../components/site/ContactEmail.astro";
import KronClip from "../components/site/KronClip.astro";
import { mailto, site } from "../site.config";
import fs from "node:fs";
import WorkCard from "../components/site/WorkCard.astro";
import { caseStudyHref, getAllCaseStudies } from "../lib/case-studies";

// Selected work: the featured case study as one large card, the rest below by `order`.
const studies = (await getAllCaseStudies()).filter((s) => s.data.card);
const featured = studies.find((s) => s.data.featured);
const others = studies.filter((s) => s !== featured);
// The Resume link goes live once public/resume.pdf exists; until then it shows as plain text.
const hasResume = fs.existsSync(new URL("../../public/resume.pdf", import.meta.url));
---

<PageLayout title="Aaron Luellen" flushBottom footerEmail={false}>
  <!-- Every section sits in one stack with the same gap between them. -->
  <div class="container stack">
  <!-- 1. Name, one line, a meta line (Zeel Shah), and a links row (Micah Hoang). No photo, no buttons. -->
  <section class="hero" aria-labelledby="hero-heading">
    <h1 id="hero-heading" translate="no">Aaron Luellen</h1>
    <p class="hero__role">Research led product designer.</p>
    <p class="hero__meta">2 years · EdTech · Health · Climate</p>
    <ul class="hero__links" aria-label="Links">
      <li>{site.linkedin ? <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a> : <span>LinkedIn</span>}</li>
      <li>{hasResume ? <a href={site.resumePath}>Resume</a> : <span>Resume</span>}</li>
      <li><a href={mailto}>Email</a></li>
    </ul>
  </section>

  <!-- 2. Selected work, right after the name: one featured card, then smaller cards. Cards link only when published. -->
  <section id="work" class="work" aria-labelledby="work-heading" data-reveal>
    <h2 id="work-heading">Selected work</h2>
    {featured && <WorkCard study={featured} href={caseStudyHref(featured)} featured index={1} />}
    {
      others.length > 0 && (
        <div class="work__grid">
          {others.map((study, i) => (
            <WorkCard study={study} href={caseStudyHref(study)} index={i + (featured ? 2 : 1)} />
          ))}
        </div>
      )
    }
  </section>

  <!-- 3. About, centered (Zeel Shah's hero feel), in Aaron's order: the apprenticeship, him on air,
       then coaching in one line. One image. Each fact is said once; the full story is on /about/. -->
  <section id="about" class="about" aria-labelledby="about-heading" data-reveal>
    <p class="label">About</p>
    <h2 id="about-heading">I completed the <span translate="no">BRIDGEGOOD</span> UX Design <mark class="highlight">Apprenticeship</mark>.</h2>
    <p class="about__lede">
      A summer program launched by <span translate="no">Google.org</span> and the <span translate="no">Golden State Warriors</span>, with mentors from <span translate="no">Google</span>, <span translate="no">Meta</span>, and <span translate="no">YouTube</span>.
    </p>
    <p class="about__meta">June to August 2026</p>

    <div class="about__clip">
      <KronClip opens>
        <span>On <span translate="no">KRON4</span></span>
        {site.kron4Video && <a href={site.kron4Video} target="_blank" rel="noopener noreferrer">Watch on YouTube<span class="visually-hidden"> (opens in a new tab)</span></a>}
      </KronClip>
    </div>

    <p class="about__coach">Before design, I ran a Muay Thai fight team.</p>
    <a class="about__more" href="/about/">Read more about me</a>
  </section>

  <!-- 4. Closing banner, navy in both themes: the group photo centered at the clip width, then the invitation. -->
  <section class="panel panel--dark surface-always-dark banner" aria-labelledby="banner-heading" data-reveal>
    <figure class="banner__figure">
      <Photo name="group" widths={[700, 1100, 1400]} sizes="(min-width: 48rem) 44rem, 88vw" ratio="2000 / 1150" class="banner__photo" />
      <figcaption class="credit banner__credit">Photos: BRIDGEGOOD</figcaption>
    </figure>
    <div class="banner__content">
      <h2 id="banner-heading">Hiring an associate product designer?</h2>
      <p>I want to join a team building for schools, families, or people short on time.</p>
      <ContactEmail class="banner__email" />
    </div>
  </section>
  </div>
</PageLayout>

<style>
  /* One stack: the same gap between every section, and before the footer. */
  .stack {
    display: grid;
    gap: var(--section-gap);
    padding-block: var(--section-gap);
  }

  /* Section panels on the page background (the closing banner). Square, like everything else. */
  .panel {
    border-radius: var(--radius-section);
    padding: var(--panel-padding);
  }

  .panel--dark {
    border: var(--rule-thin) solid var(--color-dark-panel-edge);
  }

  /* Media runs to the panel edges. */
  .panel--flush {
    padding: 0;
    overflow: hidden;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* 1. Name and one line. The name is the largest text on the site. */
  .hero {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-9) var(--space-5);
  }

  .hero h1 {
    font-size: var(--step-6);
    line-height: 0.95;
  }

  .hero__role {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-heading);
  }

  /* Meta line and links row: mono, like the labels. */
  .hero__meta,
  .hero__links {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__links a,
  .hero__links span {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-height);
  }

  .hero__links a {
    color: var(--color-ink);
  }

  /* Sections after the name open with a thin rule across the content column. As the section
     scrolls into view the rule draws from left to right (Micah Hoang). With reduced motion, or
     before the reveal script runs, it simply shows. */
  .work,
  .about {
    position: relative;
    padding-block-start: var(--space-6);
  }

  .work::before,
  .about::before {
    content: "";
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    border-block-start: var(--rule-thin) solid var(--color-rule);
    transform-origin: left center;
  }

  /* The draw runs when the section is revealed, including sections already on screen at load. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-ready) .work:not(:global(.is-revealed))::before,
    :global(.reveal-ready) .about:not(:global(.is-revealed))::before {
      transform: scaleX(0);
    }

    .work:global(.is-revealed)::before,
    .about:global(.is-revealed)::before {
      animation: rule-draw var(--duration-rule-draw) var(--ease-roll) both;
    }
  }

  @keyframes rule-draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* 2. Selected work */
  .work {
    display: grid;
    gap: var(--space-6);
  }

  .work h2 {
    font-size: var(--step-4);
    margin-block-end: var(--space-2);
  }

  .work__grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 48rem) {
    .work__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* 3. About, centered: label, heading with one highlighted word, one line, a mono date, the clip,
     then coaching in one line and the link to the About page. */
  .about {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    text-align: center;
  }

  .about h2 {
    max-width: 18ch;
    font-size: var(--step-5);
    line-height: var(--leading-tight);
  }

  .highlight {
    padding-inline: 0.08em;
    background: var(--color-highlight);
    color: var(--color-highlight-ink);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .about__lede {
    max-width: 36rem;
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  .about__meta,
  .about__more {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .about__meta {
    color: var(--color-ink-muted);
  }

  .about__clip {
    inline-size: min(100%, var(--size-clip));
    margin-block: var(--space-5) var(--space-3);
  }

  /* Caption row under the clip, centered with the rest. */
  .about :global(.clip__bar) {
    justify-content: center;
  }

  .about :global(.clip__toggle) {
    margin-inline-start: 0;
  }

  /* Inline block, not flex, so the spaces inside the words survive. Padding keeps a 44px target. */
  .about :global(.clip__bar > a),
  .about :global(.clip__bar > span) {
    display: inline-block;
    padding-block: calc((var(--control-height) - 1lh) / 2);
  }

  .about__coach {
    max-width: 36rem;
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--color-heading);
  }

  .about__more {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-height);
  }

  .credit {
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }

  /* 4. Closing banner: the group photo centered at the clip width with its credit, then the
     invitation. The banner keeps its panel padding all around. */
  .banner {
    padding: var(--panel-padding);
  }

  .banner__figure {
    display: grid;
    gap: var(--space-3);
    inline-size: min(100%, var(--size-clip));
    margin-inline: auto;
  }

  .banner :global(.banner__photo) {
    display: block;
    width: 100%;
    height: auto;
  }

  .banner__credit {
    text-align: end;
  }

  .banner__content {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    padding-block-start: var(--space-7);
    text-align: center;
  }

  /* Smaller on phones so the question does not wrap to four lines. */
  .banner__content h2 {
    max-width: 20ch;
    font-size: var(--step-3);
  }

  @media (min-width: 48rem) {
    .banner__content h2 {
      font-size: var(--step-4);
    }
  }

  .banner__content p {
    max-width: var(--measure-reading);
  }

  .banner__content :global(.banner__email) {
    justify-content: center;
    margin-block-start: var(--space-2);
  }
</style>
