---
import PageLayout from "../layouts/PageLayout.astro";
import Photo from "../components/site/Photo.astro";
import ContactEmail from "../components/site/ContactEmail.astro";
import KronClip from "../components/site/KronClip.astro";
import { mailto, site } from "../site.config";
import fs from "node:fs";
import WorkCard from "../components/site/WorkCard.astro";
import { caseStudyHref, getAllCaseStudies, showPlaceholders } from "../lib/case-studies";

// Selected work: the featured case study as one large card, the rest below by `order`.
const studies = (await getAllCaseStudies()).filter((s) => s.data.card);
const featured = studies.find((s) => s.data.featured);
const others = studies.filter((s) => s !== featured);
// The Resume link goes live once public/resume.pdf exists; until then it shows as plain text.
const hasResume = fs.existsSync(new URL("../../public/resume.pdf", import.meta.url));
---

<PageLayout title="Aaron Luellen" flushBottom footerEmail={false}>
  <!-- Every section sits in one stack with the same gap between them. -->
  <div class="container stack">
  <!-- 1. Name, one line, a meta line (Zeel Shah), and a links row (Micah Hoang). No photo, no buttons. -->
  <section class="hero" aria-labelledby="hero-heading">
    <h1 id="hero-heading" translate="no">Aaron Luellen</h1>
    <p class="hero__role">Research led product designer.</p>
    <p class="hero__meta">2 years · EdTech · Health · Climate</p>
    <ul class="hero__links" aria-label="Links">
      <li>{site.linkedin ? <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a> : <span>LinkedIn</span>}</li>
      <li>{hasResume ? <a href={site.resumePath}>Resume</a> : <span>Resume</span>}</li>
      <li><a href={mailto}>Email</a></li>
    </ul>
  </section>

  <!-- 2. Selected work, right after the name: one featured card, then smaller cards. Cards link only when published. -->
  <section id="work" class="work" aria-labelledby="work-heading" data-reveal>
    <h2 id="work-heading">Selected work</h2>
    {featured && <WorkCard study={featured} href={caseStudyHref(featured)} featured index={1} />}
    {
      others.length > 0 && (
        <div class="work__grid">
          {others.map((study, i) => (
            <WorkCard study={study} href={caseStudyHref(study)} index={i + (featured ? 2 : 1)} />
          ))}
        </div>
      )
    }
  </section>

  <!-- 3. About, told in order: the apprenticeship he just finished, then him on air, then coaching.
       Reads as one story after the work. The full story is on the About page. -->
  <section id="about" class="about" aria-labelledby="about-heading" data-reveal>
    <p class="label">About</p>
    <h2 id="about-heading">I recently finished the <span translate="no">BRIDGEGOOD</span> UX Design Apprenticeship.</h2>
    <p class="about__lede">
      Launched by <span translate="no">Google.org</span> and the <span translate="no">Golden State Warriors</span>, with mentors from <span translate="no">Google</span>, <span translate="no">Meta</span>, and <span translate="no">YouTube</span>.
      The team built <span translate="no">AthenaScribe</span> and presented it at Demo Day at <span translate="no">Block HQ</span>.
    </p>

    <div class="about__clip">
      <KronClip opens>
        <span><span class="kron__long">On air with </span>KRON4</span>
        {site.kron4Video && <a href={site.kron4Video} target="_blank" rel="noopener noreferrer"><span class="kron__long">Watch on </span>YouTube<span class="visually-hidden"> (opens in a new tab)</span></a>}
      </KronClip>
    </div>

    <div class="about__coach">
      <div class="about__coach-text">
        <h3>From coaching systems to product design.</h3>
        <p>
          Competing taught me that close fights come down to the basics. Coaching taught me that every
          fighter uses those basics differently.
        </p>
        <a class="about__more" href="/about/">Read more about me</a>
      </div>
      <!-- Stand in until Aaron's clip of holding pads or teaching. -->
      <figure class="about__coach-media">
        <Photo name="about-pads" widths={[600, 900, 1280]} sizes="(min-width: 64rem) 36rem, 92vw" ratio="7 / 5" class="about__coach-photo" />
        {showPlaceholders && <figcaption class="about__coach-tag">Placeholder · coaching clip to come</figcaption>}
      </figure>
    </div>
  </section>

  <!-- 4. Closing banner, navy in both themes: the whole group photo, then the invitation below it -->
  <section class="panel panel--dark panel--flush surface-always-dark banner" aria-labelledby="banner-heading" data-reveal>
    <figure class="banner__figure">
      <Photo name="group" widths={[800, 1280, 1920, 2560]} sizes="(min-width: 76rem) 72rem, 94vw" ratio="2000 / 1150" class="banner__photo" />
      <figcaption class="credit banner__credit">Photos: BRIDGEGOOD</figcaption>
    </figure>
    <div class="banner__content">
      <h2 id="banner-heading">Hiring an associate product designer?</h2>
      <p>
        I’m open to associate product design roles, especially on teams building for schools, families, or
        people short on time.
      </p>
      <ContactEmail class="banner__email" />
    </div>
  </section>
  </div>
</PageLayout>

<style>
  /* One stack: the same gap between every section, and before the footer. */
  .stack {
    display: grid;
    gap: var(--section-gap);
    padding-block: var(--section-gap);
  }

  /* Section panels on the page background (the closing banner). Square, like everything else. */
  .panel {
    border-radius: var(--radius-section);
    padding: var(--panel-padding);
  }

  .panel--dark {
    border: var(--rule-thin) solid var(--color-dark-panel-edge);
  }

  /* Media runs to the panel edges. */
  .panel--flush {
    padding: 0;
    overflow: hidden;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* 1. Name and one line. The name is the largest text on the site. */
  .hero {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-9) var(--space-5);
  }

  .hero h1 {
    font-size: var(--step-6);
    line-height: 0.95;
  }

  .hero__role {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-heading);
  }

  /* Meta line and links row: mono, like the labels. */
  .hero__meta,
  .hero__links {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__links a,
  .hero__links span {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-height);
  }

  .hero__links a {
    color: var(--color-ink);
  }

  /* Sections after the name open with a thin rule, like a page in a notebook. */
  .work,
  .about {
    padding-block-start: var(--space-6);
    border-block-start: var(--rule-thin) solid var(--color-rule);
  }

  /* 2. Selected work */
  .work {
    display: grid;
    gap: var(--space-6);
  }

  .work h2 {
    font-size: var(--step-4);
    margin-block-end: var(--space-2);
  }

  .work__grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 48rem) {
    .work__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* 3. About, in order: apprenticeship, the KRON4 clip, coaching. Phones get the short caption words
     so the row under the clip stays on one line. */
  @media (max-width: 47.99rem) {
    .kron__long {
      display: none;
    }
  }

  /* Inline block, not flex, so the spaces inside the words survive. Padding keeps a 44px target. */
  .about :global(.clip__bar > a),
  .about :global(.clip__bar > span) {
    display: inline-block;
    padding-block: calc((var(--control-height) - 1lh) / 2);
  }

  .about {
    display: grid;
    gap: var(--space-5);
  }

  .about h2 {
    font-size: var(--step-4);
    max-width: 22ch;
  }

  .about__lede {
    max-width: var(--measure-reading);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
  }

  .about__clip {
    margin-block: var(--space-5);
  }

  .about__coach {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .about__coach > * {
    min-width: 0;
  }

  @media (min-width: 64rem) {
    .about__coach {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  .about__coach-text {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .about__coach-text h3 {
    font-size: var(--step-3);
  }

  .about__coach-text p {
    max-width: var(--measure-reading);
    color: var(--color-ink-muted);
  }

  .about__more {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-height);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .about__coach-media {
    position: relative;
    margin: 0;
  }

  .about__coach-media :global(.about__coach-photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 7 / 5;
    object-fit: cover;
    border-radius: var(--radius-media);
  }

  /* Review previews only. */
  .about__coach-tag {
    position: absolute;
    inset: auto auto var(--space-3) var(--space-3);
    padding: var(--space-1) var(--space-2);
    background: var(--color-paper);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .credit {
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }

  /* 5. Closing banner: the photo shows whole, with nothing laid over it. */
  .banner__figure {
    display: grid;
    gap: var(--space-3);
  }

  /* Credit and text keep the panel padding; only the photo runs edge to edge. */
  .banner__credit {
    padding-inline: var(--panel-padding);
  }

  .banner :global(.banner__photo) {
    display: block;
    width: 100%;
    height: auto;
  }

  .banner__credit {
    text-align: end;
  }

  .banner__content {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    padding: var(--space-6) var(--panel-padding) var(--panel-padding);
    text-align: center;
  }

  .banner__content h2 {
    font-size: var(--step-4);
  }

  .banner__content p {
    max-width: var(--measure-reading);
  }

  .banner__content :global(.banner__email) {
    justify-content: center;
    margin-block-start: var(--space-2);
  }
</style>
